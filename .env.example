# === Base de données ===
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/switching_lms?schema=public"

# === Authentification (REQUIS) ===
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
# AUTH_URL est un alias de NEXTAUTH_URL — définir l'un ou l'autre
# AUTH_URL="http://localhost:3000"

# === Email — Gmail API OAuth (transactionnel LMS) ===
# GMAIL_CLIENT_ID=""
# GMAIL_CLIENT_SECRET=""
# GMAIL_REFRESH_TOKEN=""
# GMAIL_FROM_EMAIL="contact@switchingformation.com"
# GMAIL_FROM_NAME="Switching Formation"

# === Vimeo (optionnel, configurable via l'admin) ===
# VIMEO_TOKEN=""

# === Stockage fichiers ===
UPLOAD_DIR="/mnt/uploads"

# === Environnement ===
NODE_ENV="development"
