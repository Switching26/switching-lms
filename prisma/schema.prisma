generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PARTNER_ADMIN
  LEARNER
}

enum EmailType {
  ACCOUNT_CREATED
  FORMATION_ASSIGNED
  CHAPTER_COMPLETED
  FORMATION_COMPLETED
  ACTIVATION_LINK
  PASSWORD_RESET
}

enum TokenType {
  ACTIVATION
  RESET
}

enum ExerciseType {
  QCM
  REDACTION
  VRAI_FAUX
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  password    String
  firstName   String
  lastName    String
  role        Role     @default(LEARNER)
  partnerId   String?
  partner     Partner? @relation(fields: [partnerId], references: [id])
  isActive    Boolean  @default(true)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastLoginAt DateTime?

  enrollments         Enrollment[]
  progress            Progress[]
  notes               Note[]
  loginLogs           LoginLog[]
  emailLogs           EmailLog[]
  passwordResetTokens PasswordResetToken[]
  exerciseResponses   ExerciseResponse[]
  questionResponses   QuestionResponse[]

  @@index([email])
  @@index([partnerId])
}

model Partner {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  primaryColor   String   @default("#111111")
  secondaryColor String   @default("#FFFFFF")
  logoUrl        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // SMTP configuration
  smtpHost       String?
  smtpPort       Int?
  smtpEmail      String?
  smtpPassword   String?  // AES-256 encrypted
  smtpFromName   String?
  useDefaultSmtp Boolean  @default(true)

  users       User[]
  enrollments Enrollment[]
  licenses    License[]

  @@index([slug])
}

model Formation {
  id            String   @id @default(cuid())
  title         String
  description   String?  @db.Text
  coverImageUrl String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sections    Section[]
  chapters    Chapter[]
  enrollments Enrollment[]
  licenses    License[]
  attachments FormationAttachment[]
}

model Section {
  id          String   @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  order       Int

  chapters Chapter[]

  @@index([formationId])
}

model FormationAttachment {
  id          String @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  name        String
  fileUrl     String
  fileSize    Int    @default(0)

  @@index([formationId])
}

model Chapter {
  id            String   @id @default(cuid())
  formationId   String
  formation     Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title         String
  description   String?  @db.Text
  order         Int
  videoUrl      String?
  videoDuration Int      @default(0)
  content       String?  @db.Text
  isPublished   Boolean  @default(false)

  attachments Attachment[]
  exercises   Exercise[]
  progress    Progress[]
  notes       Note[]

  @@index([formationId])
  @@index([sectionId])
}

model Attachment {
  id        String @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  fileSize  Int    @default(0)

  @@index([chapterId])
}

model Enrollment {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationId         String
  formation           Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  startedAt           DateTime  @default(now())
  expiresAt           DateTime?
  completedAt         DateTime?
  assignedByPartnerId String?
  assignedByPartner   Partner?  @relation(fields: [assignedByPartnerId], references: [id])

  @@unique([userId, formationId])
  @@index([userId])
  @@index([formationId])
}

model License {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  totalSeats  Int
  usedSeats   Int       @default(0)

  @@unique([partnerId, formationId])
  @@index([partnerId])
}

model Progress {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId        String
  chapter          Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completedAt      DateTime?
  timeSpentSeconds Int       @default(0)
  lastPosition     Int       @default(0)
  sessionCount     Int       @default(0)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model EmailLog {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    EmailType
  subject String?
  error   String?
  sentAt  DateTime  @default(now())
  success Boolean   @default(true)

  @@index([userId])
}

model Exercise {
  id           String       @id @default(cuid())
  chapterId    String
  chapter      Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type         ExerciseType
  title        String
  instructions String?      @db.Text
  order        Int

  questions Question[]
  responses ExerciseResponse[]

  @@index([chapterId])
}

model Question {
  id         String       @id @default(cuid())
  exerciseId String
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String       @db.Text
  type       ExerciseType
  order      Int

  choices   Choice[]
  responses QuestionResponse[]

  @@index([exerciseId])
}

model Choice {
  id         String  @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean @default(false)

  questionResponses QuestionResponse[]

  @@index([questionId])
}

model ExerciseResponse {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise  @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completedAt DateTime  @default(now())
  score       Float?

  questionResponses QuestionResponse[]

  @@index([userId])
  @@index([exerciseId])
}

model QuestionResponse {
  id               String            @id @default(cuid())
  exerciseResponseId String
  exerciseResponse ExerciseResponse  @relation(fields: [exerciseResponseId], references: [id], onDelete: Cascade)
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question          @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responseText     String?           @db.Text
  selectedChoiceId String?
  selectedChoice   Choice?           @relation(fields: [selectedChoiceId], references: [id], onDelete: SetNull)
  isCorrect        Boolean?

  @@index([userId])
  @@index([questionId])
  @@index([exerciseResponseId])
}
