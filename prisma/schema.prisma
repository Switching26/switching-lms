generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  PARTNER_ADMIN
  LEARNER
}

enum EmailType {
  ACCOUNT_CREATED
  FORMATION_ASSIGNED
  CHAPTER_COMPLETED
  FORMATION_COMPLETED
  ACTIVATION_LINK
  PASSWORD_RESET
  LOGIN_LINK
  ASSESSMENT_INVITATION
  ASSESSMENT_COMPLETED
  CUSTOM
}

enum TokenType {
  ACTIVATION
  RESET
}

enum ExerciseType {
  QCM
  REDACTION
  VRAI_FAUX
}

model User {
  id                       String    @id @default(cuid())
  email                    String    @unique
  password                 String
  visiblePasswordEncrypted String?
  firstName                String
  lastName                 String
  reference                String?   @unique
  role                     Role      @default(LEARNER)
  partnerId                String?
  partner                  Partner?  @relation(fields: [partnerId], references: [id])
  isActive                 Boolean   @default(true)
  archivedAt               DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  lastLoginAt              DateTime?

  enrollments            Enrollment[]
  progress               Progress[]
  notes                  Note[]
  loginLogs              LoginLog[]
  emailLogs              EmailLog[]
  passwordResetTokens    PasswordResetToken[]
  exerciseResponses      ExerciseResponse[]
  questionResponses      QuestionResponse[]
  assessmentInvitations  AssessmentInvitation[]
  simulationAttempts     SimulationAttempt[]
  simulationRuns         SimulationRun[]
  simulationFlushes      SimulationFlush[]
  conversationsAsLearner Conversation[]         @relation("ConversationLearner")
  conversationsAsAdmin   Conversation[]         @relation("ConversationAdmin")
  messages               Message[]

  @@index([email])
  @@index([partnerId])
  @@index([reference])
}

model Partner {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  primaryColor   String   @default("#111111")
  secondaryColor String   @default("#FFFFFF")
  logoUrl        String?
  faviconUrl     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Organisme interne (Switching Formation) : accède à tout le catalogue
  /// sans licence, contrairement aux organismes partenaires qui ne voient
  /// que les formations explicitement ouvertes par le super-admin.
  isInternal Boolean @default(false)

  /// Compte d'envoi des emails transactionnels de cet organisme.
  /// null = compte par défaut de la plateforme e-learning.
  /// "switching" = boîte Switching Formation (transport GMAIL_SWITCHING_*).
  /// Le nom affiché reste celui du partenaire dans tous les cas.
  mailProfile String?

  // SMTP configuration
  smtpHost       String?
  smtpPort       Int?
  smtpEmail      String?
  smtpPassword   String? // AES-256 encrypted
  smtpFromName   String?
  useDefaultSmtp Boolean @default(true)

  users          User[]
  enrollments    Enrollment[]
  licenses       License[]
  emailTemplates EmailTemplate[]
  assessments    Assessment[]

  @@index([slug])
}

model EmailTemplate {
  id               String          @id @default(cuid())
  name             String
  subject          String
  htmlContent      String          @db.Text
  type             EmailType
  isDefault        Boolean         @default(false)
  isActive         Boolean         @default(true)
  partnerId        String?
  partner          Partner?        @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  duplicatedFromId String?
  duplicatedFrom   EmailTemplate?  @relation("TemplateDuplicate", fields: [duplicatedFromId], references: [id], onDelete: SetNull)
  duplicates       EmailTemplate[] @relation("TemplateDuplicate")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([partnerId])
  @@index([type])
}

model Formation {
  id            String    @id @default(cuid())
  title         String
  description   String?   @db.Text
  coverImageUrl String?
  isPublished   Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sections    Section[]
  chapters    Chapter[]
  enrollments Enrollment[]
  licenses    License[]
  attachments FormationAttachment[]
}

model Section {
  id          String    @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  title       String
  description String?   @db.Text
  order       Int

  chapters Chapter[]

  @@index([formationId])
}

model FormationAttachment {
  id          String    @id @default(cuid())
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  name        String
  fileUrl     String
  fileSize    Int       @default(0)

  @@index([formationId])
}

model Chapter {
  id            String    @id @default(cuid())
  formationId   String
  formation     Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  sectionId     String?
  section       Section?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  title         String
  description   String?   @db.Text
  order         Int
  videoUrl      String?
  videoDuration Int       @default(0)
  content       String?   @db.Text
  isPublished   Boolean   @default(false)

  attachments Attachment[]
  exercises   Exercise[]
  progress    Progress[]
  notes       Note[]
  simulation  Simulation?

  @@index([formationId])
  @@index([sectionId])
}

model Attachment {
  id        String  @id @default(cuid())
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  name      String
  fileUrl   String
  fileSize  Int     @default(0)

  @@index([chapterId])
}

model Enrollment {
  id                  String    @id @default(cuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  formationId         String
  formation           Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  startedAt           DateTime  @default(now())
  expiresAt           DateTime?
  completedAt         DateTime?
  assignedByPartnerId String?
  assignedByPartner   Partner?  @relation(fields: [assignedByPartnerId], references: [id])

  @@unique([userId, formationId])
  @@index([userId])
  @@index([formationId])
}

model License {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  formationId String
  formation   Formation @relation(fields: [formationId], references: [id], onDelete: Cascade)
  totalSeats  Int
  usedSeats   Int       @default(0)
  isUnlimited Boolean   @default(false)

  @@unique([partnerId, formationId])
  @@index([partnerId])
}

model Progress {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId        String
  chapter          Chapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  completedAt      DateTime?
  timeSpentSeconds Int       @default(0)
  lastPosition     Int       @default(0)
  sessionCount     Int       @default(0)

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapterId String
  chapter   Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([userId, chapterId])
  @@index([userId])
}

model LoginLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loginAt   DateTime @default(now())
  ipAddress String?
  userAgent String?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@index([userId])
}

model ImpersonationLog {
  id          String   @id @default(cuid())
  adminId     String
  adminEmail  String
  targetId    String
  targetEmail String
  targetRole  Role
  action      String // "start" or "stop"
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@index([key])
}

model EmailLog {
  id      String    @id @default(cuid())
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    EmailType
  subject String?
  error   String?
  sentAt  DateTime  @default(now())
  success Boolean   @default(true)

  @@index([userId])
}

model Exercise {
  id           String       @id @default(cuid())
  chapterId    String
  chapter      Chapter      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  type         ExerciseType
  title        String
  instructions String?      @db.Text
  order        Int

  questions Question[]
  responses ExerciseResponse[]

  @@index([chapterId])
}

model Question {
  id         String       @id @default(cuid())
  exerciseId String
  exercise   Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  text       String       @db.Text
  type       ExerciseType
  order      Int

  choices   Choice[]
  responses QuestionResponse[]

  @@index([exerciseId])
}

model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)

  questionResponses QuestionResponse[]

  @@index([questionId])
}

model ExerciseResponse {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())
  score       Float?

  questionResponses QuestionResponse[]

  @@index([userId])
  @@index([exerciseId])
}

model Conversation {
  id            String   @id @default(cuid())
  learnerId     String
  learner       User     @relation("ConversationLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  adminId       String
  admin         User     @relation("ConversationAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  isReadAdmin   Boolean  @default(false)
  isReadLearner Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@unique([learnerId, adminId])
  @@index([learnerId])
  @@index([adminId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content        String       @db.Text
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model QuestionResponse {
  id                 String           @id @default(cuid())
  exerciseResponseId String
  exerciseResponse   ExerciseResponse @relation(fields: [exerciseResponseId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId         String
  question           Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  responseText       String?          @db.Text
  selectedChoiceId   String?
  selectedChoice     Choice?          @relation(fields: [selectedChoiceId], references: [id], onDelete: SetNull)
  isCorrect          Boolean?

  @@index([userId])
  @@index([questionId])
  @@index([exerciseResponseId])
}

// ---------------------------------------------------------------------------
// Évaluations autonomes (tests de positionnement / évaluations)
//
// Volontairement SÉPARÉ du moteur de quiz de formation (Exercise/Question/
// Choice) : celui-ci est verrouillé sur un compte (Exercise.chapterId et
// ExerciseResponse.userId sont obligatoires) alors qu'un test de
// positionnement s'adresse à un PROSPECT sans compte, invité par lien. Le
// tordre aurait fragilisé un moteur stabilisé en production, et aurait imposé
// de créer de faux comptes utilisateurs pour de simples candidats.
// ---------------------------------------------------------------------------

enum AssessmentType {
  POSITIONNEMENT
  EVALUATION
}

enum AssessmentQuestionType {
  QCM_SINGLE // une seule bonne réponse
  QCM_MULTI // plusieurs bonnes réponses, notation tout-ou-rien
  TEXTE // réponse libre, corrigée manuellement
  ECHELLE // auto-positionnement, non noté
}

model Assessment {
  id          String         @id @default(cuid())
  title       String
  description String?        @db.Text
  type        AssessmentType @default(POSITIONNEMENT)

  /// Organisme propriétaire. Un admin partenaire ne voit que les siens ;
  /// le super-admin voit tout. Cloisonne les tests Switching des partenaires.
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  isPublished Boolean @default(false)

  /// Ce que le candidat voit une fois le test soumis.
  showScore          Boolean @default(true)
  showCorrectAnswers Boolean @default(true)

  /// Seuil de réussite en % (indicatif, null = aucun).
  passingScore     Int?
  /// Durée limite en minutes (null = pas de limite).
  timeLimitMinutes Int?
  /// Validité par défaut d'une invitation, en jours.
  validityDays     Int  @default(30)

  /// Destinataire de la notification « test terminé ». Vide = l'auteur de
  /// l'invitation. Sans cela, il faudrait surveiller la page pour savoir
  /// qu'un candidat a répondu.
  notifyEmail String?

  /// Grille score → niveau, ex. [{min,max,level,label,parcours}]. Stockée ici
  /// pour que le candidat ET le mail affichent un niveau, pas un pourcentage
  /// brut que personne ne sait interpréter.
  levelBands Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  questions   AssessmentQuestion[]
  invitations AssessmentInvitation[]

  @@index([partnerId])
}

model AssessmentQuestion {
  id           String                 @id @default(cuid())
  assessmentId String
  assessment   Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  text         String                 @db.Text
  helpText     String?                @db.Text
  type         AssessmentQuestionType @default(QCM_SINGLE)
  order        Int
  points       Int                    @default(1)

  /// Bornes pour les questions de type ECHELLE.
  scaleMin      Int?
  scaleMax      Int?
  scaleMinLabel String?
  scaleMaxLabel String?

  choices AssessmentChoice[]
  answers AssessmentAnswer[]

  @@index([assessmentId])
}

model AssessmentChoice {
  id         String             @id @default(cuid())
  questionId String
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String             @db.Text
  isCorrect  Boolean            @default(false)
  order      Int                @default(0)

  @@index([questionId])
}

model AssessmentInvitation {
  id           String     @id @default(cuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  /// Secret du lien public /evaluation/<token>. Jamais deviné : généré en
  /// aléatoire cryptographique. C'est la seule authentification du candidat.
  token String @unique

  /// Candidat SANS compte (prospect). Renseigné à l'invitation.
  candidateEmail     String
  candidateFirstName String?
  candidateLastName  String?

  /// Apprenant existant du LMS, quand l'évaluation est attribuée en interne.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdById String?

  sentAt      DateTime?
  openedAt    DateTime?
  startedAt   DateTime?
  submittedAt DateTime?
  expiresAt   DateTime?

  /// Score en points bruts + barème, calculés serveur à la soumission.
  score             Float?
  maxScore          Float?
  /// Reste à corriger manuellement (présence de questions TEXTE).
  needsManualReview Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  answers AssessmentAnswer[]

  @@index([assessmentId])
  @@index([userId])
  @@index([candidateEmail])
}

model AssessmentAnswer {
  id           String               @id @default(cuid())
  invitationId String
  invitation   AssessmentInvitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  questionId   String
  question     AssessmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// QCM : identifiants des choix cochés (mono ou multi).
  selectedChoiceIds String[]
  /// TEXTE : réponse libre. ECHELLE : valeur choisie.
  responseText      String?  @db.Text
  scaleValue        Int?

  /// null tant qu'une question TEXTE n'a pas été corrigée à la main.
  isCorrect    Boolean?
  pointsEarned Float?

  @@unique([invitationId, questionId])
  @@index([invitationId])
  @@index([questionId])
}

/// ═══════════ SIMULATIONS BUREAUTIQUES ═══════════
/// Moteur de simulation interactive (Excel, puis Word/PowerPoint).
/// Un chapitre porte AU PLUS une simulation. Le scénario est déclaratif
/// (JSON opaque côté base) pour pouvoir évoluer sans migration.
/// Volontairement séparé du moteur de quiz (Exercise/Question/Choice) et du
/// moteur d'évaluation prospect (Assessment) : les trois ont des cycles de vie
/// et des règles de notation différents.

enum SimulationApp {
  EXCEL
  WORD
  POWERPOINT
}

/// LESSON     : guidée — la consigne dit où cliquer, halo d'aide affiché.
/// EXERCISE   : l'apprenant reçoit l'objectif, pas le chemin. Aide sur demande.
/// EVALUATION : notée, sans aide, score conservé.
enum SimulationMode {
  LESSON
  EXERCISE
  EVALUATION
}

model Simulation {
  id        String         @id @default(cuid())
  chapterId String         @unique
  chapter   Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  app       SimulationApp  @default(EXCEL)
  mode      SimulationMode @default(LESSON)

  /// Scénario déclaratif complet : état initial du classeur, étapes,
  /// cibles attendues, aides, état du ruban. Voir lib/simulation/schema.ts.
  scenario  Json
  /// Dénormalisé : nombre d'étapes, pour l'affichage sans parser le scénario.
  stepCount Int  @default(0)
  /// Incrémenté à chaque modification de fond du scénario : permet de repérer
  /// les tentatives en cours démarrées sur une version antérieure.
  version   Int  @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts SimulationAttempt[]
  runs     SimulationRun[]
  flushes  SimulationFlush[]

  @@index([chapterId])
}

/// Une ligne par (simulation, apprenant) : c'est l'ÉTAT courant, pas un
/// historique. Les reprises se font sur cette ligne (comme Progress), et
/// l'historique fin vit dans stepLog.
model SimulationAttempt {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Étape où l'apprenant reprend (index 0-based).
  currentStep Int @default(0)
  /// Étape la plus avancée atteinte : la navigation est libre, donc currentStep
  /// peut reculer sans faire perdre la progression réelle.
  maxStepSeen Int @default(0)

  /// Mauvaises actions cumulées, et nombre d'aides ouvertes : ce sont les deux
  /// signaux pédagogiques utiles au formateur.
  errorCount Int @default(0)
  hintCount  Int @default(0)

  /// Mode EVALUATION uniquement. bestScore survit à une reprise moins bonne.
  score        Float?
  bestScore    Float?
  attemptCount Int    @default(1)

  /// Trace par étape : [{ step, errors, hints, ms, typed }] — sert aux preuves
  /// Qualiopi et au diagnostic pédagogique.
  stepLog Json?

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([simulationId, userId])
  @@index([userId])
  @@index([simulationId])
}

/// Un PASSAGE d'évaluation, ouvert et tenu par le SERVEUR.
///
/// POURQUOI CE MODÈLE EXISTE
/// `SimulationAttempt` décrit l'état de reprise d'un apprenant sur un atelier :
/// une seule ligne par (simulation, utilisateur), écrasée à chaque passage.
/// Elle ne peut pas porter la preuve d'un passage, et surtout elle ne dit rien
/// de ce que l'apprenant a RÉELLEMENT réussi : jusqu'ici la note se calculait
/// depuis deux booléens par étape, déclarés par le navigateur. Une requête
/// fabriquée qui affirmait « tout réussi du premier coup » obtenait 100 % sans
/// avoir joué une seule étape.
///
/// Un run est ouvert au clic « Commencer », repris tel quel au rechargement de
/// la page, et remplacé par un nouveau au « Repasser l'évaluation ». C'est lui
/// qui porte les verdicts, et c'est de ces verdicts — et d'eux seuls — que la
/// note finale est calculée.
/// REÇU D'UNE REMONTÉE DE PROGRESSION.
///
/// Le PUT non final — appelé à CHAQUE étape franchie — porte des deltas qui
/// s'ajoutent : `errorDelta`, `hintDelta`, `timeDeltaSeconds`. Il n'était donc
/// pas rejouable : serveur qui commit, réponse perdue, navigateur qui renvoie
/// la même enveloppe, et les trois compteurs étaient appliqués deux fois.
///
/// Le navigateur scelle désormais chaque enveloppe avec une CLÉ. Le serveur la
/// dépose ici dans la même transaction que les incréments : une clé déjà vue
/// veut dire « ces deltas-là sont déjà comptés », et la remontée n'écrit rien.
/// Une clé neuve veut dire de nouveaux deltas, comptés exactement une fois.
model SimulationFlush {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Clé d'idempotence produite par le navigateur, unique par enveloppe.
  cle       String
  appliedAt DateTime @default(now())

  @@unique([simulationId, userId, cle])
  @@index([userId])
}

model SimulationRun {
  id           String     @id @default(cuid())
  simulationId String
  simulation   Simulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Rang du passage pour ce couple (simulation, apprenant) : 1, 2, 3…
  /// Sert à retrouver le run actif et à ordonner les passages.
  passage Int @default(1)

  /// Version du scénario au moment de l'ouverture. Un scénario corrigé en cours
  /// de passage change les identifiants d'étapes : le run devient alors
  /// incomparable, et la note ne peut plus être établie.
  scenarioVersion Int @default(1)

  /// Rang de l'étape la plus avancée réellement franchie — réussie ou passée.
  /// C'est le garde-fou d'ORDRE : on ne corrige pas l'étape 9 quand le run n'a
  /// jamais dépassé la 2.
  ///
  /// Vaut -1 sur un passage NEUF, et non 0 : à 0, l'étape 1 serait déjà
  /// recevable (1 <= 0 + 1) alors que l'étape 0 n'a pas été franchie, et un
  /// scénario à une seule étape serait clôturable sans le moindre verdict.
  /// -1 veut dire « rien n'a encore été franchi », ce qui est la vérité.
  maxStepIndex Int @default(-1)

  /// Note calculée à la clôture, depuis les seuls verdicts serveur.
  score       Float?
  startedAt   DateTime  @default(now())
  closedAt    DateTime?

  /// REÇU D'ÉCRITURE de la tentative. Posé DANS la transaction qui reporte le
  /// passage sur `SimulationAttempt` et `Progress`.
  ///
  /// La clôture est idempotente, mais le report qui la suit ne l'était pas :
  /// `errorCount`, `hintCount` et `timeSpentSeconds` s'y écrivent en
  /// incréments. Une réponse perdue APRÈS le commit, puis un réessai du
  /// navigateur, les comptait donc deux fois — et un vieux passage clos pouvait
  /// au passage réécrire `attemptCount` avec son rang, plus ancien.
  ///
  /// Le reçu tranche : tant qu'il est vide, le report est à faire (un réessai
  /// AVANT le commit retrouve la colonne vide, puisque la transaction a été
  /// annulée avec le reste) ; dès qu'il est posé, la même clôture rend le même
  /// résultat sans plus aucune écriture.
  attemptSyncedAt DateTime?

  updatedAt   DateTime  @updatedAt

  verdicts SimulationStepVerdict[]

  @@unique([simulationId, userId, passage])
  @@index([userId])
  @@index([simulationId, userId])
}

/// Le verdict SERVEUR d'une étape, dans un passage donné.
///
/// `premierEssai` est IMMUABLE une fois posé : c'est lui qui fait la note, et le
/// barème ne compte que les réussites du premier coup. Les essais suivants
/// restent autorisés — l'apprenant doit pouvoir avancer — mais ils ne peuvent
/// plus le remettre à vrai. La contrainte d'unicité garantit qu'une étape ne
/// porte qu'un verdict par passage, y compris sous deux requêtes simultanées :
/// la seconde échoue sur la contrainte au lieu d'écraser la première.
model SimulationStepVerdict {
  id     String        @id @default(cuid())
  runId  String
  run    SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// Identifiant d'étape du scénario, ex. « M10-EV01-02 ».
  stepId String
  /// Rang 1-based, repris du scénario serveur.
  stepIndex Int

  /// Réussie AVANT toute faute comptée sur cette étape. Jamais réécrit à vrai.
  premierEssai Boolean @default(false)
  /// L'étape a-t-elle été jouée ? Faux pour une question passée.
  tentee Boolean @default(true)
  /// L'apprenant a RENONCÉ à cette étape. Irréversible dans le passage : aucun
  /// verdict ultérieur ne peut plus lui accorder le point.
  ///
  /// Sans ce marqueur, « passer » se contentait d'avancer le curseur — et une
  /// correction déjà en vol pouvait revenir après coup, écrire une réussite et
  /// donner le point d'une question à laquelle l'apprenant avait renoncé.
  passee Boolean @default(false)
  /// L'étape a-t-elle fini par être franchie ? Sert au diagnostic, pas à la note.
  reussie Boolean @default(false)
  /// Nombre de fautes comptées. Diagnostic.
  fautes Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, stepId])
  @@index([runId])
}
