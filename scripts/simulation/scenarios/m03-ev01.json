  "steps": [
    {
      "id": "M03-EV01-01",
      "consigne": "Le chiffre d'affaires de cinq clients, sur deux trimestres répartis sur deux feuilles. **Neuf gestes** vous sont demandés, comptés au premier essai : ni indice, ni retour en arrière.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A3:D8",
          "texte": "Cinq clients, trois mois"
        },
        {
          "type": "MONTRER",
          "cible": "dom:[aria-label=\"Feuille Trimestre 2\"]",
          "texte": "Et un second trimestre sur une autre feuille — neuf gestes vous attendent"
        }
      ]
    },
    {
      "id": "M03-EV01-02",
      "consigne": "Activez la cellule qui contient le chiffre de **février du client Ferrand**.",
      "action": {
        "type": "CLICK_CELL",
        "cell": "C6"
      },
      "points": 1
    },
    {
      "id": "M03-EV01-03",
      "consigne": "Sélectionnez **tous les chiffres de mars**, en-tête exclu.",
      "action": {
        "type": "DRAG_RANGE",
        "range": "D4:D8"
      },
      "points": 1
    },
    {
      "id": "M03-EV01-04",
      "consigne": "Sélectionnez la **ligne entière** du client Guyot.",
      "action": {
        "type": "SELECT_ROW",
        "row": 7
      },
      "points": 1
    },
    {
      "id": "M03-EV01-05",
      "consigne": "Sélectionnez la **colonne entière** des chiffres de janvier.",
      "action": {
        "type": "SELECT_COLUMN",
        "column": "B"
      },
      "points": 1
    },
    {
      "id": "M03-EV01-06",
      "consigne": "Sans utiliser la souris dans la grille, sélectionnez la plage **B4:D8**, c'est-à-dire tous les chiffres du trimestre.",
      "action": {
        "type": "GOTO_REF",
        "ref": "B4:D8"
      },
      "points": 2
    },
    {
      "id": "M03-EV01-07",
      "consigne": "En **G4**, additionnez **uniquement** les chiffres de janvier des clients **Aubry** et **Morvan**.",
      "setup": {
        "selection": "G4",
        "cells": {
          "F4": {
            "v": "Aubry + Morvan, janvier",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "G4",
        "accept": [
          "=SOMME(B4;B8)",
          "=B4+B8"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M03-EV01-08",
      "consigne": "En **G5**, additionnez les chiffres de janvier des **deux premiers** clients et des **deux derniers**, sans Ferrand.",
      "setup": {
        "selection": "G5",
        "cells": {
          "F5": {
            "v": "Janvier sans Ferrand",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "G5",
        "accept": [
          "=SOMME(B4:B5;B7:B8)",
          "=SOMME(B4:B5)+SOMME(B7:B8)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M03-EV01-09",
      "consigne": "Affichez la feuille du **deuxième trimestre**.",
      "action": {
        "type": "SELECT_SHEET",
        "name": "Trimestre 2"
      },
      "points": 1
    },
    {
      "id": "M03-EV01-10",
      "consigne": "En **B10**, totalisez le **mois d'avril** pour les cinq clients.",
      "setup": {
        "selection": "B10"
      },
      "action": {
        "type": "TYPE",
        "target": "B10",
        "accept": [
          "=SOMME(B4:B8)",
          "=B4+B5+B6+B7+B8"
        ],
        "formulaMode": true
      },
      "points": 2
    }
