    },
    {
      "id": "M05-E02-03",
      "consigne": "Mercredi, **huit heures et quart**. Enregistrez-les en B6.",
      "setup": {
        "selection": "B6"
      },
      "action": {
        "type": "TYPE",
        "target": "B6",
        "accept": [
          "8:15",
          "08:15"
        ]
      },
      "aide": {
        "text": "Un quart d'heure, c'est quinze minutes."
      }
    },
    {
      "id": "M05-E02-04",
      "consigne": "Jeudi, **sept heures et demie**. Enregistrez-les en B7.",
      "setup": {
        "selection": "B7"
      },
      "action": {
        "type": "TYPE",
        "target": "B7",
        "accept": [
          "7:30",
          "07:30"
        ]
      },
      "aide": {
        "text": "Une demi-heure, c'est trente minutes."
      }
    },
    {
      "id": "M05-E02-05",
      "consigne": "En **B9**, cumulez les quatre journées.",
      "setup": {
        "selection": "B9"
      },
      "action": {
        "type": "TYPE",
        "target": "B9",
        "accept": [
          "=SOMME(B4:B7)",
          "=B4+B5+B6+B7"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme ordinaire. Si le total paraît trop petit, pensez au format des cumuls."
      },
      "feedback": "30 heures 45."
    },
    {
      "id": "M05-E02-06",
      "consigne": "En **B11**, convertissez ce total en **heures décimales**.",
      "setup": {
        "selection": "B11"
      },
      "action": {
        "type": "TYPE",
        "target": "B11",
        "accept": [
          "=B9*24",
          "=24*B9"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une fraction de journée devient des heures en la multipliant par le nombre d'heures d'une journée."
      },
      "feedback": "30,75 heures — et non 30,45."
    },
    {
      "id": "M05-E02-07",
      "consigne": "En **B15**, calculez le **coût de la semaine** à partir du taux horaire de B13.",
      "setup": {
        "selection": "B15"
      },
      "action": {
        "type": "TYPE",
        "target": "B15",
        "accept": [
          "=B11*B13",
          "=B13*B11",
          "=B9*24*B13"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Ce sont les heures décimales qui se multiplient par un taux, jamais le cumul horaire."
      },
      "feedback": "479,70 €."
    },
