  "steps": [
    {
      "id": "M06-E03-01",
      "consigne": "En **C6**, calculez le prix **après remise** du clavier. Votre formule devra être recopiable sur les trois lignes suivantes.",
      "setup": {
        "selection": "C6"
      },
      "action": {
        "type": "TYPE",
        "target": "C6",
        "accept": [
          "=B6*(1-$B$1)",
          "=B6-B6*$B$1"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Le taux de remise est en B1 et ne doit pas bouger à la recopie."
      },
      "feedback": "40,50 €."
    },
    {
      "id": "M06-E03-02",
      "consigne": "En **D6**, calculez le prix **TTC** à partir du prix remisé. Même exigence : recopiable.",
      "setup": {
        "selection": "D6"
      },
      "action": {
        "type": "TYPE",
        "target": "D6",
        "accept": [
          "=C6*(1+$B$2)",
          "=C6+C6*$B$2"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La TVA est en B2. Le prix remisé, lui, doit suivre la ligne."
      },
      "feedback": "48,60 €."
    },
    {
      "id": "M06-E03-03",
      "consigne": "Complétez les **trois lignes restantes**, en colonnes C et D.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
