  "steps": [
    {
      "id": "M06-E05-01",
      "consigne": "En **C5**, calculez le **CA TTC** du lundi. La formule devra être recopiable sur toute la semaine.",
      "setup": {
        "selection": "C5"
      },
      "action": {
        "type": "TYPE",
        "target": "C5",
        "accept": [
          "=B5*(1+$B$1)",
          "=B5+B5*$B$1"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Le taux est en B1 : il doit rester figé.",
        "showTarget": true
      },
      "feedback": "306 €."
    },
    {
      "id": "M06-E05-02",
      "consigne": "Complétez le **CA TTC des cinq autres jours**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "C6": {
            "v": 384
          },
          "C7": {
            "v": 498
          },
          "C8": {
            "v": 420
          },
          "C9": {
            "v": 576
          },
          "C10": {
            "v": 312
          }
        }
      },
      "aide": {
        "text": "Poignée de recopie de C5 jusqu'à C10."
      },
      "feedback": "Toute la semaine est convertie en TTC."
    },
    {
      "id": "M06-E05-03",
      "consigne": "En **B12** et **C12**, calculez les **totaux de la semaine**, HT et TTC.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "B12": {
            "anyOf": [
              "=SOMME(B5:B10)",
              "=B5+B6+B7+B8+B9+B10"
            ],
            "v": 2080
          },
          "C12": {
            "anyOf": [
              "=SOMME(C5:C10)",
              "=C5+C6+C7+C8+C9+C10"
            ],
            "v": 2496
          }
        }
      },
      "aide": {
        "text": "Une somme par colonne, de la ligne 5 à la ligne 10."
      },
      "feedback": "2 080 € HT et 2 496 € TTC."
    },
    {
      "id": "M06-E05-04",
      "consigne": "En **B13**, trouvez le **meilleur chiffre d'affaires** de la semaine. En **B14**, la **moyenne journalière**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "B13": {
            "anyOf": [
              "=MAX(B5:B10)"
            ],
            "v": 480
          },
          "B14": {
            "anyOf": [
              "=MOYENNE(B5:B10)"
            ],
            "v": 346.6666666666667
          }
        }
      },
      "aide": {
        "text": "Attention à ne pas inclure la ligne de total dans vos plages."
      },
      "feedback": "480 € le vendredi, 346,67 € de moyenne."
    },
    {
      "id": "M06-E05-05",
      "consigne": "Contrôle final : ==sélectionnez **B5:B10**== et vérifiez dans la barre d'état que la somme correspond bien à votre total en B12.",
      "action": {
        "type": "DRAG_RANGE",
        "range": "B5:B10"
      },
      "aide": {
        "text": "Faites glisser de B5 à B10 et lisez la bande grise en bas."
      },
      "feedback": "2 080 € des deux côtés. Le tableau est juste, et vous savez le prouver."
    }
