        "selection": "E5"
      },
      "action": {
        "type": "TYPE",
        "target": "E5",
        "accept": [
          "=SOMME.SI(B2:B7;\"Lille\";C2:C7)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Trois arguments : où chercher, quoi chercher, quoi additionner.",
        "showTarget": true
      },
      "feedback": "1 970 €. C'est le troisième argument qui fait la différence : sans lui, Excel additionnerait la colonne des villes."
