  "steps": [
    {
      "id": "M09-E01-01",
      "consigne": "En **D5**, calculez le salaire d'Amina : le salaire de référence, **majoré** si le statut est « Cadre », inchangé sinon. La formule devra être recopiable sur les quatre lignes.",
      "setup": {
        "selection": "D5"
      },
      "action": {
        "type": "TYPE",
        "target": "D5",
        "accept": [
          "=SI(B5=\"Cadre\";$B$1*(1+$B$2);$B$1)",
          "=SI(B5=\"Cadre\";$B$1*(1+$B$2);$B$1*1)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une condition sur le statut, et deux références figées : le salaire et le taux."
      },
      "feedback": "2 880 € pour Amina."
    },
    {
      "id": "M09-E01-02",
      "consigne": "Complétez les **trois autres salaires**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "D6": {
            "v": 2400
          },
          "D7": {
            "v": 2880
          },
          "D8": {
            "v": 2400
          }
        }
      },
      "aide": {
        "text": "Poignée de recopie vers le bas."
      },
      "feedback": "Les cadres à 2 880 €, les autres à 2 400 €."
    },
    {
      "id": "M09-E01-03",
      "consigne": "En **G5**, calculez la **masse salariale** totale.",
      "setup": {
        "selection": "G5"
      },
      "action": {
        "type": "TYPE",
        "target": "G5",
        "accept": [
          "=SOMME(D5:D8)",
          "=D5+D6+D7+D8"
        ],
        "formulaMode": true
      },
      "feedback": "10 560 €."
    },
    {
      "id": "M09-E01-04",
      "consigne": "En **G6**, comptez le **nombre de cadres**.",
      "setup": {
        "selection": "G6"
      },
      "action": {
        "type": "TYPE",
        "target": "G6",
        "accept": [
          "=NB.SI(B5:B8;\"Cadre\")"
        ],
        "formulaMode": true
      },
      "feedback": "2 cadres."
    },
    {
      "id": "M09-E01-05",
      "consigne": "En **G7**, calculez le **salaire moyen**.",
      "setup": {
        "selection": "G7"
      },
      "action": {
        "type": "TYPE",
        "target": "G7",
        "accept": [
          "=MOYENNE(D5:D8)",
          "=G5/4"
        ],
        "formulaMode": true
      },
      "feedback": "2 640 €."
    },
    {
      "id": "M09-E01-06",
      "consigne": "Contrôle final : sélectionnez **tous les salaires** et vérifiez que le total affiché en bas correspond à votre masse salariale.",
      "action": {
        "type": "DRAG_RANGE",
        "range": "D5:D8"
      },
      "aide": {
        "text": "Les quatre salaires, sans la cellule de total."
      },
      "feedback": "10 560 € des deux côtés. Grille cohérente."
    }
  ]
