 "steps": [
  {
   "id": "M09-E02-01",
   "consigne": "En **C8**, calculez les **honoraires** de la première intervention. La formule devra être recopiable sur les deux lignes suivantes.",
   "setup": {
    "selection": "C8"
   },
   "action": {
    "type": "TYPE",
    "target": "C8",
    "accept": [
     "=B8*$B$3",
     "=$B$3*B8"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Un paramètre commun à toutes les lignes se fige."
   }
  },
  {
   "id": "M09-E02-02",
   "consigne": "En **D8**, calculez le **forfait repas** de cette intervention.",
