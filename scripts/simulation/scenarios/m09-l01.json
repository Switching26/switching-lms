  "steps": [
    {
      "id": "M09-L01-01",
      "consigne": "Commencez par les lignes. En **D5**, ==calculez le total HT de la première ligne== : la quantité multipliée par le prix unitaire.",
      "setup": {
        "selection": "D5"
      },
      "action": {
        "type": "TYPE",
        "target": "D5",
        "accept": [
          "=B5*C5",
          "=C5*B5"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Quantité fois prix unitaire.",
        "showTarget": true
      },
      "feedback": "2 670 €."
    },
    {
      "id": "M09-L01-02",
      "consigne": "==Recopiez D5 jusqu'en D7== pour les deux autres lignes.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "D6": {
            "v": 135
          },
          "D7": {
            "v": 360
          }
        }
      },
      "aide": {
        "text": "Poignée de recopie vers le bas."
      },
      "feedback": "Les trois lignes sont chiffrées."
    },
    {
      "id": "M09-L01-03",
      "consigne": "En **B9**, ==totalisez le HT brut== des trois lignes.",
      "setup": {
        "selection": "B9"
      },
      "action": {
        "type": "TYPE",
        "target": "B9",
        "accept": [
          "=SOMME(D5:D7)",
          "=D5+D6+D7"
        ],
        "formulaMode": true
      },
      "feedback": "3 165 €."
    },
    {
      "id": "M09-L01-04",
      "consigne": "En **B10**, ==calculez le montant de la remise== à partir du taux figurant en B2.",
      "setup": {
        "selection": "B10"
      },
      "action": {
        "type": "TYPE",
        "target": "B10",
        "accept": [
          "=B9*B2",
          "=B2*B9",
          "=B9*$B$2"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Le HT brut multiplié par le taux de remise.",
        "showTarget": true
      },
      "feedback": "158,25 €."
    },
    {
      "id": "M09-L01-05",
      "consigne": "En **B11**, ==calculez le HT net== après remise.",
      "setup": {
        "selection": "B11"
      },
      "action": {
        "type": "TYPE",
        "target": "B11",
        "accept": [
          "=B9-B10"
        ],
        "formulaMode": true
      },
      "feedback": "3 006,75 €."
    },
    {
      "id": "M09-L01-06",
      "consigne": "En **B12**, ==calculez la TVA== sur le HT net.",
      "setup": {
        "selection": "B12"
      },
      "action": {
        "type": "TYPE",
        "target": "B12",
        "accept": [
          "=B11*B1",
          "=B1*B11",
          "=B11*$B$1"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La TVA se calcule sur le montant APRÈS remise, jamais avant.",
        "showTarget": true
      },
      "feedback": "601,35 €. Attention à cet ordre : TVA sur le net remisé, c'est une règle de facturation, pas un choix."
    },
    {
      "id": "M09-L01-07",
      "consigne": "En **B13**, ==calculez le net à payer==.",
      "setup": {
        "selection": "B13"
      },
      "action": {
        "type": "TYPE",
        "target": "B13",
        "accept": [
          "=B11+B12"
        ],
        "formulaMode": true
      },
      "feedback": "3 608,10 €. La facture est complète."
    },
    {
      "id": "M09-L01-08",
      "consigne": "**Contrôlez votre travail** : ==sélectionnez la plage **D5:D7**== et comparez le total affiché en bas avec votre HT brut de B9.",
      "action": {
        "type": "DRAG_RANGE",
        "range": "D5:D7"
      },
      "aide": {
        "text": "Les trois totaux de ligne, sans la cellule de total."
      },
      "feedback": "3 165 € des deux côtés. Ce réflexe vous évitera d'envoyer une facture fausse — et c'est le genre d'erreur qui coûte cher."
    }
  ]
