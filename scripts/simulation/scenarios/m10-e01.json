  "steps": [
    {
      "id": "M10-E01-01",
      "consigne": "En **B2**, retrouvez le **libellé de la prestation** depuis la table de droite. La formule devra être recopiable et **ne jamais afficher #N/A**, même sur une référence inconnue.",
      "setup": {
        "selection": "B2"
      },
      "action": {
        "type": "TYPE",
        "target": "B2",
        "accept": [
          "=SI.ERREUR(RECHERCHEV(A2;$H$2:$J$4;2;FAUX);\"Réf inconnue\")",
          "=SI.ERREUR(RECHERCHEV(A2;$H$2:$J$4;2;FAUX);\"\")"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Deux fonctions à combiner, et la table à figer."
      }
    },
    {
      "id": "M10-E01-02",
      "consigne": "En **D2**, retrouvez le **tarif**, avec la même exigence.",
      "setup": {
        "selection": "D2"
      },
      "action": {
        "type": "TYPE",
        "target": "D2",
        "accept": [
          "=SI.ERREUR(RECHERCHEV(A2;$H$2:$J$4;3;FAUX);0)",
          "=SI.ERREUR(RECHERCHEV(A2;$H$2:$J$4;3;FAUX);\"\")"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Pour un tarif introuvable, renvoyer 0 permet de garder les totaux calculables."
      }
    },
    {
      "id": "M10-E01-03",
      "consigne": "En **E2**, calculez le **total de la ligne**, puis complétez les deux lignes suivantes.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "E2": {
