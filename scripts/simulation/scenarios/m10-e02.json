 "steps": [
  {
   "id": "M10-E02-01",
   "consigne": "En **E2**, affichez `Oui` s'il faut **commander** cette référence — c'est-à-dire si le stock est passé sous son seuil — et `Non` sinon. La formule devra être recopiable.",
   "setup": {
    "selection": "E2"
   },
   "action": {
    "type": "TYPE",
    "target": "E2",
    "accept": [
     "=SI(B2<C2;\"Oui\";\"Non\")",
     "=SI(B2>=C2;\"Non\";\"Oui\")",
     "=SI(C2>B2;\"Oui\";\"Non\")",
     "=SI(C2<=B2;\"Non\";\"Oui\")"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Attention à la frontière : un stock égal au seuil n'est pas encore en dessous."
   }
  },
  {
   "id": "M10-E02-02",
   "consigne": "En **F2**, calculez la **quantité à commander** pour revenir au seuil, ou 0 s'il n'y a rien à commander.",
   "setup": {
    "selection": "F2"
   },
   "action": {
    "type": "TYPE",
    "target": "F2",
    "accept": [
     "=SI(B2<C2;C2-B2;0)",
     "=SI(C2>B2;C2-B2;0)",
     "=SI(B2>=C2;0;C2-B2)",
     "=SI(C2<=B2;0;C2-B2)"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M10-E02-03",
   "consigne": "En **G2**, calculez le **montant** de cette ligne de commande.",
   "setup": {
    "selection": "G2"
   },
   "action": {
    "type": "TYPE",
    "target": "G2",
    "accept": [
     "=F2*D2",
     "=D2*F2"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M10-E02-04",
   "consigne": "Complétez les **quatre références restantes**.",
   "action": {
    "type": "EXPECT_STATE",
    "cells": {
     "E3": {
      "anyOf": [
       "=SI(B3<C3;\"Oui\";\"Non\")",
       "=SI(B3>=C3;\"Non\";\"Oui\")",
       "=SI(C3>B3;\"Oui\";\"Non\")",
       "=SI(C3<=B3;\"Non\";\"Oui\")"
      ],
      "v": "Oui"
     },
     "F3": {
      "anyOf": [
       "=SI(B3<C3;C3-B3;0)",
       "=SI(C3>B3;C3-B3;0)",
       "=SI(B3>=C3;0;C3-B3)",
       "=SI(C3<=B3;0;C3-B3)"
      ],
      "v": 2
     },
     "G3": {
      "anyOf": [
       "=F3*D3",
       "=D3*F3"
      ],
      "v": 159.8
     },
     "E4": {
      "anyOf": [
       "=SI(B4<C4;\"Oui\";\"Non\")",
       "=SI(B4>=C4;\"Non\";\"Oui\")",
       "=SI(C4>B4;\"Oui\";\"Non\")",
       "=SI(C4<=B4;\"Non\";\"Oui\")"
      ],
      "v": "Non"
     },
     "F4": {
      "anyOf": [
       "=SI(B4<C4;C4-B4;0)",
       "=SI(C4>B4;C4-B4;0)",
       "=SI(B4>=C4;0;C4-B4)",
       "=SI(C4<=B4;0;C4-B4)"
      ],
      "v": 0
     },
     "G4": {
      "anyOf": [
       "=F4*D4",
       "=D4*F4"
      ],
      "v": 0.0
     },
     "E5": {
      "anyOf": [
       "=SI(B5<C5;\"Oui\";\"Non\")",
       "=SI(B5>=C5;\"Non\";\"Oui\")",
       "=SI(C5>B5;\"Oui\";\"Non\")",
       "=SI(C5<=B5;\"Non\";\"Oui\")"
      ],
      "v": "Oui"
     },
     "F5": {
      "anyOf": [
       "=SI(B5<C5;C5-B5;0)",
       "=SI(C5>B5;C5-B5;0)",
       "=SI(B5>=C5;0;C5-B5)",
       "=SI(C5<=B5;0;C5-B5)"
      ],
      "v": 9
     },
     "G5": {
      "anyOf": [
       "=F5*D5",
       "=D5*F5"
      ],
      "v": 116.10000000000001
     },
     "E6": {
      "anyOf": [
       "=SI(B6<C6;\"Oui\";\"Non\")",
       "=SI(B6>=C6;\"Non\";\"Oui\")",
       "=SI(C6>B6;\"Oui\";\"Non\")",
       "=SI(C6<=B6;\"Non\";\"Oui\")"
      ],
      "v": "Non"
     },
     "F6": {
      "anyOf": [
       "=SI(B6<C6;C6-B6;0)",
       "=SI(C6>B6;C6-B6;0)",
       "=SI(B6>=C6;0;C6-B6)",
       "=SI(C6<=B6;0;C6-B6)"
      ],
      "v": 0
     },
     "G6": {
      "anyOf": [
       "=F6*D6",
       "=D6*F6"
      ],
      "v": 0.0
     }
    }
   },
   "aide": {
    "text": "Sélectionnez les trois cellules de la première ligne avant de recopier."
   }
  },
  {
   "id": "M10-E02-05",
   "consigne": "En **J1**, calculez la **quantité totale** à commander.",
   "setup": {
    "selection": "J1"
   },
   "action": {
    "type": "TYPE",
    "target": "J1",
    "accept": [
     "=SOMME(F2:F6)",
     "=F2+F3+F4+F5+F6"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M10-E02-06",
   "consigne": "En **J2**, calculez le **montant total** de la commande.",
   "setup": {
    "selection": "J2"
   },
   "action": {
    "type": "TYPE",
    "target": "J2",
    "accept": [
     "=SOMME(G2:G6)",
     "=G2+G3+G4+G5+G6"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M10-E02-07",
   "consigne": "Contrôle : sélectionnez la colonne des **quantités** et vérifiez que la somme affichée en bas correspond à votre total.",
   "action": {
    "type": "DRAG_RANGE",
    "range": "F2:F6"
   },
   "aide": {
    "text": "Les cinq quantités, sans l'en-tête."
   }
  }
 ]
