  {
   "id": "M10-E03-01",
   "consigne": "En **G2**, comptez les **dossiers** financés par le dispositif nommé en F2. La formule devra se recopier sur les trois lignes.",
   "setup": {
    "selection": "G2"
   },
   "action": {
    "type": "TYPE",
    "target": "G2",
    "accept": [
     "=NB.SI($B$2:$B$9;F2)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Le critère se lit dans la cellule voisine ; la plage examinée, elle, ne doit pas bouger."
   }
  },
  {
   "id": "M10-E03-02",
   "consigne": "En **H2**, totalisez les **heures** de ce dispositif.",
