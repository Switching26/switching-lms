 "steps": [
  {
   "id": "M10-E05-00",
   "consigne": "Les dates arrivent sous leur forme brute. Rendez **lisibles** les deux dates de la commande, déjà sélectionnées.",
   "setup": {
    "selection": "B3:B4"
   },
   "action": {
    "type": "EXPECT_FORMAT",
    "cells": {
     "B3": {
      "numberFormat": "date"
     },
     "B4": {
      "numberFormat": "date"
     }
    }
   },
   "aide": {
    "text": "Un format de nombre, pas une formule."
   }
  },
  {
   "id": "M10-E05-01",
   "consigne": "En **B7**, comptez les **jours ouvrés écoulés** entre la commande et la livraison, jours fériés déduits.",
   "setup": {
    "selection": "B7"
   },
   "action": {
    "type": "TYPE",
    "target": "B7",
    "accept": [
     "=NB.JOURS.OUVRES(B3;B4;E3:E4)",
     "=NB.JOURS.OUVRES(B3;B4;$E$3:$E$4)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "La liste des fériés est un troisième argument, pas une soustraction à faire soi-même."
   }
  },
  {
   "id": "M10-E05-02",
   "consigne": "En **B8**, calculez la **date d'expédition promise** : 10 jours ouvrés après la commande.",
   "setup": {
    "selection": "B8"
   },
   "action": {
    "type": "TYPE",
    "target": "B8",
    "accept": [
     "=SERIE.JOUR.OUVRE(B3;10;E3:E4)",
     "=SERIE.JOUR.OUVRE(B3;10;$E$3:$E$4)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Cette fonction renvoie une date, pas un nombre de jours."
   }
  },
  {
   "id": "M10-E05-03",
   "consigne": "Rendez cette date **lisible**.",
   "setup": {
    "selection": "B8"
   },
   "action": {
    "type": "EXPECT_FORMAT",
    "cells": {
     "B8": {
      "numberFormat": "date"
     }
    }
   },
   "aide": {
    "text": "Un format, pas une formule."
   }
  },
  {
   "id": "M10-E05-04",
   "consigne": "En **B9**, calculez l'**échéance de la facture** : 30 jours calendaires après la commande.",
   "setup": {
    "selection": "B9"
   },
   "action": {
    "type": "TYPE",
    "target": "B9",
    "accept": [
     "=B3+30",
     "=30+B3"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "30 jours calendaires, pas ouvrés : ici, une simple addition suffit."
   }
  },
  {
   "id": "M10-E05-05",
   "consigne": "Rendez cette échéance **lisible** elle aussi.",
   "setup": {
    "selection": "B9"
   },
   "action": {
    "type": "EXPECT_FORMAT",
    "cells": {
     "B9": {
      "numberFormat": "date"
     }
    }
   }
  },
  {
   "id": "M10-E05-06",
   "consigne": "En **B10**, calculez le **retard en jours ouvrés** entre l'expédition promise et la livraison constatée. Le jour de l'expédition promise ne compte pas.",
   "setup": {
    "selection": "B10"
   },
   "action": {
    "type": "TYPE",
    "target": "B10",
    "accept": [
