 "steps": [
  {
   "id": "M10-EV01-01",
   "consigne": "Repérez d'abord les **quatre blocs** : les inscriptions à gauche, la table des tarifs, la synthèse et les deux calculs du bas. Le seuil de « parcours long » est en **C1**.",
   "action": {
    "type": "READ"
   },
   "points": 0
  },
  {
   "id": "M10-EV01-02",
   "consigne": "En **D3**, retrouvez le **libellé de la formation** dans la table des tarifs. La formule devra se recopier et **afficher `Code inconnu`** plutôt qu'une erreur si le code est absent.",
   "setup": {
    "selection": "D3"
   },
   "action": {
    "type": "TYPE",
    "target": "D3",
    "accept": [
     "=SIERREUR(RECHERCHEV(B3;$H$3:$J$6;2;FAUX);\"Code inconnu\")"
    ],
    "formulaMode": true
   },
   "points": 3
  },
  {
   "id": "M10-EV01-03",
   "consigne": "En **E3**, retrouvez le **tarif horaire**, avec la même exigence : **0** si le code est inconnu.",
   "setup": {
    "selection": "E3"
   },
   "action": {
    "type": "TYPE",
    "target": "E3",
    "accept": [
     "=SIERREUR(RECHERCHEV(B3;$H$3:$J$6;3;FAUX);0)"
    ],
    "formulaMode": true
   },
   "points": 2
  },
  {
   "id": "M10-EV01-04",
   "consigne": "En **F3**, calculez le **montant** du dossier.",
   "setup": {
    "selection": "F3"
   },
   "action": {
    "type": "TYPE",
    "target": "F3",
    "accept": [
     "=C3*E3",
     "=E3*C3"
    ],
    "formulaMode": true
   },
   "points": 1
  },
  {
   "id": "M10-EV01-05",
   "consigne": "En **G3**, affichez `Long` si la durée atteint le seuil de C1, `Court` sinon.",
   "setup": {
    "selection": "G3"
   },
   "action": {
    "type": "TYPE",
    "target": "G3",
    "accept": [
     "=SI(C3>=$C$1;\"Long\";\"Court\")",
     "=SI(C3<$C$1;\"Court\";\"Long\")",
     "=SI($C$1<=C3;\"Long\";\"Court\")"
    ],
    "formulaMode": true
   },
   "points": 2
  },
  {
   "id": "M10-EV01-06",
   "consigne": "Complétez les **quatre dossiers restants**, colonnes D à G.",
