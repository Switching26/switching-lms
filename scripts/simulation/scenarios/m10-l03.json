  "steps": [
    {
      "id": "M10-L03-01",
      "consigne": "Voici pourquoi on écrit une formule au lieu de remplir à la main : demain un virement arrive, et tout serait à refaire. La situation et la structure de la fonction sont posées à l'écran. Gardez-en l'idée générale : trois arguments, la condition d'abord, puis les deux issues possibles.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "D2",
          "texte": "Statut et Pénalité sont vides"
        },
        {
          "type": "MONTRER",
          "cible": "C3",
          "texte": "On ne les remplit pas à la main : demain un virement arrive et tout serait à refaire"
        },
        {
          "type": "MONTRER",
          "cible": "B3",
          "texte": "SI prend trois arguments : la condition, le résultat si vrai, le résultat si faux"
        }
      ]
    },
    {
      "id": "M10-L03-02",
      "consigne": "En **D3**, ==saisissez `=SI(C3>=B3;\"Soldé\";\"Reste à payer\")`==. La formule devra descendre sur les cinq lignes.",
      "setup": {
        "selection": "D3"
      },
      "action": {
        "type": "TYPE",
        "target": "D3",
        "accept": [
          "=SI(C3>=B3;\"Soldé\";\"Reste à payer\")",
          "=SI(C3<B3;\"Reste à payer\";\"Soldé\")",
          "=SI(B3<=C3;\"Soldé\";\"Reste à payer\")",
          "=SI(B3>C3;\"Reste à payer\";\"Soldé\")"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Le texte renvoyé se met entre guillemets droits, sinon Excel le prend pour un nom de plage et refuse la formule.",
        "showTarget": true
      },
      "feedback": "« Soldé » : le reçu égale le dû. Notez le `>=` — avec un simple `>`, un client ayant payé au centime près serait déclaré débiteur."
    },
    {
      "id": "M10-L03-03",
      "consigne": "==Recopiez **D3** jusqu'en D7== pour qualifier les quatre autres clients.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "D4": {
