  "steps": [
    {
      "id": "M10-L07-01",
      "consigne": "En **D3**, ==saisissez `=RANG(B3;$B$3:$B$8)`== pour classer Bertrand parmi les six chiffres réalisés.",
      "setup": {
        "selection": "D3"
      },
      "action": {
        "type": "TYPE",
        "target": "D3",
        "accept": [
          "=RANG(B3;$B$3:$B$8)",
          "=RANG(B3;$B$3:$B$8;0)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Deux arguments : la valeur à situer, et la liste dans laquelle la situer — figée, pour que la recopie interroge toujours les six.",
        "showTarget": true
      },
      "feedback": "Rang 2. RANG classe du plus grand au plus petit par défaut ; un troisième argument à 1 inverserait l'ordre. Et la liste n'a surtout pas besoin d'être triée."
    },
    {
      "id": "M10-L07-02",
      "consigne": "==Recopiez **D3** jusqu'en D8== pour classer les six commerciaux.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "D4": {
            "anyOf": [
              "=RANG(B4;$B$3:$B$8)",
              "=RANG(B4;$B$3:$B$8;0)"
            ],
            "v": 5
          },
          "D5": {
            "anyOf": [
              "=RANG(B5;$B$3:$B$8)",
              "=RANG(B5;$B$3:$B$8;0)"
            ],
            "v": 1
          },
          "D6": {
