  "steps": [
    {
      "id": "M11-E02-01",
      "consigne": "En **E1**, affichez le **deuxième volume le plus élevé** : c'est le seuil d'entrée dans le duo de tête.",
      "setup": {
        "selection": "E1"
      },
      "action": {
        "type": "TYPE",
        "target": "E1",
        "accept": [
          "=GRANDE.VALEUR($B$2:$B$9;2)",
          "=GRANDE.VALEUR(B2:B9;2)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une fonction, deux arguments : où chercher, et quel rang."
      }
    },
    {
      "id": "M11-E02-02",
      "consigne": "Colorez en **vert** les formations qui dépassent **200 heures**.",
      "setup": {
        "selection": "B2:B9",
        "cf": {
          "range": "B2:B9",
          "rule": {
            "kind": "greaterThan",
            "value": 200,
            "background": "#bbf7d0"
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-mfc-regle"
      },
      "aide": {
        "text": "La plage est déjà sélectionnée : il reste le bouton du groupe Styles."
      }
    },
    {
      "id": "M11-E02-03",
      "consigne": "En **E2**, affichez le **deuxième volume le plus faible**.",
      "setup": {
        "selection": "E2"
      },
      "action": {
        "type": "TYPE",
        "target": "E2",
        "accept": [
          "=PETITE.VALEUR($B$2:$B$9;2)",
          "=PETITE.VALEUR(B2:B9;2)"
        ],
        "formulaMode": true
      }
    },
    {
      "id": "M11-E02-04",
      "consigne": "Colorez en **rouge** les formations sous **100 heures**. Les formations les plus courtes passent au rouge.",
      "setup": {
        "selection": "B2:B9",
        "cf": {
          "range": "B2:B9",
          "rule": {
            "kind": "lessThan",
            "value": 100,
            "background": "#fecaca"
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-mfc-regle"
      }
    },
    {
      "id": "M11-E02-05",
      "consigne": "En **E4**, comptez les formations **au-dessus de 200 heures** : le compte doit tomber sur le nombre de cellules vertes.",
      "setup": {
        "selection": "E4"
      },
      "action": {
        "type": "TYPE",
        "target": "E4",
        "accept": [
          "=NB.SI($B$2:$B$9;\">200\")",
          "=NB.SI(B2:B9;\">200\")"
        ],
        "formulaMode": true
      }
    },
    {
      "id": "M11-E02-06",
      "consigne": "En **E5**, totalisez les **heures de ces mêmes formations**.",
      "setup": {
        "selection": "E5"
      },
      "action": {
        "type": "TYPE",
        "target": "E5",
        "accept": [
          "=SOMME.SI($B$2:$B$9;\">200\")",
          "=SOMME.SI(B2:B9;\">200\")",
          "=SOMME.SI(B2:B9;\">200\";B2:B9)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La colonne testée est aussi celle à additionner."
      }
    }
  ]
}
