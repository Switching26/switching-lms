        "selection": "B11"
      },
      "action": {
        "type": "TYPE",
        "target": "B11",
        "accept": [
          "=SOMME(Prestations)*Taux_remise",
          "=Taux_remise*SOMME(Prestations)",
          "=B10*Taux_remise",
          "=Taux_remise*B10"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
