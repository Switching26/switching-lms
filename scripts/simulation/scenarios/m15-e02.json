 "steps": [
  {
   "id": "M15-E02-01",
   "consigne": "En **B3** de la feuille Synthèse, obtenez le **total des heures de Bureautique** des trois centres. La formule devra être recopiable.",
   "setup": {
    "selection": "B3"
   },
   "action": {
    "type": "TYPE",
    "target": "B3",
    "accept": [
     "=Angers!B2+Nantes!B2+Rennes!B2",
     "=SOMME(Angers!B2;Nantes!B2;Rennes!B2)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Les trois feuilles ont la même structure : la Bureautique est toujours en B2."
   }
  },
  {
   "id": "M15-E02-02",
   "consigne": "Complétez les **deux autres modules**.",
   "action": {
    "type": "EXPECT_STATE",
    "cells": {
     "B4": {
      "anyOf": [
       "=Angers!B3+Nantes!B3+Rennes!B3",
       "=SOMME(Angers!B3;Nantes!B3;Rennes!B3)"
      ],
      "v": 875
     },
     "B5": {
      "anyOf": [
       "=Angers!B4+Nantes!B4+Rennes!B4",
       "=SOMME(Angers!B4;Nantes!B4;Rennes!B4)"
      ],
      "v": 640
     }
    }
   },
   "aide": {
    "text": "Poignée de recopie : les noms de feuille ne bougeront pas."
   }
  },
  {
   "id": "M15-E02-03",
   "consigne": "En **B7**, calculez le **total des heures**.",
   "setup": {
    "selection": "B7"
   },
   "action": {
    "type": "TYPE",
    "target": "B7",
    "accept": [
     "=SOMME(B3:B5)",
     "=B3+B4+B5"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M15-E02-04",
   "consigne": "En **B8**, calculez le **chiffre d'affaires** correspondant, au tarif horaire de B1.",
   "setup": {
    "selection": "B8"
   },
   "action": {
    "type": "TYPE",
    "target": "B8",
    "accept": [
     "=B7*B1",
     "=B1*B7",
     "=B7*$B$1"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M15-E02-05",
   "consigne": "En **B10**, affichez le **nombre d'heures du meilleur centre**, en comparant les trois totaux.",
   "setup": {
    "selection": "B10"
   },
   "action": {
    "type": "TYPE",
    "target": "B10",
    "accept": [
     "=MAX(Angers!B6;Nantes!B6;Rennes!B6)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Chaque centre calcule déjà son total en B6."
   }
  },
  {
   "id": "M15-E02-06",
   "consigne": "Allez vérifier ce total sur la feuille du centre concerné : **Nantes**.",
   "action": {
    "type": "SELECT_SHEET",
    "name": "Nantes"
   },
   "aide": {
    "text": "Les onglets sont en bas de la fenêtre."
   }
  },
  {
   "id": "M15-E02-07",
   "consigne": "Revenez sur la feuille **Synthèse**.",
   "action": {
    "type": "SELECT_SHEET",
    "name": "Synthèse"
   }
  }
 ]
}
