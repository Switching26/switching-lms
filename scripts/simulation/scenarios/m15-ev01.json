  "steps": [
    {
      "id": "M15-EV01-01",
      "consigne": "Les deux semestres portent les canaux dans le **même ordre** : Direct en B2, CPF en B3, OPCO en B4. Vous travaillez sur la feuille Bilan. **Sept gestes**, comptés au premier essai, sans aide.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "B2",
          "texte": "Direct en B2, dans les deux semestres"
        },
        {
          "type": "MONTRER",
          "cible": "B3",
          "texte": "CPF en B3, OPCO en B4 : le MÊME ordre partout"
        },
        {
          "type": "MONTRER",
          "cible": "dom:[aria-label=\"Feuille Bilan\"]",
          "texte": "Et la feuille Bilan est celle où vous travaillez"
        }
      ]
    },
    {
      "id": "M15-EV01-02",
      "consigne": "En **B3**, calculez le **CA annuel du canal Direct** à partir des deux semestres. La formule devra se recopier.",
      "setup": {
        "selection": "B3"
      },
      "action": {
        "type": "TYPE",
        "target": "B3",
        "accept": [
          "=S1!B2+S2!B2",
          "=SOMME(S1!B2;S2!B2)"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M15-EV01-03",
      "consigne": "Complétez les **deux autres canaux**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "B4": {
            "anyOf": [
              "=S1!B3+S2!B3",
              "=SOMME(S1!B3;S2!B3)"
            ],
            "v": 26800
          },
          "B5": {
            "anyOf": [
              "=S1!B4+S2!B4",
              "=SOMME(S1!B4;S2!B4)"
            ],
            "v": 20100
          }
        }
      },
      "points": 2
    },
    {
      "id": "M15-EV01-04",
      "consigne": "En **B7**, calculez le **total de l'année**.",
      "setup": {
        "selection": "B7"
      },
      "action": {
        "type": "TYPE",
        "target": "B7",
        "accept": [
          "=SOMME(B3:B5)",
          "=B3+B4+B5"
        ],
        "formulaMode": true
      },
      "points": 1
    },
    {
      "id": "M15-EV01-05",
      "consigne": "En **B8**, calculez la **part du canal Direct** dans le total annuel.",
      "setup": {
        "selection": "B8"
      },
      "action": {
        "type": "TYPE",
        "target": "B8",
        "accept": [
          "=B3/B7",
          "=B3/$B$7"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M15-EV01-06",
      "consigne": "En **B10**, calculez la **progression du canal OPCO** entre le premier et le second semestre, en euros.",
      "setup": {
        "selection": "B10"
      },
      "action": {
        "type": "TYPE",
        "target": "B10",
        "accept": [
          "=S2!B4-S1!B4"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M15-EV01-07",
      "consigne": "En **B11**, affichez le **chiffre du meilleur semestre**, en comparant les deux totaux.",
      "setup": {
        "selection": "B11"
      },
      "action": {
        "type": "TYPE",
        "target": "B11",
        "accept": [
          "=MAX(S1!B6;S2!B6)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M15-EV01-08",
      "consigne": "Terminez en affichant la feuille du **second semestre** pour contrôler son total.",
      "action": {
        "type": "SELECT_SHEET",
        "name": "S2"
      },
      "points": 1
    }
  ],
