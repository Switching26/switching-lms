  "steps": [
    {
      "id": "M16-E01-01",
      "consigne": "En **D5**, calculez le **score pondéré** d'Amina : la qualité compte double, les délais une fois. Les coefficients sont en I4 et I5, et la formule doit être recopiable.",
      "setup": {
        "selection": "D5"
      },
      "action": {
        "type": "TYPE",
        "target": "D5",
        "accept": [
          "=(B5*$I$4+C5*$I$5)/($I$4+$I$5)",
          "=SOMMEPROD(B5:C5;$I$4:$I$5)/SOMME($I$4:$I$5)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Somme des notes fois coefficients, divisée par la somme des coefficients."
      },
      "feedback": "87,33."
    },
    {
      "id": "M16-E01-02",
      "consigne": "En **E5**, attribuez la **prime** si le score atteint le seuil, rien sinon.",
      "setup": {
        "selection": "E5"
      },
      "action": {
        "type": "TYPE",
        "target": "E5",
        "accept": [
          "=SI(D5>=$B$1;$B$2;0)",
          "=SI($B$1<=D5;$B$2;0)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une condition sur le score, avec le seuil et le montant figés."
      },
      "feedback": "500 € pour Amina."
    },
    {
      "id": "M16-E01-03",
      "consigne": "Complétez les **deux salariés restants**, score et prime.",
