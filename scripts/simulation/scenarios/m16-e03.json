 "steps": [
  {
   "id": "M16-E03-01",
   "consigne": "En **B9**, calculez la **mensualité**. Elle doit s'afficher en positif.",
   "setup": {
    "selection": "B9"
   },
   "action": {
    "type": "TYPE",
    "target": "B9",
    "accept": [
     "=VPM(B7;B8;-B3)",
     "=-VPM(B7;B8;B3)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Le taux mensuel et le nombre de mensualités sont en B7 et B8."
   }
  },
  {
   "id": "M16-E03-02",
   "consigne": "En **B12**, calculez la part d'**intérêts** de l'échéance dont le numéro figure en A12. La formule devra se recopier sur les quatre échéances.",
   "setup": {
    "selection": "B12"
   },
   "action": {
    "type": "TYPE",
    "target": "B12",
    "accept": [
     "=INTPER($B$7;A12;$B$8;-$B$3)"
    ],
    "formulaMode": true
   },
   "aide": {
    "text": "Tous les paramètres du prêt doivent être figés ; seul le numéro d'échéance suit la recopie."
   }
  },
  {
   "id": "M16-E03-03",
   "consigne": "En **C12**, calculez la part de **capital remboursé**.",
   "setup": {
    "selection": "C12"
   },
   "action": {
    "type": "TYPE",
    "target": "C12",
    "accept": [
     "=PRINCPER($B$7;A12;$B$8;-$B$3)",
     "=$B$9-B12"
    ],
    "formulaMode": true
   }
  },
  {
   "id": "M16-E03-04",
   "consigne": "En **D12**, additionnez les deux parts : c'est votre contrôle, le résultat doit égaler la mensualité.",
   "setup": {
    "selection": "D12"
   },
   "action": {
    "type": "TYPE",
    "target": "D12",
    "accept": [
     "=B12+C12",
     "=SOMME(B12:C12)"
    ],
    "formulaMode": true
   }
  },
