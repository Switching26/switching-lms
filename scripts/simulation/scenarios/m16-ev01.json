  "steps": [
    {
      "id": "M16-EV01-01",
      "consigne": "Le barème de commissionnement est en haut à gauche : **2 %** au-delà de 12 000 €, **5 %** au-delà de 30 000 €, rien en dessous. Les autres blocs portent leurs paramètres à côté d'eux. **Douze gestes**, comptés au premier essai, sans aide.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "B2",
          "texte": "2 % au-delà de 12 000 €"
        },
        {
          "type": "MONTRER",
          "cible": "B3",
          "texte": "5 % au-delà de 30 000 €, rien en dessous"
        },
        {
          "type": "MONTRER",
          "cible": "F4",
          "texte": "Les autres blocs ont leurs paramètres à côté d'eux"
        }
      ]
    },
    {
      "id": "M16-EV01-02",
      "consigne": "En **C5**, déterminez le **taux** de Bertrand d'après le barème. La formule devra se recopier sur les quatre vendeurs.",
      "setup": {
        "selection": "C5"
      },
      "action": {
        "type": "TYPE",
        "target": "C5",
        "accept": [
          "=SI(B5>=$B$3;$C$3;SI(B5>=$B$2;$C$2;0))"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M16-EV01-03",
      "consigne": "En **D5**, calculez la **commission**, arrondie au centime.",
