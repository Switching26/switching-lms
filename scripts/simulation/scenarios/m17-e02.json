  "steps": [
    {
      "id": "M17-E02-01",
      "consigne": "Première question : **comment la température évolue-t-elle sur l'année** ? Créez le graphique qui y répond, à partir du **premier tableau**. Une ligne continue doit relier les douze mois.",
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "type": "courbes",
          "categories": "A2:A13",
          "seriesCount": 1
        }
      },
      "aide": {
        "text": "Une évolution dans le temps appelle la courbe. Sélectionnez les douze mois et leurs températures."
      }
    },
    {
      "id": "M17-E02-02",
      "consigne": "Deuxième question : **comment le budget se répartit-il** entre les quatre postes ? Créez le graphique qui y répond, à partir du **second tableau**, plus bas dans la feuille. Un disque partagé en quatre parts doit apparaître.",
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "type": "secteurs",
          "categories": "A17:A20",
          "seriesCount": 1
        }
      },
      "aide": {
        "text": "Une répartition d'un total appelle le secteur. Le second tableau commence en A16."
      },
      "feedback": "Le total des quatre postes est le budget : la part a donc un sens."
    },
    {
      "id": "M17-E02-03",
      "consigne": "**Matériel pédagogique** et **Communication** sont des libellés longs, illisibles sous un histogramme. Reprenez le budget avec le type qui couche les libellés à l'horizontale. Les libellés doivent alors se lire à l'horizontale, en entier.",
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "type": "barres",
          "categories": "A17:A20",
          "seriesCount": 1
        }
      },
      "aide": {
        "text": "Les barres horizontales : onglet Insertion, bouton Barres."
      },
      "feedback": "Les libellés se lisent d'un coup, sans incliner la tête ni la feuille."
    },
    {
      "id": "M17-E02-04",
      "consigne": "Affichez les **étiquettes de données** pour donner les montants exacts.",
      "setup": {
        "chartEdit": {
          "elements": {
            "etiquettes": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-etiquettes"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Éléments du graphique : bouton « Étiquettes »."
      }
    },
    {
      "id": "M17-E02-05",
      "consigne": "Les étiquettes rendent le **quadrillage** inutile. Masquez-le. Les lignes horizontales du fond disparaissent.",
      "setup": {
        "chartEdit": {
          "elements": {
            "quadrillage": false
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-quadrillage"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Éléments du graphique : bouton « Quadrillage »."
      },
      "feedback": "Un élément qui répète une information qu'on lit déjà ailleurs se retire."
    }
  ]
