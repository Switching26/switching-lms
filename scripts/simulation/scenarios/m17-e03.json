  "steps": [
    {
      "id": "M17-E03-01",
      "consigne": "Sélectionnez la **légende** du graphique.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "legende"
      },
      "aide": {
        "text": "Les quatre carrés colorés, sous le tracé."
      }
    },
    {
      "id": "M17-E03-02",
      "consigne": "Le rapport n'en a pas besoin : les trimestres sont dans l'ordre. **Masquez la légende.**",
      "setup": {
        "chartEdit": {
          "elements": {
            "legende": false
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-legende"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Légende, Aucune."
      }
    },
    {
      "id": "M17-E03-03",
      "consigne": "La direction veut commenter le **quatrième trimestre de la région Ouest**. Sélectionnez ce seul point.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "point:3:3"
      },
      "aide": {
        "text": "Dans le dernier groupe de barres, la quatrième. Un premier clic prend la série, un second le point."
      },
      "feedback": "Un point isolé se met en forme sans toucher au reste."
    },
    {
      "id": "M17-E03-04",
      "consigne": "Affichez les **étiquettes de données** pour que les montants soient lisibles sans le quadrillage.",
      "setup": {
        "chartEdit": {
          "elements": {
            "etiquettes": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-etiquettes"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Étiquettes de données."
      }
    },
    {
      "id": "M17-E03-05",
      "consigne": "Le troisième trimestre est confidentiel. **Masquez la série T3 sans la supprimer** : elle doit pouvoir revenir.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "T3",
              "hidden": true
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 3,
          "series": [
            {
              "name": "T1",
              "hidden": false
            },
            {
              "name": "T2",
              "hidden": false
            },
            {
              "name": "T3",
              "hidden": true
            },
            {
              "name": "T4",
              "hidden": false
            }
          ]
        }
      },
      "aide": {
        "text": "Le filtre de séries, ou Sélectionner des données en décochant T3."
      },
      "feedback": "Masquer n'est pas supprimer : la série reste dans le graphique, prête à réapparaître."
    },
    {
      "id": "M17-E03-06",
      "consigne": "Terminez en affichant les **titres des axes** : sans unité, un montant ne veut rien dire.",
      "setup": {
        "chartEdit": {
          "elements": {
            "titresAxes": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-titres-axes"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Titres des axes."
      }
    }
