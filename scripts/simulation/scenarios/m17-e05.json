    {
      "id": "M17-E05-01",
      "consigne": "On veut suivre la **progression** de chaque famille, pas comparer les mois entre eux. Changez le type pour des **courbes**.",
      "setup": {
        "chartEdit": {
          "type": "courbes"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-modifier-type"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Type : bouton « Modifier le type »."
      }
    },
    {
      "id": "M17-E05-02",
      "consigne": "La colonne **Certifications** manque au graphique. Ajoutez-la comme troisième série. Une troisième couleur doit apparaître dans le tracé et dans la légende.",
      "setup": {
        "chartEdit": {
          "source": "A1:D7",
          "addSeries": [
            {
              "name": "Certifications",
              "values": "D2:D7"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 3,
          "series": [
            {
              "name": "Formations courtes"
            },
            {
              "name": "Formations longues"
            },
            {
              "name": "Certifications",
              "values": "D2:D7"
            }
          ]
        }
      },
      "aide": {
        "text": "Sélectionner des données, ou étendre la plage source du graphique."
      }
    },
    {
      "id": "M17-E05-03",
      "consigne": "Erreur de saisie repérée : en **C5**, les formations longues d'avril sont **17**, pas 14.",
      "setup": {
        "selection": "C5"
      },
      "action": {
        "type": "TYPE",
        "target": "C5",
        "accept": [
          "17"
        ]
      },
      "aide": {
        "text": "Corrigez la cellule, le graphique suivra tout seul."
      },
      "feedback": "Le graphique s'est redessiné : il lit les cellules, il ne les copie pas."
    },
    {
      "id": "M17-E05-04",
      "consigne": "Titrez le graphique **Ventes par famille au 1er semestre**. Le titre apparaît au-dessus du tracé.",
      "setup": {
        "chartEdit": {
          "title": "Ventes par famille au 1er semestre"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-titre"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Éléments du graphique : bouton « Titre »."
      }
    },
    {
      "id": "M17-E05-05",
      "consigne": "Terminez avec le **style 2**, plus sobre pour un document imprimé. Le fond s'allège et les couleurs changent.",
