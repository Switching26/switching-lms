        "chartEdit": {
          "style": 2
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-style-2"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Styles : bouton « Style 2 »."
      }
    }
