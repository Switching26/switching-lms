  "steps": [
    {
      "id": "M17-EV01-01",
      "consigne": "Deux tableaux vous attendent : les **heures par trimestre** en haut, les **financements** juste en dessous. Six graphiques ou réglages vous sont demandés.",
      "action": {
        "type": "READ"
      },
      "points": 0
    },
    {
      "id": "M17-EV01-02",
      "consigne": "Comparez trimestre par trimestre les **heures réalisées** et les **heures prévues**. Créez l'**histogramme** correspondant, titres de colonnes compris.",
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "type": "histogramme",
          "categories": "A2:A5",
          "seriesCount": 2,
          "series": [
            {
              "name": "Heures réalisées"
            },
            {
              "name": "Heures prévues"
            }
          ]
        }
      },
      "points": 2
    },
    {
      "id": "M17-EV01-03",
      "consigne": "Titrez-le **Heures réalisées et prévues**.",
      "setup": {
        "chartEdit": {
          "title": "Heures réalisées et prévues"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-titre"
      },
      "points": 1
    },
    {
      "id": "M17-EV01-04",
      "consigne": "Placez la **légende en bas**.",
      "setup": {
        "chartEdit": {
          "legendPosition": "bas",
          "elements": {
            "legende": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-legende-bas"
      },
      "points": 1
    },
    {
      "id": "M17-EV01-05",
      "consigne": "La direction ne veut voir que le réalisé. **Masquez la série des heures prévues**, sans la supprimer.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Heures prévues",
              "hidden": true
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 1,
          "series": [
            {
              "name": "Heures réalisées",
              "hidden": false
            },
            {
              "name": "Heures prévues",
              "hidden": true
            }
          ]
        }
      },
      "points": 2
    },
    {
      "id": "M17-EV01-06",
      "consigne": "Affichez les **étiquettes de données**.",
      "setup": {
        "chartEdit": {
          "elements": {
            "etiquettes": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
