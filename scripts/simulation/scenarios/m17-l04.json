  "steps": [
    {
      "id": "M17-L04-01",
      "consigne": "==Cliquez sur la **légende**== pour la sélectionner.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "legende"
      },
      "aide": {
        "text": "Les quatre carrés colorés T1 à T4, sous le tracé.",
        "showTarget": true
      },
      "feedback": "Sélectionné, un élément peut être masqué, déplacé ou mis en forme."
    },
    {
      "id": "M17-L04-02",
      "consigne": "==Masquez la légende== avec le bouton **Ajouter un élément de graphique**, ligne Légende.",
      "setup": {
        "chartEdit": {
          "elements": {
            "legende": false
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-legende"
      },
      "aide": {
        "text": "Onglet Création de graphique, Ajouter un élément de graphique, Légende, Aucune.",
        "showTarget": true
      },
      "feedback": "Le tracé gagne la place libérée. Mais avec quatre séries, plus personne ne sait quelle couleur est quel trimestre : ici, la légende était utile."
    },
    {
      "id": "M17-L04-03",
      "consigne": "==Réaffichez-la, à **droite** cette fois==.",
      "setup": {
        "chartEdit": {
          "elements": {
            "legende": true
          },
          "legendPosition": "droite"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-legende-droite"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Légende, Droite.",
        "showTarget": true
      },
      "feedback": "À droite, la légende suit l'ordre vertical des séries. En bas, elle économise la largeur. Les deux se défendent."
    },
    {
      "id": "M17-L04-04",
      "consigne": "==Masquez le **quadrillage**== : ces lignes horizontales aident à lire une valeur, mais elles chargent le fond.",
      "setup": {
        "chartEdit": {
          "elements": {
            "quadrillage": false
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-quadrillage"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Quadrillage.",
        "showTarget": true
      }
    },
    {
      "id": "M17-L04-05",
      "consigne": "Sans quadrillage, il faut une autre façon de lire les valeurs. ==Affichez les **étiquettes de données**==.",
      "setup": {
        "chartEdit": {
          "elements": {
            "etiquettes": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-etiquettes"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Étiquettes de données.",
        "showTarget": true
      },
      "feedback": "Quadrillage **ou** étiquettes, jamais les deux : ils répondent à la même question et se gênent."
    },
    {
      "id": "M17-L04-06",
      "consigne": "==Sélectionnez la **série T2**==, la deuxième barre de chaque groupe.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:1"
      },
      "aide": {
        "text": "Une barre de la deuxième couleur, dans n'importe quel groupe.",
        "showTarget": true
      },
      "feedback": "Les quatre barres de T2 sont sélectionnées d'un coup : c'est la série entière."
    },
    {
      "id": "M17-L04-07",
      "consigne": "Un second clic descend d'un cran. ==Sélectionnez le seul **point T2 de la région Ouest**==, le dernier groupe.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "point:1:3"
      },
      "aide": {
        "text": "Dans le groupe Ouest, la barre de la deuxième couleur.",
        "showTarget": true
      },
      "feedback": "Un point isolé se met en forme à part. C'est ainsi qu'on souligne un mois exceptionnel sans repeindre tout le graphique."
    },
    {
      "id": "M17-L04-08",
      "consigne": "Dernier élément utile : ==affichez les **titres des axes**==. Un axe sans unité laisse deviner, et on devine toujours mal.",
      "setup": {
        "chartEdit": {
          "elements": {
            "titresAxes": true
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-titres-axes"
      },
      "aide": {
        "text": "Ajouter un élément de graphique, Titres des axes.",
        "showTarget": true
      },
      "feedback": "« Euros », « milliers d'euros », « heures » : c'est ce qui évite la question en réunion."
    },
    {
      "id": "M17-L04-09",
      "consigne": "La règle de dosage : gardez le **titre**, gardez les **libellés d'axe**, gardez la **légende dès deux séries**. Le reste se justifie ou se retire. Un graphique surchargé ne se lit pas plus vite qu'un tableau.",
      "action": {
        "type": "READ"
      },
      "points": 0
    }
  ]
}
