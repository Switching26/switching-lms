  "steps": [
    {
      "id": "M18-E01-01",
      "consigne": "Commencez par une base : créez un **histogramme** des **stagiaires** par site, titres de colonnes compris. Des barres verticales doivent apparaître, une par site.",
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "type": "histogramme",
          "categories": "A2:A6",
          "seriesCount": 1,
          "series": [
            {
              "name": "Stagiaires"
            }
          ]
        }
      },
      "aide": {
        "text": "Sélectionnez A1:B6, puis l'histogramme de l'onglet Insertion."
      }
    },
    {
      "id": "M18-E01-02",
      "consigne": "Ajoutez la colonne **Satisfaction** comme deuxième série — elle est en colonne D, à deux colonnes de là. Une deuxième couleur rejoint le tracé et la légende.",
      "setup": {
        "chartEdit": {
          "source": "A1:D6",
          "addSeries": [
            {
              "name": "Satisfaction",
              "values": "D2:D6"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 2,
          "series": [
            {
              "name": "Stagiaires"
            },
            {
              "name": "Satisfaction",
              "values": "D2:D6"
            }
          ]
        }
      },
      "aide": {
        "text": "Sélectionner des données, Ajouter, plage D2:D6."
      },
      "feedback": "Des effectifs et des pourcentages sur le même axe : à corriger tout de suite."
    },
    {
      "id": "M18-E01-03",
      "consigne": "Sélectionnez la série **Stagiaires**, celle qui doit partir. Toutes ses barres s'entourent d'un coup.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:0"
      },
      "aide": {
        "text": "Une barre de la première couleur."
      }
    },
    {
      "id": "M18-E01-04",
      "consigne": "Retirez-la du graphique. Il ne doit rester que la **satisfaction**, avec les noms de sites en abscisse. Il ne doit rester qu'une seule couleur, avec les noms de sites en abscisse.",
      "setup": {
        "chartEdit": {
          "removeSeries": [
            "Stagiaires"
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 1,
          "series": [
            {
              "name": "Satisfaction",
              "values": "D2:D6"
            }
          ]
        }
      },
      "aide": {
        "text": "Sélectionner des données puis Supprimer, ou la touche Suppr sur la série sélectionnée."
      },
      "feedback": "Le graphique porte maintenant sur les colonnes **A** et **D**, qui ne se touchent pas."
    },
    {
      "id": "M18-E01-05",
      "consigne": "Titrez-le **Satisfaction par site** et affichez les **étiquettes de données**.",
      "setup": {
        "chartEdit": {
          "title": "Satisfaction par site",
          "elements": {
            "etiquettes": true,
            "quadrillage": false
          }
        }
      },
