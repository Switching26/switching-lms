          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 2,
          "series": [
            {
              "name": "Formations courtes"
            },
            {
              "name": "Formations longues",
              "values": "C2:C7"
            }
          ]
        }
      },
      "aide": {
        "text": "Onglet Création de graphique, Sélectionner des données, Ajouter."
      }
    },
    {
      "id": "M18-E02-02",
      "consigne": "Ajoutez aussi les **Certifications**.",
      "setup": {
        "chartEdit": {
          "source": "A1:D7",
          "addSeries": [
            {
              "name": "Certifications",
              "values": "D2:D7"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 3,
          "series": [
            {
              "name": "Formations courtes"
            },
            {
              "name": "Formations longues"
            },
            {
              "name": "Certifications",
              "values": "D2:D7"
            }
          ]
        }
      },
      "aide": {
        "text": "Même bouton, Ajouter, plage D2:D7."
      }
    },
    {
      "id": "M18-E02-03",
      "consigne": "Le comité de direction ne veut que les formations. Sélectionnez la série **Certifications**.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:2"
      },
      "aide": {
        "text": "Une barre de la troisième couleur."
      }
    },
    {
      "id": "M18-E02-04",
      "consigne": "Supprimez-la du graphique.",
      "setup": {
        "chartEdit": {
          "removeSeries": [
            "Certifications"
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 2,
          "series": [
            {
              "name": "Formations courtes"
            },
            {
              "name": "Formations longues"
            }
          ]
        }
      },
      "aide": {
        "text": "Sélectionner des données puis Supprimer, ou Suppr sur la série sélectionnée."
      }
    },
    {
      "id": "M18-E02-05",
      "consigne": "Finalement, les **formations longues** sont confidentielles jusqu'au conseil. **Masquez-les sans les supprimer.**",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Formations longues",
              "hidden": true
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 1,
          "series": [
            {
              "name": "Formations courtes",
              "hidden": false
            },
            {
              "name": "Formations longues",
              "hidden": true
            }
          ]
        }
      },
      "aide": {
        "text": "Le filtre de séries du graphique, en décochant la série."
      },
      "feedback": "Masquer se défait en un clic ; supprimer obligerait à tout refaire."
    }
  ]
