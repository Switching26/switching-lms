  "steps": [
    {
      "id": "M18-E02-01",
      "consigne": "Ajoutez la série **Formations longues** au graphique.",
      "setup": {
        "chartEdit": {
          "source": "A1:C7",
          "addSeries": [
            {
              "name": "Formations longues",
              "values": "C2:C7"
