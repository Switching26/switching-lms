  "steps": [
    {
      "id": "M18-E03-01",
      "consigne": "Sélectionnez la série **Certifications**. Des poignées apparaissent sur chacune de ses barres.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:2"
      },
      "aide": {
        "text": "Une barre de la troisième couleur."
      }
    },
    {
      "id": "M18-E03-02",
      "consigne": "Donnez-lui la seule couleur vive du graphique : un **ocre**. Ses barres prennent aussitôt la teinte vive.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Certifications",
              "color": "#c26a2b"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "series": [
            {
              "name": "Formations courtes"
            },
            {
              "name": "Formations longues"
            },
            {
              "name": "Certifications",
              "color": "#c26a2b"
            }
          ]
        }
      },
      "aide": {
        "text": "Onglet Mise en forme, Remplissage de la forme. Le clic droit sur la série y mène aussi."
      }
    },
    {
      "id": "M18-E03-03",
      "consigne": "Sélectionnez la série **Formations courtes**. La sélection passe à l'autre série.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:0"
      },
      "aide": {
        "text": "Une barre de la première couleur."
      }
    },
    {
      "id": "M18-E03-04",
      "consigne": "Passez-la en **bleu ardoise** : présente, mais discrète. Ses barres s'assombrissent en bleu.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Formations courtes",
              "color": "#4c5f75"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "series": [
            {
              "name": "Formations courtes",
              "color": "#4c5f75"
            }
          ]
        }
      },
      "aide": {
        "text": "Onglet Mise en forme, Remplissage de la forme."
      }
    },
    {
      "id": "M18-E03-05",
      "consigne": "Sélectionnez la série **Formations longues**, puis passez-la en **gris clair**. Ses barres se sélectionnent à leur tour.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:1"
      },
      "aide": {
        "text": "Une barre de la deuxième couleur."
      }
    },
    {
      "id": "M18-E03-06",
      "consigne": "Appliquez ce **gris clair** à la série sélectionnée. Le graphique ne doit plus porter qu'une seule couleur vive.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Formations longues",
              "color": "#8f9aa6"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "series": [
            {
              "name": "Formations courtes",
              "color": "#4c5f75"
            },
            {
              "name": "Formations longues",
              "color": "#8f9aa6"
            },
            {
              "name": "Certifications",
              "color": "#c26a2b"
            }
          ]
        }
      },
      "aide": {
        "text": "Onglet Mise en forme, Remplissage de la forme."
      },
      "feedback": "Deux gris et un accent : l'œil va où vous voulez qu'il aille."
