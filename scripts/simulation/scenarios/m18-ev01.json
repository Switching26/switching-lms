          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 2,
          "series": [
            {
              "name": "Devis envoyés"
            },
            {
              "name": "Devis signés"
            }
          ]
        }
      },
      "points": 2
    },
    {
      "id": "M18-EV01-05",
      "consigne": "Sélectionnez la série **Devis signés**.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:1"
      },
      "points": 1
    },
    {
      "id": "M18-EV01-06",
      "consigne": "C'est le chiffre que la direction regarde : passez cette série en **ocre**.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Devis signés",
              "color": "#c26a2b"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "series": [
            {
              "name": "Devis envoyés"
            },
            {
              "name": "Devis signés",
              "color": "#c26a2b"
            }
          ]
        }
      },
      "points": 2
    },
    {
      "id": "M18-EV01-07",
      "consigne": "Pour la réunion, ne gardez visible que les **devis signés** : masquez l'autre série sans la supprimer.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Devis envoyés",
              "hidden": true
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "seriesCount": 1,
          "series": [
            {
              "name": "Devis envoyés",
              "hidden": true
            },
            {
              "name": "Devis signés",
              "hidden": false
            }
          ]
        }
      },
      "points": 2
    },
    {
      "id": "M18-EV01-08",
      "consigne": "On veut suivre la **progression** des signatures : passez le graphique en **courbes**.",
      "setup": {
        "chartEdit": {
          "type": "courbes"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-modifier-type"
      },
      "points": 1
    },
    {
      "id": "M18-EV01-09",
      "consigne": "Montrez le mouvement de fond : ajoutez à la série visible la **courbe de tendance linéaire**.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Devis signés",
              "trendline": "lineaire"
            }
          ]
        }
      },
      "action": {
        "type": "EXPECT_CHART",
        "chart": {
          "series": [
            {
              "name": "Devis envoyés"
            },
            {
              "name": "Devis signés",
              "trendline": "lineaire"
            }
          ]
        }
      },
      "points": 2
    },
    {
      "id": "M18-EV01-10",
      "consigne": "Affichez les **étiquettes de données** et masquez le **quadrillage**.",
      "setup": {
        "chartEdit": {
          "elements": {
            "etiquettes": true,
            "quadrillage": false
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-etiquettes"
      },
      "points": 1
    },
    {
      "id": "M18-EV01-11",
      "consigne": "Terminez en titrant le graphique **Devis signés du semestre**.",
