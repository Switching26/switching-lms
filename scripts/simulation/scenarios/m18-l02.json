  "steps": [
    {
      "id": "M18-L02-01",
      "consigne": "Le graphique ne montre que la **bureautique**. ==Cliquez sur **Sélectionner les données** et ajoutez la série **Langues**==, colonne C.",
      "setup": {
        "chartEdit": {
          "source": "A1:C7",
          "addSeries": [
            {
              "name": "Langues",
              "values": "C2:C7"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-selectionner-donnees"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Données : bouton « Sélectionner les données ».",
        "showTarget": true
      },
      "feedback": "Deux séries, deux couleurs, et la légende devient enfin utile."
    },
    {
      "id": "M18-L02-02",
      "consigne": "==Ajoutez de la même façon la série **Infographie**==, colonne D.",
      "setup": {
        "chartEdit": {
          "source": "A1:D7",
          "addSeries": [
            {
              "name": "Infographie",
              "values": "D2:D7"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-selectionner-donnees"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Données : bouton « Sélectionner les données ».",
        "showTarget": true
      },
      "feedback": "Trois séries : c'est à peu près la limite lisible d'un histogramme groupé sur six mois."
    },
    {
      "id": "M18-L02-03",
      "consigne": "==Sélectionnez la série **Langues**== dans le graphique.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:1"
      },
      "aide": {
        "text": "Une barre de la deuxième couleur, dans n'importe quel groupe.",
        "showTarget": true
      }
    },
    {
      "id": "M18-L02-04",
      "consigne": "==Supprimez-la du graphique.==",
      "setup": {
        "chartEdit": {
          "removeSeries": [
            "Langues"
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-supprimer-serie"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Données : bouton « Supprimer une série ». La touche Suppr sur la série sélectionnée fait la même chose.",
        "showTarget": true
      },
      "feedback": "La colonne C est intacte dans la feuille. Un graphique ne détient pas les données, il les regarde."
    },
    {
      "id": "M18-L02-05",
      "consigne": "Finalement, on la veut. ==Rajoutez la série **Langues**==.",
      "setup": {
        "chartEdit": {
          "addSeries": [
            {
              "name": "Langues",
              "values": "C2:C7"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-selectionner-donnees"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Données : bouton « Sélectionner les données ».",
        "showTarget": true
      },
      "feedback": "Elle revient **en dernière position**, donc avec la troisième couleur. L'ordre des séries est celui de leur ajout, pas celui des colonnes."
    },
    {
      "id": "M18-L02-06",
      "consigne": "Autre besoin : cacher une série pour une réunion, sans la perdre. ==Masquez **Infographie**== avec le filtre de séries.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Infographie",
              "hidden": true
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-filtre-serie"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Données : bouton « Filtrer une série ». Le graphique garde la série, il cesse seulement de la dessiner.",
        "showTarget": true
      },
      "feedback": "La série n'est plus dessinée mais elle reste dans le graphique — l'axe et la légende s'ajustent."
    },
    {
      "id": "M18-L02-07",
      "consigne": "==Réaffichez-la== pour vérifier qu'elle n'avait pas disparu.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Infographie",
              "hidden": false
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-filtre-serie"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Données : bouton « Filtrer une série ». Le même bouton la fait revenir.",
        "showTarget": true
      },
      "feedback": "Elle retrouve sa place et sa couleur : rien n'avait été perdu."
    },
    {
      "id": "M18-L02-08",
      "consigne": "La distinction à garder : **supprimer** retire la série du graphique et l'ordre des suivantes change ; **masquer** la laisse en place et permet de revenir en un clic. Pour une confidentialité passagère, masquez.",
      "action": {
        "type": "READ"
      },
      "points": 0
    }
  ]
