  "steps": [
    {
      "id": "M18-L05-01",
      "consigne": "La forme s'applique à une série entière. ==Sélectionnez la série **Effectif**==.",
      "action": {
        "type": "SELECT_CHART_ELEMENT",
        "element": "serie:0"
      },
      "aide": {
        "text": "N'importe laquelle des cinq barres.",
        "showTarget": true
      }
    },
    {
      "id": "M18-L05-02",
      "consigne": "==Donnez à la série la forme **cylindre**==.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Effectif",
              "shape": "cylindre"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-forme-serie"
      },
      "aide": {
        "text": "Onglet Mise en forme, groupe Série : bouton « Forme de la série ».",
        "showTarget": true
      },
      "feedback": "Le sommet arrondi reste au bon niveau : le cylindre ne fausse pas la lecture."
    },
    {
      "id": "M18-L05-03",
      "consigne": "==Essayez maintenant le **cône**.==",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Effectif",
              "shape": "cone"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-forme-serie"
      },
      "aide": {
        "text": "Onglet Mise en forme, groupe Série : bouton « Forme de la série ».",
        "showTarget": true
      },
      "feedback": "Comparez **Formation** (26) et **Commercial** (14) : le cône rétrécit vers le haut, la surface colorée n'est plus proportionnelle à la valeur. L'écart paraît plus grand qu'il ne l'est."
    },
    {
      "id": "M18-L05-04",
      "consigne": "==Revenez à la **barre** pleine.== C'est la forme qui compare le plus honnêtement.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Effectif",
              "shape": "barre"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-forme-serie"
      },
      "aide": {
        "text": "Onglet Mise en forme, groupe Série : bouton « Forme de la série ».",
        "showTarget": true
      }
    },
    {
      "id": "M18-L05-05",
      "consigne": "==Appliquez un remplissage **bleu ardoise**== à la série.",
      "setup": {
        "chartEdit": {
          "editSeries": [
            {
              "name": "Effectif",
              "color": "#4c5f75"
            }
          ]
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-couleur-serie"
      },
      "aide": {
        "text": "Onglet Mise en forme, groupe Série : bouton « Couleur de la série ».",
        "showTarget": true
      }
    },
    {
      "id": "M18-L05-06",
      "consigne": "==Affichez les **étiquettes de données**==, et le graphique est prêt.",
      "setup": {
        "chartEdit": {
          "elements": {
            "etiquettes": true,
            "quadrillage": false
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-graph-element-etiquettes"
      },
      "aide": {
        "text": "Onglet Création de graphique, groupe Éléments du graphique : bouton « Étiquettes ».",
        "showTarget": true
      }
    },
    {
      "id": "M18-L05-07",
      "consigne": "La règle : la forme est **décorative**, la hauteur porte l'information. Cylindre acceptable, cône à réserver aux graphiques d'illustration, et jamais dans un document où l'on compare des chiffres.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "B2:B6",
          "texte": "La forme est DÉCORATIVE : c'est la hauteur qui porte l'information"
        },
        {
          "type": "MONTRER",
          "cible": "ctrl:ins-graph-forme-serie",
          "texte": "Cylindre acceptable, cône à réserver aux graphiques d'illustration"
        },
        {
          "type": "MONTRER",
          "cible": "B4",
          "texte": "Jamais dans un document où l'on compare des chiffres"
        }
      ]
    }
  ]
