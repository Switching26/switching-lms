  "steps": [
    {
      "id": "M19-E01-01",
      "consigne": "Classez les ventes **du plus petit au plus grand montant**.",
      "setup": {
        "selection": "D3",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A2:D8",
        "column": "D",
        "ascending": true
      },
      "aide": {
        "text": "Sélectionnez une cellule de la colonne Montant, puis le bouton de tri croissant."
      },
      "feedback": "Girard en tête avec 640 €."
    },
    {
      "id": "M19-E01-02",
      "consigne": "En **F2**, posez un total qui **suivra les filtres** que vous poserez ensuite.",
      "setup": {
        "selection": "F2",
        "cells": {
          "F1": {
            "v": "Total visible",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "F2",
        "accept": [
          "=SOUS.TOTAL(9;D2:D8)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La fonction qui ignore les lignes masquées, avec le code 9 pour une somme."
      },
      "feedback": "9 120 € pour l'instant."
    },
    {
      "id": "M19-E01-03",
      "consigne": "Activez les **filtres** sur le tableau. Des petites flèches apparaissent sur chaque en-tête de colonne.",
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-filtrer"
      },
      "aide": {
        "text": "Bouton Filtrer, onglet Données."
      }
    },
    {
      "id": "M19-E01-04",
      "consigne": "N'affichez que les ventes de **Formation**.",
      "action": {
        "type": "FILTER_COLUMN",
        "column": "C",
        "values": [
          "Formation"
        ]
      },
      "aide": {
        "text": "Bouton de filtre de la colonne Produit, ne garder que Formation."
      },
      "feedback": "Trois lignes, et votre total en F2 doit maintenant afficher 4 200 €."
    },
    {
      "id": "M19-E01-05",
      "consigne": "Ajoutez un second critère : parmi ces formations, ne gardez que les régions **Nord** et **Ouest**.",
      "action": {
        "type": "FILTER_COLUMN",
        "column": "B",
        "values": [
          "Nord",
          "Ouest"
        ]
      },
      "aide": {
        "text": "Bouton de filtre de la colonne Région, cochez Nord et Ouest."
      },
      "feedback": "Deux lignes visibles, total 2 450 €."
    },
    {
      "id": "M19-E01-06",
      "consigne": "Rendez le tableau complet à l'écran. Toutes les lignes doivent revenir, et la numérotation redevenir continue.",
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-effacer-filtre"
      },
      "aide": {
        "text": "Le bouton Effacer du groupe Trier et filtrer."
      },
      "feedback": "Tout est réaffiché et le total revient à 9 120 €. Vous maîtrisez la séquence tri / filtre / total visible."
