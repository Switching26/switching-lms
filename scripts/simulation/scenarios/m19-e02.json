        "selection": "H1"
      },
      "action": {
        "type": "TYPE",
        "target": "H1",
        "accept": [
          "=SOMME(E2:E11)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur la colonne Montant, de la ligne 2 à la ligne 11."
      },
      "feedback": "11 280 € au total."
    },
    {
      "id": "M19-E02-07",
      "consigne": "En **H2**, comptez les interventions.",
