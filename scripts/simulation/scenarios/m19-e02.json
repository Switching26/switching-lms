      }
    },
    {
      "id": "M19-E02-04",
      "consigne": "Classez les interventions par **secteur**, et dans chaque secteur **du montant le plus élevé au plus faible**. Appliquez le premier des deux tris.",
      "setup": {
        "selection": "E6",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A2:E11",
        "column": "E",
        "ascending": false
      },
      "aide": {
        "text": "On commence toujours par le critère le moins important."
      }
    },
    {
      "id": "M19-E02-05",
      "consigne": "Appliquez maintenant le second tri.",
      "setup": {
        "selection": "B6"
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A2:E11",
        "column": "B",
        "ascending": true
      },
      "aide": {
        "text": "Le critère principal passe en dernier."
      }
    },
    {
      "id": "M19-E02-06",
      "consigne": "En **H1**, calculez le montant total des interventions.",
