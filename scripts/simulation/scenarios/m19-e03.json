  "steps": [
    {
      "id": "M19-E03-01",
      "consigne": "Activez les **filtres** sur le tableau. Chaque en-tête reçoit sa flèche de filtre.",
      "setup": {
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-filtrer"
      },
      "aide": {
        "text": "Onglet Données, bouton Filtrer."
      }
    },
    {
      "id": "M19-E03-02",
      "consigne": "N'affichez que les **installations**.",
      "action": {
        "type": "FILTER_COLUMN",
        "column": "C",
        "values": [
          "Installation"
        ]
      },
      "aide": {
        "text": "Le filtre de la colonne Prestation."
      }
    },
    {
      "id": "M19-E03-03",
      "consigne": "Parmi elles, ne gardez que le secteur **Normandie**.",
      "action": {
        "type": "FILTER_COLUMN",
        "column": "B",
        "values": [
          "Normandie"
        ]
      },
      "aide": {
        "text": "Le filtre de la colonne Secteur, en gardant le précédent."
      }
    },
    {
      "id": "M19-E03-04",
      "consigne": "En **H1**, comptez ces interventions par formule, sans dépendre du filtre.",
      "setup": {
        "selection": "H1"
      },
      "action": {
        "type": "TYPE",
        "target": "H1",
        "accept": [
          "=NB.SI.ENS($C$2:$C$11;\"Installation\";$B$2:$B$11;\"Normandie\")",
          "=NB.SI.ENS(C2:C11;\"Installation\";B2:B11;\"Normandie\")",
          "=NB.SI.ENS($B$2:$B$11;\"Normandie\";$C$2:$C$11;\"Installation\")",
          "=NB.SI.ENS(B2:B11;\"Normandie\";C2:C11;\"Installation\")",
          "=SOMMEPROD(($C$2:$C$11=\"Installation\")*($B$2:$B$11=\"Normandie\"))",
          "=SOMMEPROD((C2:C11=\"Installation\")*(B2:B11=\"Normandie\"))"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Deux paires plage/critère."
      },
      "feedback": "3 interventions."
    },
    {
      "id": "M19-E03-05",
      "consigne": "En **H2**, leur montant total.",
      "setup": {
        "selection": "H2"
      },
      "action": {
        "type": "TYPE",
        "target": "H2",
        "accept": [
          "=SOMME.SI.ENS($E$2:$E$11;$C$2:$C$11;\"Installation\";$B$2:$B$11;\"Normandie\")",
          "=SOMME.SI.ENS(E2:E11;C2:C11;\"Installation\";B2:B11;\"Normandie\")",
          "=SOMME.SI.ENS($E$2:$E$11;$B$2:$B$11;\"Normandie\";$C$2:$C$11;\"Installation\")",
          "=SOMME.SI.ENS(E2:E11;B2:B11;\"Normandie\";C2:C11;\"Installation\")",
          "=SOMMEPROD(($C$2:$C$11=\"Installation\")*($B$2:$B$11=\"Normandie\")*$E$2:$E$11)",
          "=SOMMEPROD((C2:C11=\"Installation\")*(B2:B11=\"Normandie\")*E2:E11)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La plage à additionner en premier argument."
      },
      "feedback": "3 640 €."
    },
    {
      "id": "M19-E03-06",
      "consigne": "Rendez le tableau complet à l'écran. Toutes les lignes reviennent, et la numérotation redevient continue.",
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-effacer-filtre"
      },
      "aide": {
        "text": "Bouton Effacer."
      }
    },
    {
      "id": "M19-E03-07",
      "consigne": "En **H3**, calculez le montant réalisé **hors Normandie** : Bretagne et Occitanie réunies.",
      "setup": {
        "selection": "H3"
      },
      "action": {
        "type": "TYPE",
        "target": "H3",
        "accept": [
          "=SOMME.SI($B$2:$B$11;\"Bretagne\";$E$2:$E$11)+SOMME.SI($B$2:$B$11;\"Occitanie\";$E$2:$E$11)",
          "=SOMME.SI(B2:B11;\"Bretagne\";E2:E11)+SOMME.SI(B2:B11;\"Occitanie\";E2:E11)",
          "=SOMME.SI($B$2:$B$11;\"Occitanie\";$E$2:$E$11)+SOMME.SI($B$2:$B$11;\"Bretagne\";$E$2:$E$11)",
          "=SOMME.SI(B2:B11;\"Occitanie\";E2:E11)+SOMME.SI(B2:B11;\"Bretagne\";E2:E11)",
          "=SOMME($E$2:$E$11)-SOMME.SI($B$2:$B$11;\"Normandie\";$E$2:$E$11)",
          "=SOMME(E2:E11)-SOMME.SI(B2:B11;\"Normandie\";E2:E11)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Un OU se traduit par une addition de SOMME.SI — ou par une soustraction au total."
      },
      "feedback": "7 160 €. Les deux chemins, addition des deux secteurs ou total moins la Normandie, donnent le même résultat."
    }
  ]
}
