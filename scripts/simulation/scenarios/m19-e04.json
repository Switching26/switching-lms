  "steps": [
    {
      "id": "M19-E04-01",
      "consigne": "Préparez le terrain : les lignes d'un même secteur doivent se suivre.",
      "setup": {
        "selection": "B5",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A2:E11",
        "column": "B",
        "ascending": true
      },
      "aide": {
        "text": "Un tri croissant sur la colonne Secteur."
      }
    },
    {
      "id": "M19-E04-02",
      "consigne": "En **H2**, calculez le sous-total du premier secteur, avec une formule recopiable vers le bas.",
      "setup": {
        "selection": "H2"
      },
      "action": {
        "type": "TYPE",
        "target": "H2",
        "accept": [
          "=SOMME.SI($B$2:$B$11;G2;$E$2:$E$11)",
          "=SOMME.SI(B2:B11;G2;E2:E11)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "SOMME.SI, plages figées et critère pris dans la colonne G."
      },
      "feedback": "4 120 € pour la Normandie."
    },
    {
      "id": "M19-E04-03",
      "consigne": "Complétez les deux autres secteurs.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "H3": {
            "anyOf": [
              "=SOMME.SI($B$2:$B$11;G3;$E$2:$E$11)",
              "=SOMME.SI(B2:B11;G3;E2:E11)"
            ],
            "v": 3660
          },
          "H4": {
            "anyOf": [
              "=SOMME.SI($B$2:$B$11;G4;$E$2:$E$11)",
              "=SOMME.SI(B2:B11;G4;E2:E11)"
            ],
            "v": 3500
          }
        }
      },
      "aide": {
        "text": "Recopiez H2 vers le bas."
      }
    },
    {
      "id": "M19-E04-04",
      "consigne": "En **H6**, additionnez les sous-totaux.",
      "setup": {
        "selection": "H6"
      },
      "action": {
        "type": "TYPE",
        "target": "H6",
        "accept": [
          "=SOMME(H2:H4)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur les trois sous-totaux, H2 à H4."
      },
      "feedback": "11 280 €."
    },
    {
      "id": "M19-E04-05",
      "consigne": "En **H7**, posez le contrôle : le total de la colonne Montant.",
      "setup": {
        "selection": "H7"
      },
      "action": {
        "type": "TYPE",
        "target": "H7",
        "accept": [
          "=SOMME(E2:E11)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Si les deux cellules diffèrent, un secteur manque à la synthèse."
      },
      "feedback": "11 280 € : la synthèse couvre bien toute la liste."
    },
    {
      "id": "M19-E04-06",
      "consigne": "En **H8**, comptez les interventions du secteur **Normandie**.",
      "setup": {
        "selection": "H8"
      },
      "action": {
        "type": "TYPE",
        "target": "H8",
        "accept": [
          "=NB.SI($B$2:$B$11;\"Normandie\")",
          "=NB.SI(B2:B11;\"Normandie\")",
          "=NB.SI($B$2:$B$11;G2)",
          "=NB.SI(B2:B11;G2)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NB.SI sur la colonne Secteur."
      },
      "feedback": "4 interventions."
    }
