  "steps": [
    {
      "id": "M20-E01-01",
      "consigne": "Posez en **H3** un tableau croisé qui donne le **montant vendu par famille de produit**.",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "insertion"
        },
        "pivot": {
          "source": "A1:F31",
          "target": "H3",
          "rows": [
            {
              "name": "Famille"
            }
          ],
          "values": [
            {
              "name": "Montant",
              "agg": "somme"
            }
          ]
        }
      },
      "aide": {
        "text": "Famille en Lignes, Montant en Valeurs."
      },
      "action": {
        "type": "EXPECT_PIVOT",
        "pivot": {
          "source": "A1:F31",
          "target": "H3",
          "rows": [
            "Famille"
          ],
          "values": [
            {
              "name": "Montant",
              "agg": "somme"
            }
          ],
          "cells": {
            "I5": {
              "v": 35950
            },
            "I7": {
              "v": 75870
            }
          }
        }
      },
      "feedback": "75 870 € au total, répartis sur trois familles."
    },
    {
      "id": "M20-E01-02",
      "consigne": "Détaillez ces familles **par trimestre**, en colonnes.",
      "setup": {
        "pivotEdit": {
          "addCols": [
            {
              "name": "Trimestre"
            }
          ]
        }
      },
      "aide": {
        "text": "Trimestre va dans la zone Colonnes."
      },
      "action": {
        "type": "EXPECT_PIVOT",
        "pivot": {
          "rows": [
            "Famille"
          ],
          "cols": [
            "Trimestre"
          ],
          "cells": {
            "J6": {
              "v": 11350
            },
            "M7": {
              "v": 19140
            },
            "K8": {
              "v": 19360
            }
          }
        }
      },
      "feedback": "Le détail par trimestre apparaît, avec le total de chaque famille au bout de sa ligne."
    },
    {
      "id": "M20-E01-03",
      "consigne": "Revenez à un tableau **sans colonnes** : retirez le trimestre.",
      "setup": {
        "pivotEdit": {
          "removeFields": [
            "Trimestre"
          ]
        }
      },
      "aide": {
        "text": "Sortez Trimestre de la zone Colonnes."
      },
      "action": {
        "type": "EXPECT_PIVOT",
        "pivot": {
          "cols": [],
          "cells": {
            "I4": {
              "v": 20780
            }
          }
        }
      },
      "feedback": "Retour à une seule colonne de valeurs."
    },
    {
      "id": "M20-E01-04",
      "consigne": "Ajoutez le **nombre d'articles vendus** à côté des montants.",
      "setup": {
        "pivotEdit": {
          "addValues": [
            {
              "name": "Quantité",
              "agg": "somme"
            }
          ]
        }
      },
      "aide": {
        "text": "Quantité rejoint Montant dans la zone Valeurs : deux colonnes de calcul."
      },
      "action": {
        "type": "EXPECT_PIVOT",
        "pivot": {
          "values": [
            {
              "name": "Montant",
              "agg": "somme"
            },
            {
              "name": "Quantité",
              "agg": "somme"
            }
          ],
          "cells": {
            "I5": {
              "v": 35950
            },
            "J5": {
              "v": 26
            },
            "J7": {
              "v": 140
            }
          }
        }
      },
      "feedback": "Montants et quantités côte à côte."
    },
    {
      "id": "M20-E01-05",
      "consigne": "Cette seconde colonne serait plus parlante en **nombre de ventes** qu'en total d'articles : changez son calcul.",
      "setup": {
        "pivotEdit": {
          "addValues": [
            {
              "name": "Quantité",
              "agg": "nombre"
            }
          ]
        }
      },
      "aide": {
        "text": "Paramètres des champs de valeurs, sur le champ Quantité : choisissez Nombre."
      },
      "action": {
        "type": "EXPECT_PIVOT",
        "pivot": {
          "values": [
            {
              "name": "Montant",
              "agg": "somme"
            },
            {
              "name": "Quantité",
              "agg": "nombre"
            }
          ],
          "cells": {
            "J4": {
              "v": 11
            },
            "J7": {
              "v": 30
            }
          }
        }
      },
      "feedback": "30 ventes en tout : le calcul Nombre compte les lignes, pas les articles."
    },
    {
      "id": "M20-E01-06",
      "consigne": "Enfin, n'affichez plus que les ventes de la région **Sud**, sans toucher aux zones Lignes et Colonnes.",
      "setup": {
        "pivotEdit": {
          "addFilters": [
            {
              "name": "Région"
            }
          ],
          "filterValues": {
            "Région": [
              "Sud"
            ]
          }
        }
      },
      "aide": {
        "text": "Région se dépose dans la zone Filtres ; on choisit ensuite Sud dans la liste."
      },
      "action": {
        "type": "EXPECT_PIVOT",
        "pivot": {
          "filters": [
            "Région"
          ],
          "rows": [
            "Famille"
          ],
          "cells": {
            "I7": {
              "v": 8120
            },
            "I9": {
              "v": 20480
            },
            "J9": {
              "v": 8
            }
          }
        }
      },
      "feedback": "Le rapport entier est passé sous condition : 20 480 € pour le Sud."
    }
  ]
