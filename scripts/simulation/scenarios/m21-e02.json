  "steps": [
    {
      "id": "M21-E02-01",
      "consigne": "Signalez visuellement la zone que les gestionnaires devront remplir : les volumes horaires, en **C4:C7**.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "C4": {
            "background": "#fde68a"
          },
          "C7": {
            "background": "#fde68a"
          }
        }
      },
      "aide": {
        "text": "Le bouton Remplissage de l'onglet Accueil."
      }
    },
    {
      "id": "M21-E02-02",
      "consigne": "Le statut ne doit accepter que trois valeurs : `Salarié`, `Demandeur d'emploi`, `Indépendant`. Posez la contrainte.",
      "setup": {
        "selection": "B4:B7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "B4:B7",
          "rule": {
            "kind": "list",
            "values": [
              "Salarié",
              "Demandeur d'emploi",
              "Indépendant"
            ],
            "errorMessage": "Choisissez un statut dans la liste."
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-validation"
      },
      "aide": {
        "text": "Bouton Validation, type Liste."
      }
    },
    {
      "id": "M21-E02-03",
      "consigne": "Renseignez le statut de Julie Bertrand : **Salarié**.",
      "setup": {
        "selection": "B4"
      },
      "action": {
        "type": "TYPE",
        "target": "B4",
        "accept": [
          "Salarié"
        ]
      },
      "aide": {
        "text": "Choisissez-le dans la liste déroulante."
      }
    },
    {
      "id": "M21-E02-04",
      "consigne": "Le volume horaire doit rester compris entre 7 et 40 heures. Posez la contrainte sur **C4:C7**.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
            "kind": "numberBetween",
            "min": 7,
            "max": 40,
            "errorMessage": "Le volume doit être compris entre 7 et 40 heures."
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-validation"
      },
      "aide": {
        "text": "Bouton Validation, règle « nombre entre »."
      }
    },
    {
      "id": "M21-E02-05",
      "consigne": "En **E4**, calculez le montant dû par le premier stagiaire.",
      "setup": {
        "selection": "E4"
      },
      "action": {
        "type": "TYPE",
        "target": "E4",
        "accept": [
          "=C4*D4",
          "=D4*C4"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Heures × tarif horaire."
      },
      "feedback": "945 €."
    },
    {
      "id": "M21-E02-06",
      "consigne": "Complétez la colonne jusqu'en **E7**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "E5": {
            "anyOf": [
              "=C5*D5",
              "=D5*C5"
            ],
            "v": 1575
          },
          "E6": {
            "anyOf": [
              "=C6*D6",
