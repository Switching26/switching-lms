              "=D7*C7"
            ],
            "v": 1456
          }
        }
      },
      "aide": {
        "text": "Recopiez E4 vers le bas."
      }
    },
    {
      "id": "M21-E02-07",
      "consigne": "En **E9**, totalisez la session.",
      "setup": {
        "selection": "E9"
      },
      "action": {
        "type": "TYPE",
        "target": "E9",
        "accept": [
          "=SOMME(E4:E7)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur la colonne Total, E4 à E7."
      },
      "feedback": "4 704 €."
    },
    {
      "id": "M21-E02-08",
      "consigne": "En **E10**, comptez les statuts déjà renseignés : la fiche n'est complète que lorsque les quatre le sont.",
      "setup": {
        "selection": "E10"
      },
      "action": {
        "type": "TYPE",
        "target": "E10",
        "accept": [
          "=NBVAL(B4:B7)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NBVAL compte les cellules non vides, texte compris."
      },
      "feedback": "1 sur 4 : la fiche est encore incomplète, et cela se voit d'un coup d'œil."
