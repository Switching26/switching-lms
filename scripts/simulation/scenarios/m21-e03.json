  "steps": [
    {
      "id": "M21-E03-01",
      "consigne": "Contraignez le volume horaire de **C4:C7** : entre 7 et 40 heures, saisie refusée au-delà. Une saisie de 45 doit être refusée.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
            "kind": "numberBetween",
            "min": 7,
            "max": 40,
            "errorMessage": "Le volume doit être compris entre 7 et 40 heures."
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-validation"
      },
      "aide": {
        "text": "Bouton Validation, règle « nombre entre »."
      }
    },
    {
      "id": "M21-E03-02",
      "consigne": "Un stagiaire allonge son parcours : portez ses heures à **35** en **C4**.",
      "setup": {
        "selection": "C4"
      },
      "action": {
        "type": "TYPE",
        "target": "C4",
        "accept": [
          "35"
        ]
      },
      "aide": {
        "text": "La contrainte que vous venez de poser accepte cette valeur."
      },
      "feedback": "Sa ligne passe à 1 575 €."
    },
    {
      "id": "M21-E03-03",
      "consigne": "Simulez maintenant la fausse manœuvre à éviter : écrasez la formule de **E5** par le nombre **1000**.",
      "setup": {
        "selection": "E5"
      },
      "action": {
        "type": "TYPE",
        "target": "E5",
        "accept": [
          "1000"
        ]
      },
      "aide": {
        "text": "Tapez le nombre directement dans la cellule."
      },
      "feedback": "Le total de la session est faux, sans aucun message."
    },
    {
      "id": "M21-E03-04",
      "consigne": "Réparez **E5**.",
      "setup": {
        "selection": "E5"
      },
      "action": {
        "type": "TYPE",
        "target": "E5",
        "accept": [
          "=C5*D5",
          "=D5*C5"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Heures × tarif horaire."
      },
      "feedback": "1 575 €."
    },
    {
      "id": "M21-E03-05",
      "consigne": "La contrainte horaire empêche d'enregistrer un parcours long validé par la direction. Levez-la. La cellule doit de nouveau accepter n'importe quelle durée.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
