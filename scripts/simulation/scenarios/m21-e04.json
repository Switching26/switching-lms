  "steps": [
    {
      "id": "M21-E04-01",
      "consigne": "En **E9**, totalisez la commande hors taxes.",
      "setup": {
        "selection": "E9"
      },
      "action": {
        "type": "TYPE",
        "target": "E9",
        "accept": [
          "=SOMME(E4:E7)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur les quatre totaux de ligne."
      },
      "feedback": "2 776 € HT."
    },
    {
      "id": "M21-E04-02",
      "consigne": "En **E10**, calculez la remise fidélité en prenant son taux sur la feuille **Tarifs**.",
      "setup": {
        "selection": "E10"
      },
      "action": {
        "type": "TYPE",
        "target": "E10",
        "accept": [
          "=E9*Tarifs!$B$4",
          "=E9*Tarifs!B4",
          "=Tarifs!$B$4*E9",
          "=Tarifs!B4*E9"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Référence à une autre feuille : Tarifs!$B$4."
      },
      "feedback": "277,60 € de remise."
    },
    {
      "id": "M21-E04-03",
      "consigne": "En **E11**, la TVA — calculée sur le montant **après** remise.",
      "setup": {
        "selection": "E11"
      },
      "action": {
        "type": "TYPE",
        "target": "E11",
        "accept": [
          "=(E9-E10)*Tarifs!$B$3",
          "=(E9-E10)*Tarifs!B3",
          "=Tarifs!$B$3*(E9-E10)",
          "=Tarifs!B3*(E9-E10)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Hors taxes moins remise, multiplié par le taux."
      },
      "feedback": "499,68 € de TVA sur 2 498,40 € net."
    },
    {
      "id": "M21-E04-04",
      "consigne": "En **E12**, le total à payer.",
      "setup": {
        "selection": "E12"
      },
      "action": {
        "type": "TYPE",
        "target": "E12",
        "accept": [
          "=E9-E10+E11",
          "=(E9-E10)+E11"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Hors taxes, moins la remise, plus la TVA."
      },
      "feedback": "2 998,08 € TTC."
    },
    {
      "id": "M21-E04-05",
      "consigne": "La direction supprime la remise fidélité de cette campagne. Allez la modifier là où elle est définie.",
      "action": {
        "type": "SELECT_SHEET",
        "name": "Tarifs"
      },
      "aide": {
        "text": "La feuille des paramètres."
      }
    },
    {
      "id": "M21-E04-06",
      "consigne": "Ramenez la remise à **0**.",
      "setup": {
        "selection": "B4"
      },
      "action": {
        "type": "TYPE",
        "target": "B4",
        "accept": [
          "0"
        ]
      },
      "aide": {
        "text": "La cellule du taux de remise, sur la feuille des paramètres."
      },
      "feedback": "Toutes les formules qui s'y réfèrent se recalculent."
    },
    {
      "id": "M21-E04-07",
      "consigne": "Revenez sur la commande.",
      "action": {
        "type": "SELECT_SHEET",
        "name": "Commande"
      },
      "aide": {
        "text": "Le second onglet."
      }
    },
    {
      "id": "M21-E04-08",
      "consigne": "En **E13**, contrôlez le taux de TVA réellement appliqué au montant net.",
      "setup": {
        "selection": "E13",
        "cells": {
          "D13": {
            "v": "Taux appliqué",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "E13",
        "accept": [
          "=E11/(E9-E10)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La TVA divisée par le net commercial."
      },
      "feedback": "0,2 : le taux vient bien de la feuille de paramètres, et non d'un chiffre recopié dans la formule."
    }
