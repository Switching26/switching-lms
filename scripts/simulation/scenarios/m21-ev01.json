  "steps": [
    {
      "id": "M21-EV01-01",
      "consigne": "Un devis à finir, un classeur à sécuriser. Vous allez repérer la zone de saisie, la contraindre, poser les calculs, aller chercher un paramètre sur l'autre feuille et vérifier votre travail. **Douze gestes**, sans aide : chaque étape compte au premier essai.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "B3",
          "texte": "Le taux de TVA est un paramètre, sur cette feuille"
        },
        {
          "type": "MONTRER",
          "cible": "B4",
          "texte": "L'acompte à la commande aussi"
        },
        {
          "type": "MONTRER",
          "cible": "dom:[aria-label=\"Feuille Devis\"]",
          "texte": "Le devis à finir est sur l'autre feuille. Aucune aide : chaque étape compte au premier essai"
        }
      ]
    },
    {
      "id": "M21-EV01-02",
      "consigne": "Signalez la zone de saisie du devis : les quantités, en **C4:C7**.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "C4": {
            "background": "#fde68a"
          },
          "C7": {
            "background": "#fde68a"
          }
        }
      },
      "points": 2
    },
    {
      "id": "M21-EV01-03",
      "consigne": "Une quantité doit rester un nombre compris entre 1 et 200, saisie refusée au-delà. Posez la contrainte sur cette même zone.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
            "kind": "numberBetween",
            "min": 1,
            "max": 200,
            "errorMessage": "La quantité doit être comprise entre 1 et 200."
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-validation"
      },
      "points": 2
    },
    {
      "id": "M21-EV01-04",
      "consigne": "Le client double sa commande de chaises : portez leur quantité à **24**.",
      "setup": {
        "selection": "C5"
      },
      "action": {
        "type": "TYPE",
        "target": "C5",
        "accept": [
          "24"
        ]
      },
      "points": 1
    },
    {
      "id": "M21-EV01-05",
      "consigne": "En **E4**, calculez le total de la première ligne.",
      "setup": {
        "selection": "E4"
      },
      "action": {
        "type": "TYPE",
        "target": "E4",
        "accept": [
          "=C4*D4",
          "=D4*C4"
        ],
        "formulaMode": true
      },
      "points": 1
    },
    {
      "id": "M21-EV01-06",
      "consigne": "Complétez les trois autres lignes.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "E5": {
            "anyOf": [
              "=C5*D5",
              "=D5*C5"
            ],
            "v": 1632
          },
          "E6": {
            "anyOf": [
              "=C6*D6",
              "=D6*C6"
            ],
            "v": 240
          },
          "E7": {
            "anyOf": [
              "=C7*D7",
              "=D7*C7"
            ],
            "v": 270
          }
        }
      },
      "points": 2
    },
    {
      "id": "M21-EV01-07",
      "consigne": "En **E9**, totalisez le devis hors taxes.",
      "setup": {
        "selection": "E9"
      },
      "action": {
        "type": "TYPE",
        "target": "E9",
        "accept": [
          "=SOMME(E4:E7)"
        ],
        "formulaMode": true
      },
      "points": 1
    },
    {
      "id": "M21-EV01-08",
      "consigne": "En **E10**, la TVA — en prenant son taux sur la feuille **Taux**, sans l'écrire dans la formule.",
      "setup": {
        "selection": "E10"
      },
      "action": {
        "type": "TYPE",
        "target": "E10",
        "accept": [
          "=E9*Taux!$B$3",
          "=E9*Taux!B3",
          "=Taux!$B$3*E9",
          "=Taux!B3*E9"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M21-EV01-09",
      "consigne": "En **E11**, le total TTC.",
      "setup": {
        "selection": "E11"
      },
      "action": {
        "type": "TYPE",
        "target": "E11",
        "accept": [
          "=E9+E10",
          "=E10+E9",
          "=SOMME(E9:E10)"
        ],
        "formulaMode": true
      },
      "points": 1
    },
    {
      "id": "M21-EV01-10",
      "consigne": "En **E12**, l'acompte à verser à la commande, calculé sur le TTC avec le taux de la feuille **Taux**.",
      "setup": {
        "selection": "E12"
      },
      "action": {
        "type": "TYPE",
        "target": "E12",
        "accept": [
          "=E11*Taux!$B$4",
          "=E11*Taux!B4",
          "=Taux!$B$4*E11",
          "=Taux!B4*E11"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M21-EV01-11",
      "consigne": "En **E13**, posez le contrôle qui révélerait une formule de ligne écrasée : le total recalculé depuis les colonnes Quantité et Prix.",
      "setup": {
        "selection": "E13"
      },
      "action": {
        "type": "TYPE",
        "target": "E13",
        "accept": [
          "=SOMMEPROD(C4:C7;D4:D7)",
          "=SOMMEPROD(D4:D7;C4:C7)"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M21-EV01-12",
      "consigne": "La contrainte de quantité bloque une commande de 400 chaises pourtant validée. Levez-la.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
            "kind": "numberBetween",
            "min": 1,
            "max": 200
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-effacer-validation"
      },
      "points": 2
    },
    {
      "id": "M21-EV01-13",
      "consigne": "Reposez la même contrainte, mais en simple **avertissement**.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
            "kind": "numberBetween",
            "min": 1,
            "max": 200,
            "allowInvalid": true,
            "errorMessage": "Quantité inhabituelle : vérifiez la commande."
          }
        }
      },
      "action": {
