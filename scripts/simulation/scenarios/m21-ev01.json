  "steps": [
    {
      "id": "M21-EV01-01",
      "consigne": "Le **devis 2026-207** a été rempli par un collègue, et le client conteste le montant. Vous devez le remettre d'aplomb, puis empêcher que cela recommence. **Onze gestes**, sans aide, comptés au premier essai.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A4:E7",
          "texte": "Les quatre lignes du devis, déjà saisies"
        },
        {
          "type": "MONTRER",
          "cible": "D9",
          "texte": "Les totaux à établir, sous le tableau"
        },
        {
          "type": "MONTRER",
          "cible": "ecran",
          "texte": "Le taux de TVA vit sur la feuille Taux. Aucune aide"
        }
      ]
    },
    {
      "id": "M21-EV01-02",
      "consigne": "**En E9, totalisez les montants** du devis.",
      "setup": {
        "selection": "E9"
      },
      "action": {
        "type": "TYPE",
        "target": "E9",
        "accept": [
          "=SOMME(E4:E7)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M21-EV01-03",
      "consigne": "**Passez la quantité de la ligne MOB-95 à 2** : c'est ce que le client a commandé, et le devis en annonce 90.",
      "setup": {
        "selection": "C7"
      },
      "action": {
        "type": "TYPE",
        "target": "C7",
        "accept": [
          "2"
        ]
      },
      "points": 2
    },
    {
      "id": "M21-EV01-04",
      "consigne": "Un montant du tableau **n'a pas bougé** alors que sa ligne le devrait. **Rendez-lui son calcul.**",
      "setup": {
        "selection": "E6"
      },
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "E6": {
            "anyOf": [
              "=C6*D6",
              "=D6*C6"
            ],
            "v": 240
          }
        }
      },
      "points": 3
    },
    {
      "id": "M21-EV01-05",
      "consigne": "**En E10, calculez la TVA** : le taux vit sur la feuille **Taux**, il ne se recopie pas.",
      "setup": {
        "selection": "E10"
      },
      "action": {
        "type": "TYPE",
        "target": "E10",
        "accept": [
          "=E9*Taux!$B$3",
          "=E9*Taux!B3",
          "=Taux!$B$3*E9",
          "=Taux!B3*E9"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M21-EV01-06",
      "consigne": "La TVA calculée est **hors de proportion**. Le devis n'y est pour rien : **allez voir la feuille Taux.**",
      "action": {
        "type": "SELECT_SHEET",
        "name": "Taux"
      },
      "points": 2
    },
    {
      "id": "M21-EV01-07",
      "consigne": "**Rétablissez le taux de TVA à 20 %.**",
      "setup": {
        "selection": "B3"
      },
      "action": {
        "type": "TYPE",
        "target": "B3",
        "accept": [
          "0,2",
          "0.2",
          "20%"
        ]
      },
      "points": 3
    },
    {
      "id": "M21-EV01-08",
      "consigne": "Revenez au **devis**.",
      "action": {
        "type": "SELECT_SHEET",
        "name": "Devis"
      },
      "points": 1
    },
    {
      "id": "M21-EV01-09",
      "consigne": "**En E11, calculez le total TTC.**",
      "setup": {
        "selection": "E11"
      },
      "action": {
        "type": "TYPE",
        "target": "E11",
        "accept": [
          "=E9+E10",
          "=E10+E9",
          "=SOMME(E9:E10)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M21-EV01-10",
      "consigne": "Pour que la quantité de 90 ne puisse plus passer : **posez sur les quantités une règle** qui n'accepte que des nombres de 1 à 40.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "donnees"
        },
        "dv": {
          "range": "C4:C7",
          "rule": {
            "kind": "numberBetween",
            "min": 1,
            "max": 40,
            "errorMessage": "La quantité doit être comprise entre 1 et 40."
          }
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "don-validation"
      },
      "points": 3
    },
    {
      "id": "M21-EV01-11",
      "consigne": "Les cellules de saisie ne se distinguent pas des cellules calculées : **donnez un fond aux quantités**, pour qu'on sache où écrire.",
      "setup": {
        "selection": "C4:C7",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "C4": {
            "background": "#fde68a"
          },
          "C7": {
            "background": "#fde68a"
          }
        }
      },
      "points": 2
    },
    {
      "id": "M21-EV01-12",
      "consigne": "Dernier contrôle : **en E13, recalculez le total HT sans passer par la colonne E** — s'il retombe sur E9, le devis est cohérent.",
      "setup": {
        "selection": "E13"
      },
      "action": {
        "type": "TYPE",
        "target": "E13",
        "accept": [
          "=SOMMEPROD(C4:C7;D4:D7)",
          "=SOMMEPROD(D4:D7;C4:C7)"
        ],
        "formulaMode": true
      },
      "points": 3
    }
  ],
