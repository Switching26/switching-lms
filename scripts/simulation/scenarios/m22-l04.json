          "=SOMME.SI(Lyon!$A$2:$A$5;$A2;Lyon!$B$2:$B$5)+SOMME.SI(Strasbourg!$A$2:$A$5;$A2;Strasbourg!$B$2:$B$5)+SOMME.SI(Nantes!$A$2:$A$6;$A2;Nantes!$B$2:$B$6)",
          "=SOMME.SI(Lyon!A2:A5;A2;Lyon!B2:B5)+SOMME.SI(Strasbourg!A2:A5;A2;Strasbourg!B2:B5)+SOMME.SI(Nantes!A2:A6;A2;Nantes!B2:B6)",
          "=SOMME.SI(Nantes!$A$2:$A$6;$A2;Nantes!$B$2:$B$6)+SOMME.SI(Lyon!$A$2:$A$5;$A2;Lyon!$B$2:$B$5)+SOMME.SI(Strasbourg!$A$2:$A$5;$A2;Strasbourg!$B$2:$B$5)",
          "=SOMME.SI(Nantes!A2:A6;A2;Nantes!B2:B6)+SOMME.SI(Lyon!A2:A5;A2;Lyon!B2:B5)+SOMME.SI(Strasbourg!A2:A5;A2;Strasbourg!B2:B5)",
          "=SOMME.SI(Nantes!$A$2:$A$6;$A2;Nantes!$B$2:$B$6)+SOMME.SI(Strasbourg!$A$2:$A$5;$A2;Strasbourg!$B$2:$B$5)+SOMME.SI(Lyon!$A$2:$A$5;$A2;Lyon!$B$2:$B$5)",
          "=SOMME.SI(Nantes!A2:A6;A2;Nantes!B2:B6)+SOMME.SI(Strasbourg!A2:A5;A2;Strasbourg!B2:B5)+SOMME.SI(Lyon!A2:A5;A2;Lyon!B2:B5)",
          "=SOMME.SI(Strasbourg!$A$2:$A$5;$A2;Strasbourg!$B$2:$B$5)+SOMME.SI(Lyon!$A$2:$A$5;$A2;Lyon!$B$2:$B$5)+SOMME.SI(Nantes!$A$2:$A$6;$A2;Nantes!$B$2:$B$6)",
          "=SOMME.SI(Strasbourg!A2:A5;A2;Strasbourg!B2:B5)+SOMME.SI(Lyon!A2:A5;A2;Lyon!B2:B5)+SOMME.SI(Nantes!A2:A6;A2;Nantes!B2:B6)",
          "=SOMME.SI(Strasbourg!$A$2:$A$5;$A2;Strasbourg!$B$2:$B$5)+SOMME.SI(Nantes!$A$2:$A$6;$A2;Nantes!$B$2:$B$6)+SOMME.SI(Lyon!$A$2:$A$5;$A2;Lyon!$B$2:$B$5)",
          "=SOMME.SI(Strasbourg!A2:A5;A2;Strasbourg!B2:B5)+SOMME.SI(Nantes!A2:A6;A2;Nantes!B2:B6)+SOMME.SI(Lyon!A2:A5;A2;Lyon!B2:B5)"
        ],
        "formulaMode": true
      },
      "aide": {
