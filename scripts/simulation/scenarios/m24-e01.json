  "steps": [
    {
      "id": "M24-E01-01",
      "consigne": "Illustrez la ligne du **clavier** avec son illustration, dans la cellule. La vignette doit se loger dans la cellule, pas flotter au-dessus.",
      "setup": {
        "selection": "A2",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A2",
          "source": "data:image/svg+xml;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Onglet Insertion, « Image dans la cellule »."
      }
    },
    {
      "id": "M24-E01-02",
      "consigne": "Illustrez la ligne de l'**écran**. La seconde vignette se loge à son tour dans sa cellule.",
      "setup": {
        "selection": "A4",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A4",
          "source": "data:image/svg+xml;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Même bouton, sur la ligne de l'écran."
      }
    },
    {
      "id": "M24-E01-03",
      "consigne": "Classez le catalogue par **ordre alphabétique de produit**.",
      "setup": {
        "selection": "B3",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A2:D4",
        "column": "B",
        "ascending": true
      },
      "aide": {
        "text": "Une cellule de la colonne Produit, puis le tri croissant."
      },
      "feedback": "Clavier, Écran, Souris — et chaque photo a suivi son produit."
    },
    {
      "id": "M24-E01-04",
      "consigne": "Donnez aux prix un format **monétaire**.",
      "setup": {
        "selection": "D2:D4"
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "D2": {
            "numberFormat": "monetaire"
          },
          "D4": {
            "numberFormat": "monetaire"
          }
        }
      },
      "aide": {
        "text": "Le bouton € du groupe Nombre."
      }
    },
    {
      "id": "M24-E01-05",
      "consigne": "Calculez le **prix total** du catalogue en **F1**.",
      "setup": {
        "selection": "F1",
        "cells": {
          "E1": {
            "v": "Total",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "F1",
        "accept": [
          "=SOMME(D2:D4)"
        ],
        "formulaMode": true
      },
      "feedback": "372 €."
    },
    {
      "id": "M24-E01-06",
      "consigne": "Dernière vérification : comptez les produits du catalogue en **F2**. La colonne Photo ne doit pas perturber le comptage.",
      "setup": {
        "selection": "F2",
        "cells": {
          "E2": {
            "v": "Nb produits",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "F2",
        "accept": [
          "=NBVAL(B2:B4)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NBVAL sur la colonne des noms de produits."
      },
      "feedback": "3 produits. Un catalogue illustré, trié, chiffré — et toujours calculable."
    }
  ]
}
