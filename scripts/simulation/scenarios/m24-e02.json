  "steps": [
    {
      "id": "M24-E02-01",
      "consigne": "Illustrez la première ligne du catalogue avec sa photo, **dans** la cellule.",
      "setup": {
        "selection": "A2",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A2",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Onglet Insertion, « Image dans la cellule »."
      }
    },
    {
      "id": "M24-E02-02",
      "consigne": "Illustrez de même la ligne de l'armoire basse.",
      "setup": {
        "selection": "A4",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A4",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Même bouton, troisième ligne de produits."
      }
    },
    {
      "id": "M24-E02-03",
      "consigne": "Le stock de tables pliantes est le plus bas du catalogue : signalez-le par un remplissage.",
      "setup": {
        "selection": "E3",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "E3": {
            "background": "#fde68a"
          }
        }
      },
      "aide": {
        "text": "Le bouton Remplissage de l'onglet Accueil."
      }
    },
    {
      "id": "M24-E02-04",
      "consigne": "En **F2**, dessinez une jauge de stock dans la cellule : un carré `■` pour deux unités.",
      "setup": {
        "selection": "F2"
      },
      "action": {
        "type": "TYPE",
        "target": "F2",
        "accept": [
          "=REPT(\"■\";E2/2)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "REPT, avec le stock divisé par deux."
      }
    },
    {
      "id": "M24-E02-05",
      "consigne": "Complétez la colonne jusqu'en **F5**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "F3": {
            "anyOf": [
              "=REPT(\"■\";E3/2)"
            ]
          },
          "F4": {
            "anyOf": [
              "=REPT(\"■\";E4/2)"
            ]
          },
          "F5": {
            "anyOf": [
              "=REPT(\"■\";E5/2)"
            ]
          }
        }
      },
      "aide": {
        "text": "Recopiez F2 vers le bas."
      }
    },
    {
      "id": "M24-E02-06",
      "consigne": "En **D7**, calculez la valeur totale du stock.",
      "setup": {
        "selection": "D7"
      },
      "action": {
        "type": "TYPE",
        "target": "D7",
        "accept": [
          "=SOMMEPROD(D2:D5;E2:E5)",
          "=SOMMEPROD(E2:E5;D2:D5)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Prix et stock, multipliés ligne à ligne puis additionnés."
      },
      "feedback": "5 886 €."
    },
    {
      "id": "M24-E02-07",
      "consigne": "En **D8**, comptez les références dont le stock est inférieur à 15.",
      "setup": {
        "selection": "D8"
      },
      "action": {
        "type": "TYPE",
        "target": "D8",
        "accept": [
          "=NB.SI(E2:E5;\"<15\")",
          "=NB.SI($E$2:$E$5;\"<15\")"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NB.SI accepte un critère de comparaison entre guillemets."
      },
      "feedback": "2 références à surveiller."
    }
  ]
