  "steps": [
    {
      "id": "M24-EV01-01",
      "consigne": "Le **catalogue audiovisuel** a été préparé pour le salon : jauges de stock, titre, photos. L'entrepôt vient de livrer. **Douze gestes**, sans aide, comptés au premier essai.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A3:F7",
          "texte": "Le catalogue, ses stocks et ses jauges"
        },
        {
          "type": "MONTRER",
          "cible": "F3",
          "texte": "La colonne Jauge doit refléter le stock"
        },
        {
          "type": "MONTRER",
          "cible": "ecran",
          "texte": "Un arrivage vient d'être livré. Aucune aide"
        }
      ]
    },
    {
      "id": "M24-EV01-02",
      "consigne": "L'entrepôt a livré **16 webcams** : le stock passe de 22 à **38**. **Mettez-le à jour en E6.**",
      "setup": {
        "selection": "E6"
      },
      "action": {
        "type": "TYPE",
        "target": "E6",
        "accept": [
          "38"
        ]
      },
      "points": 2
    },
    {
      "id": "M24-EV01-03",
      "consigne": "La jauge de cette ligne **n'a pas bougé** : elle ne mesure rien. **Refaites celle du premier produit, en F4** — un carré `■` par unité en stock.",
      "setup": {
        "selection": "F4"
      },
      "action": {
        "type": "TYPE",
        "target": "F4",
        "accept": [
          "=REPT(\"■\";E4)"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M24-EV01-04",
      "consigne": "**Refaites les trois autres**, jusqu'en F7.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "F5": {
            "anyOf": [
              "=REPT(\"■\";E5)"
            ]
          },
          "F6": {
            "anyOf": [
              "=REPT(\"■\";E6)"
            ]
          },
          "F7": {
            "anyOf": [
              "=REPT(\"■\";E7)"
            ]
          }
        }
      },
      "points": 3
    },
    {
      "id": "M24-EV01-05",
      "consigne": "Le **vidéoprojecteur** est maintenant le stock le plus faible du catalogue : **signalez sa cellule de stock par un fond de couleur.**",
      "setup": {
        "selection": "E4",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "E4": {
            "background": "#fde68a"
          }
        }
      },
      "points": 2
    },
    {
      "id": "M24-EV01-06",
      "consigne": "La ligne du **vidéoprojecteur** n'a pas sa photo. **Mettez-la dans la cellule.**",
      "setup": {
        "selection": "A4",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A4",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "points": 2
    },
    {
      "id": "M24-EV01-07",
      "consigne": "**Celle de la webcam non plus.**",
      "setup": {
        "selection": "A6",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A6",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "points": 2
    },
    {
      "id": "M24-EV01-08",
      "consigne": "Le titre **déborde du tableau**. Faites-en une cellule unique, de la largeur des six colonnes.",
      "setup": {
        "selection": "A1:F1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-fusionner"
      },
      "points": 2
    },
    {
      "id": "M24-EV01-09",
      "consigne": "**Agrandissez-le.**",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "A1": {
            "fontSize": 14
          }
        }
      },
      "points": 2
    },
    {
      "id": "M24-EV01-10",
      "consigne": "**Centrez-le sur la largeur du tableau.**",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "A1": {
            "hAlign": "center"
          }
        }
      },
      "points": 2
    },
    {
      "id": "M24-EV01-11",
      "consigne": "**Classez le catalogue du produit le plus cher au moins cher** — les photos doivent suivre leur ligne.",
      "setup": {
        "selection": "D5",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A4:F7",
        "column": "D",
        "ascending": false
      },
      "points": 3
    },
    {
      "id": "M24-EV01-12",
      "consigne": "**En D10, calculez la valeur totale du stock.**",
      "setup": {
        "selection": "D10"
      },
      "action": {
        "type": "TYPE",
        "target": "D10",
        "accept": [
          "=SOMMEPROD(D4:D7;E4:E7)",
          "=SOMMEPROD(E4:E7;D4:D7)"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M24-EV01-13",
      "consigne": "**En D11, comptez les références dont le stock est inférieur à 10.**",
      "setup": {
        "selection": "D11"
      },
      "action": {
        "type": "TYPE",
        "target": "D11",
        "accept": [
          "=NB.SI(E4:E7;\"<10\")",
          "=NB.SI($E$4:$E$7;\"<10\")"
        ],
        "formulaMode": true
      },
      "points": 2
    }
  ],
