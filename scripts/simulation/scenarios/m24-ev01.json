  "steps": [
    {
      "id": "M24-EV01-01",
      "consigne": "Un catalogue audiovisuel à illustrer et à mettre en forme : deux vignettes, une alerte de stock, une jauge, un titre, un tri et deux calculs de contrôle. Aucune aide sur cette évaluation.",
      "action": {
        "type": "READ"
      },
      "points": 0
    },
    {
      "id": "M24-EV01-02",
      "consigne": "Illustrez la ligne du vidéoprojecteur avec sa photo, dans la cellule.",
      "setup": {
        "selection": "A4",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A4",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "points": 2
    },
    {
      "id": "M24-EV01-03",
      "consigne": "Illustrez la ligne de la webcam.",
      "setup": {
        "selection": "A6",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A6",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "points": 1
    },
    {
      "id": "M24-EV01-04",
      "consigne": "Le vidéoprojecteur est le stock le plus faible du catalogue : signalez sa cellule de stock par un remplissage.",
      "setup": {
        "selection": "E4",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "E4": {
            "background": "#fde68a"
          }
        }
      },
      "points": 2
    },
    {
      "id": "M24-EV01-05",
      "consigne": "En **F4**, dessinez une jauge dans la cellule : un carré `■` par unité en stock.",
      "setup": {
        "selection": "F4"
      },
      "action": {
        "type": "TYPE",
        "target": "F4",
        "accept": [
          "=REPT(\"■\";E4)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M24-EV01-06",
      "consigne": "Complétez la colonne Jauge jusqu'en **F7**.",
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
          "F5": {
            "anyOf": [
              "=REPT(\"■\";E5)"
            ]
          },
          "F6": {
            "anyOf": [
              "=REPT(\"■\";E6)"
            ]
          },
          "F7": {
            "anyOf": [
              "=REPT(\"■\";E7)"
            ]
          }
        }
      },
      "points": 2
    },
    {
      "id": "M24-EV01-07",
      "consigne": "Le titre déborde du tableau : faites-en une cellule unique de la largeur des six colonnes.",
      "setup": {
        "selection": "A1:F1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-fusionner"
      },
      "points": 2
    },
    {
