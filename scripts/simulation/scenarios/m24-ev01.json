    {
      "id": "M24-EV01-10",
      "consigne": "Donnez-lui un fond de couleur.",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "A1": {
            "background": "#fde68a"
          }
        }
      },
      "points": 1
    },
    {
      "id": "M24-EV01-11",
      "consigne": "Classez le catalogue du produit le plus cher au moins cher.",
      "setup": {
        "selection": "D5",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A4:F7",
        "column": "D",
        "ascending": false
      },
      "points": 2
    },
    {
      "id": "M24-EV01-12",
      "consigne": "En **D10**, calculez la valeur totale du stock.",
      "setup": {
        "selection": "D10"
      },
      "action": {
        "type": "TYPE",
        "target": "D10",
        "accept": [
          "=SOMMEPROD(D4:D7;E4:E7)",
          "=SOMMEPROD(E4:E7;D4:D7)"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M24-EV01-13",
      "consigne": "En **D11**, comptez les références dont le stock est inférieur à 10.",
      "setup": {
        "selection": "D11"
      },
      "action": {
        "type": "TYPE",
        "target": "D11",
        "accept": [
          "=NB.SI(E4:E7;\"<10\")",
          "=NB.SI($E$4:$E$7;\"<10\")"
        ],
        "formulaMode": true
      },
      "points": 2
    }
