  "steps": [
    {
      "id": "M24-L01-01",
      "consigne": "Un petit catalogue : trois produits, une colonne **Photo** vide. ==Ouvrez l'onglet **Insertion** et cliquez sur « Image dans la cellule »== pour placer la photo du clavier en **A2**. La photo se loge dans la cellule, qui s'adapte à sa hauteur.",
      "setup": {
        "selection": "A2",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A2",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Le bouton « Image dans la cellule », onglet Insertion.",
        "showTarget": true
      },
      "feedback": "La photo occupe la cellule A2 et se redimensionne avec elle. C'est le mode « dans la cellule » : l'image appartient à la ligne du clavier."
    },
    {
      "id": "M24-L01-02",
      "consigne": "==Placez la photo de la souris en **A3**==. La deuxième vignette prend place.",
      "setup": {
        "selection": "A3",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A3",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Même bouton, sur la cellule de la ligne souris.",
        "showTarget": true
      }
    },
    {
      "id": "M24-L01-03",
      "consigne": "==Et celle de l'écran en **A4**==. La troisième complète la colonne.",
      "setup": {
        "selection": "A4",
        "ribbon": {
          "activeTab": "insertion"
        },
        "image": {
          "ref": "A4",
          "source": "data:image/png;base64,"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "ins-image-cellule"
      },
      "aide": {
        "text": "Même bouton, dernière ligne.",
        "showTarget": true
      },
      "feedback": "Le catalogue est illustré. Maintenant la démonstration qui compte."
    },
    {
      "id": "M24-L01-04",
      "consigne": "==Triez le catalogue du plus cher au moins cher== : cliquez dans la colonne Prix puis sur **Z→A** dans l'onglet Données.",
      "setup": {
        "selection": "D3",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A2:D4",
        "column": "D",
        "ascending": false
      },
      "aide": {
        "text": "Une cellule de la colonne Prix, puis le bouton Z→A.",
        "showTarget": true
      },
      "feedback": "Regardez les photos : **chacune a suivi sa ligne.** L'écran est passé en tête avec sa propre image. Une image dans une cellule voyage avec ses données, exactement comme un texte ou un nombre."
    },
    {
      "id": "M24-L01-05",
      "consigne": "Voici toute la différence entre les deux façons d'insérer une image, et elle se paie au premier tri. Le comportement est comparé à l'écran. La règle : pour un tableau de données, choisissez toujours **« Image dans la cellule »** — une image flottante ne suit pas sa ligne, et vous obtenez un catalogue faux sans le moindre message d'erreur. Réservez le flottant à un logo d'en-tête, qui n'appartient à aucune ligne.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A2",
          "texte": "Une image DANS la cellule appartient à la ligne : elle la suit au tri"
        },
        {
          "type": "MONTRER",
          "cible": "B2",
          "texte": "Une image FLOTTANTE, posée par-dessus la grille, ne bouge pas"
        },
        {
          "type": "MONTRER",
          "cible": "B2:B4",
          "texte": "Triez, et vous obtenez des photos en face des mauvais produits — sans message d'erreur"
        }
      ]
    },
    {
      "id": "M24-L01-06",
      "consigne": "Vérifions que les données restent exploitables malgré les images. ==En **F1**, calculez le prix moyen du catalogue==.",
      "setup": {
        "selection": "F1",
        "cells": {
          "E1": {
            "v": "Prix moyen",
            "format": {
              "bold": true
            }
          }
        }
      },
      "action": {
        "type": "TYPE",
        "target": "F1",
        "accept": [
          "=MOYENNE(D2:D4)"
        ],
        "formulaMode": true
      },
      "feedback": "124 €. Les images n'interfèrent pas avec les calculs : elles occupent une colonne à part, et la colonne Photo n'entre dans aucune formule."
    }
  ]
