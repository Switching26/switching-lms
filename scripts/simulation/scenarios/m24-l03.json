  "steps": [
    {
      "id": "M24-L03-01",
      "consigne": "Le titre est écrit dans **A1** et déborde sur ses voisines : il n'est pas centré sur le tableau, il le dépasse. ==Sélectionnez **A1:E1**, puis cliquez sur **Fusionner**==. Les cinq cellules n'en font plus qu'une, et le titre se centre.",
      "setup": {
        "selection": "A1:E1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-fusionner"
      },
      "aide": {
        "text": "Le bouton Fusionner du groupe Alignement.",
        "showTarget": true
      },
      "feedback": "Les cinq cellules n'en font plus qu'une, exactement aussi large que le tableau."
    },
    {
      "id": "M24-L03-02",
      "consigne": "==Agrandissez le titre== avec le bouton d'augmentation de la taille de police.",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "A1": {
            "fontSize": 14
          }
        }
      },
      "aide": {
        "text": "Le grand A du groupe Police, celui qui augmente la taille.",
        "showTarget": true
      }
    },
    {
      "id": "M24-L03-03",
      "consigne": "==Centrez-le== dans la cellule fusionnée.",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "A1": {
            "hAlign": "center"
          }
        }
      },
      "aide": {
        "text": "Le bouton d'alignement centré, groupe Alignement.",
        "showTarget": true
      }
    },
    {
      "id": "M24-L03-04",
      "consigne": "==Donnez-lui un **remplissage**== pour le détacher du tableau.",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "A1": {
            "background": "#fde68a"
          }
        }
      },
      "aide": {
        "text": "Le pot de peinture du groupe Police.",
        "showTarget": true
      },
      "feedback": "Fusionné, agrandi, centré, coloré : votre titre est fait, et il est resté une **cellule**."
    },
    {
      "id": "M24-L03-05",
      "consigne": "==Terminez en **gras**==. Le titre s'épaissit.",
      "setup": {
        "selection": "A1",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-gras"
      },
      "aide": {
        "text": "Le B du groupe Police, ou Ctrl+G.",
        "showTarget": true
      }
    },
    {
      "id": "M24-L03-06",
      "consigne": "Vérifions que le tableau n'a rien perdu de ses capacités. ==Triez la liste du prix le plus élevé au plus bas==.",
      "setup": {
        "selection": "D6",
        "ribbon": {
          "activeTab": "donnees"
        }
      },
      "action": {
        "type": "SORT_RANGE",
        "range": "A4:E8",
        "column": "D",
        "ascending": false
      },
      "aide": {
        "text": "Une cellule de la colonne Prix HT, puis le bouton Z→A de l'onglet Données.",
        "showTarget": true
      },
      "feedback": "Le tri fonctionne parfaitement : la cellule fusionnée est **au-dessus** du tableau, séparée par une ligne vide, donc hors de la plage triée."
    },
    {
      "id": "M24-L03-07",
      "consigne": "==En **G4**, comptez les articles du tarif==.",
      "setup": {
        "selection": "G4"
      },
      "action": {
        "type": "TYPE",
        "target": "G4",
        "accept": [
          "=NBVAL(B4:B8)",
          "=NB(D4:D8)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NBVAL sur la colonne des désignations.",
        "showTarget": true
      },
      "feedback": "5 articles, comptés sans difficulté."
    },
    {
      "id": "M24-L03-08",
      "consigne": "Excel propose aussi **WordArt** (Insertion > Texte), et deux raisons invitent à s'en méfier dans un classeur de travail : c'est un objet **flottant**, qui n'appartient à aucune cellule, et son rendu vieillit mal. Le point est montré à l'écran. Un dernier conseil, capital : ne fusionnez **jamais** de cellules **à l'intérieur** d'une liste de données. Une cellule fusionnée empêche le tri, casse la sélection de colonne et fait échouer les tableaux croisés. Le titre, lui, se place au-dessus, séparé par une ligne vide.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A1",
          "texte": "Un titre en cellule fusionnée appartient à la feuille"
        },
        {
          "type": "MONTRER",
          "cible": "A3",
          "texte": "WordArt crée un objet FLOTTANT — il n'appartient à aucune cellule"
        },
        {
          "type": "MONTRER",
          "cible": "A1",
          "texte": "Il se déplace au moindre changement de largeur, et fait daté. À éviter dans un classeur de travail"
        }
      ]
    }
