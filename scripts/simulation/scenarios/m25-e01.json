  "steps": [
    {
      "id": "M25-E01-01",
      "consigne": "Faites en sorte que la **ligne de titres reste visible** quand on descend dans le tableau.",
      "setup": {
        "ribbon": {
          "activeTab": "affichage"
        },
        "freeze": {
          "rows": 1,
          "cols": 0
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "aff-figer-volets"
      },
      "aide": {
        "text": "Onglet Affichage, groupe Fenêtre."
      }
    },
    {
      "id": "M25-E01-02",
      "consigne": "Calculez la **masse salariale** en **F1**.",
      "setup": {
        "selection": "F1"
      },
      "action": {
        "type": "TYPE",
        "target": "F1",
        "accept": [
          "=SOMME(D2:D13)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur les douze salaires."
      },
      "feedback": "27 335 €."
    },
    {
      "id": "M25-E01-03",
      "consigne": "En **F2**, calculez le **salaire moyen**.",
      "setup": {
        "selection": "F2"
      },
      "action": {
        "type": "TYPE",
        "target": "F2",
        "accept": [
          "=MOYENNE(D2:D13)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La fonction MOYENNE sur la même plage."
      },
      "feedback": "Environ 2 278 €."
    },
    {
      "id": "M25-E01-04",
      "consigne": "En **F3**, comptez les salariés du service **Production**.",
      "setup": {
        "selection": "F3"
      },
      "action": {
        "type": "TYPE",
        "target": "F3",
        "accept": [
          "=NB.SI(C2:C13;\"Production\")",
          "=NB.SI($C$2:$C$13;\"Production\")"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NB.SI sur la colonne Service."
      },
      "feedback": "4 personnes en production."
    },
    {
      "id": "M25-E01-05",
      "consigne": "En **F4**, calculez la **masse salariale de la Comptabilité** seule.",
      "setup": {
        "selection": "F4"
      },
      "action": {
        "type": "TYPE",
        "target": "F4",
        "accept": [
          "=SOMME.SI(C2:C13;\"Comptabilité\";D2:D13)",
          "=SOMME.SI($C$2:$C$13;\"Comptabilité\";$D$2:$D$13)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "SOMME.SI : où chercher, quoi chercher, quoi additionner."
      },
      "feedback": "10 100 € pour la comptabilité."
    },
    {
      "id": "M25-E01-06",
      "consigne": "Annotez le salaire le plus élevé du tableau pour expliquer l'écart : posez un **commentaire** sur la cellule concernée.",
      "setup": {
        "selection": "D8",
        "ribbon": {
          "activeTab": "revision"
        },
        "note": {
          "ref": "D8",
          "texte": "Salaire le plus élevé : prime d'ancienneté incluse."
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "rev-commentaire"
      },
      "aide": {
        "text": "Le salaire le plus élevé est celui de Claire Imbert, en D8. Onglet Révision."
      },
      "feedback": "Le tableau est maintenant équipé : titres figés, indicateurs calculés, et l'anomalie expliquée là où on la voit."
    }
