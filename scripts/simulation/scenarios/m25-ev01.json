        "selection": "G8"
      },
      "action": {
        "type": "TYPE",
        "target": "G8",
        "accept": [
          "=SUBSTITUE(A2;\"2025\";\"2026\")"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M25-EV01-09",
