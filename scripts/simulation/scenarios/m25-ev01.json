  "steps": [
    {
      "id": "M25-EV01-01",
      "consigne": "Un fichier de personnel importé d'un autre logiciel : trois lignes portent le même service écrit de trois façons. Vous allez le prouver, corriger, compter, puis annoter et figer le tableau. **Onze gestes**, sans aide, comptés au premier essai.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "C2",
          "texte": "« Atelier » avec une majuscule"
        },
        {
          "type": "MONTRER",
          "cible": "C3",
          "texte": "« atelier » en minuscules — le même service, écrit autrement"
        },
        {
          "type": "MONTRER",
          "cible": "C1",
          "texte": "Trois écritures pour un seul service. Vous allez le prouver, corriger, compter, puis annoter"
        }
      ]
    },
    {
      "id": "M25-EV01-02",
      "consigne": "En **G2**, mesurez la longueur du libellé de service de **C4** pour révéler ce qu'il contient d'invisible.",
      "setup": {
        "selection": "G2"
      },
      "action": {
        "type": "TYPE",
        "target": "G2",
        "accept": [
          "=NBCAR(C4)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M25-EV01-03",
      "consigne": "En **G3**, prouvez par une formule que **C2** et **C4** ne sont pas identiques pour Excel.",
      "setup": {
        "selection": "G3"
      },
      "action": {
        "type": "TYPE",
        "target": "G3",
        "accept": [
          "=EXACT(C2;C4)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M25-EV01-04",
      "consigne": "Corrigez le service de **C3** : le libellé de référence est `Atelier`.",
      "setup": {
        "selection": "C3"
      },
      "action": {
        "type": "TYPE",
        "target": "C3",
        "accept": [
          "Atelier"
        ]
      },
      "points": 1
    },
    {
      "id": "M25-EV01-05",
      "consigne": "Corrigez **C4** de la même façon.",
      "setup": {
        "selection": "C4"
      },
      "action": {
        "type": "TYPE",
        "target": "C4",
        "accept": [
          "Atelier"
        ]
      },
      "points": 1
    },
    {
      "id": "M25-EV01-06",
      "consigne": "En **G5**, comptez les salariés de l'**Atelier**.",
      "setup": {
        "selection": "G5"
      },
      "action": {
        "type": "TYPE",
        "target": "G5",
        "accept": [
          "=NB.SI(C2:C11;\"Atelier\")",
          "=NB.SI($C$2:$C$11;\"Atelier\")"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M25-EV01-07",
      "consigne": "En **G6**, calculez la masse salariale de l'**Atelier**.",
      "setup": {
        "selection": "G6"
      },
      "action": {
        "type": "TYPE",
        "target": "G6",
        "accept": [
          "=SOMME.SI(C2:C11;\"Atelier\";D2:D11)",
          "=SOMME.SI($C$2:$C$11;\"Atelier\";$D$2:$D$11)"
        ],
        "formulaMode": true
      },
      "points": 3
    },
    {
      "id": "M25-EV01-08",
      "consigne": "Les matricules changent d'exercice. En **G8**, produisez le matricule 2026 de la première ligne, sans modifier la colonne A et sans risquer de toucher au numéro d'ordre.",
