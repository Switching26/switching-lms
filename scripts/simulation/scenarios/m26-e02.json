  "steps": [
    {
      "id": "M26-E02-01",
      "consigne": "Le rapport annuel ne reprendra que le tableau des charges, titres compris. Sélectionnez-le.",
      "setup": {
        "selection": "A1"
      },
      "action": {
        "type": "DRAG_RANGE",
        "range": "A1:C5"
      },
      "aide": {
        "text": "Quatre postes, trois colonnes, plus la ligne de titres."
      }
    },
    {
      "id": "M26-E02-02",
      "consigne": "Copiez la sélection. Un liseré animé se met à clignoter autour de la plage.",
      "setup": {
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-copier"
      },
      "aide": {
        "text": "Bouton Copier, ou Ctrl+C."
      }
    },
    {
      "id": "M26-E02-03",
      "consigne": "Collez l'extrait en **F1**, en valeurs : le rapport ne doit embarquer aucune formule. L'extrait doit arriver sans aucune formule : la barre de formule ne montrera que des nombres.",
      "setup": {
        "selection": "F1",
        "ribbon": {
          "activeTab": "accueil"
        },
        "paste": {
          "texte": "Poste de charge\tMontant annuel\tPart du siège\nLoyer\t14400\t3600\nÉnergie\t5280\t1320\nAssurances\t3960\t990\nEntretien\t2640\t660"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-coller"
      },
      "aide": {
        "text": "Placez-vous en F1, puis Coller en valeurs."
      }
    },
    {
      "id": "M26-E02-04",
      "consigne": "Rendez les montants collés présentables : format monétaire sur **G2:G5**.",
      "setup": {
        "selection": "G2:G5",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "G2": {
            "numberFormat": "monetaire"
          },
          "G5": {
            "numberFormat": "monetaire"
          }
        }
      },
      "aide": {
        "text": "Le bouton € du groupe Nombre."
      }
    },
    {
      "id": "M26-E02-05",
      "consigne": "En **J1**, totalisez les montants collés pour vérifier que rien n'a été perdu.",
      "setup": {
        "selection": "J1"
      },
      "action": {
        "type": "TYPE",
        "target": "J1",
        "accept": [
          "=SOMME(G2:G5)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur la colonne des montants de l'extrait collé."
      },
      "feedback": "26 280 €, comme la source."
    },
    {
      "id": "M26-E02-06",
      "consigne": "En **J2**, totalisez la part du siège, elle aussi collée en valeurs.",
      "setup": {
        "selection": "J2"
      },
      "action": {
        "type": "TYPE",
        "target": "J2",
        "accept": [
          "=SOMME(H2:H5)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "La troisième colonne de l'extrait collé."
      },
      "feedback": "6 570 €."
    },
    {
      "id": "M26-E02-07",
      "consigne": "En **J3**, comptez les lignes de l'extrait.",
      "setup": {
        "selection": "J3"
      },
      "action": {
        "type": "TYPE",
        "target": "J3",
        "accept": [
          "=NBVAL(F2:F5)"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "NBVAL sur la colonne des libellés collés."
      },
      "feedback": "4 lignes."
    }
  ]
