    {
      "id": "M26-EV01-09",
      "consigne": "Rendez l'extrait présentable : **format monétaire sur les ventes collées, en G2:G6**.",
      "setup": {
        "selection": "G2:G6",
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "EXPECT_FORMAT",
        "cells": {
          "G2": {
            "numberFormat": "monetaire"
          },
          "G6": {
            "numberFormat": "monetaire"
          }
        }
      },
      "points": 2
    },
    {
      "id": "M26-EV01-10",
      "consigne": "**En J4, calculez la commission moyenne de l'extrait**.",
      "setup": {
        "selection": "J4"
      },
      "action": {
        "type": "TYPE",
        "target": "J4",
        "accept": [
          "=MOYENNE(H2:H6)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M26-EV01-11",
      "consigne": "Le graphique du collègue est illisible : une barre écrase toutes les autres. **Sélectionnez les données qui conviennent** pour le refaire.",
      "setup": {
        "selection": "A1"
      },
      "action": {
        "type": "DRAG_RANGE",
        "range": "A1:B6"
      },
      "points": 2
