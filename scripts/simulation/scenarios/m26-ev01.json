  "steps": [
    {
      "id": "M26-EV01-01",
      "consigne": "Un collègue a préparé l'extrait du rapport et son graphique pendant votre absence. Le rapport part demain : **contrôlez son travail avant de l'envoyer**. L'extrait occupe **F1:H6**, les contrôles sont en colonne **J**. **Treize gestes**, sans aide, comptés au premier essai.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A1:C7",
          "texte": "La source : cinq régions, leurs ventes et leurs commissions"
        },
        {
          "type": "MONTRER",
          "cible": "F1:H5",
          "texte": "L'extrait préparé pour le rapport"
        },
        {
          "type": "MONTRER",
          "cible": "I1",
          "texte": "Les contrôles à remplir, en colonne J"
        }
      ]
    },
    {
      "id": "M26-EV01-02",
      "consigne": "Commencez par mesurer. **En J1, totalisez les ventes de l'extrait**.",
      "setup": {
        "selection": "J1"
      },
      "action": {
        "type": "TYPE",
        "target": "J1",
        "accept": [
          "=SOMME(G2:G6)"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M26-EV01-03",
      "consigne": "**En J2, calculez l'écart** entre le total de la source et celui de l'extrait.",
      "setup": {
        "selection": "J2"
      },
      "action": {
        "type": "TYPE",
        "target": "J2",
        "accept": [
          "=B7-J1",
          "=B7-SOMME(G2:G6)",
          "=SOMME(B2:B6)-J1"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M26-EV01-04",
      "consigne": "**En J3, comptez les lignes de l'extrait**.",
      "setup": {
        "selection": "J3"
      },
      "action": {
        "type": "TYPE",
        "target": "J3",
        "accept": [
          "=NBVAL(F2:F6)"
        ],
        "formulaMode": true
      },
      "points": 1
    },
    {
      "id": "M26-EV01-05",
      "consigne": "Le service commercial signale une erreur de saisie : les ventes de l'**Est** sont de **29 800**. **Corrigez la source, en B4**.",
      "setup": {
        "selection": "B4"
      },
      "action": {
        "type": "TYPE",
        "target": "B4",
        "accept": [
          "29800"
        ]
      },
      "points": 1
    },
    {
      "id": "M26-EV01-06",
      "consigne": "Le rapport doit partir **complet et figé**. Reprenez l'extrait depuis la source : **sélectionnez le tableau**, titres compris, sans la ligne de total.",
      "setup": {
        "selection": "A1"
      },
      "action": {
        "type": "DRAG_RANGE",
        "range": "A1:C6"
      },
      "points": 2
    },
    {
      "id": "M26-EV01-07",
      "consigne": "**Copiez la sélection**.",
      "setup": {
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-copier"
      },
      "points": 1
    },
    {
      "id": "M26-EV01-08",
      "consigne": "**Collez-la en F1** : le rapport ne doit plus dépendre de la feuille source.",
      "setup": {
        "selection": "F1",
        "ribbon": {
          "activeTab": "accueil"
        },
        "paste": {
          "texte": "Région\tVentes\tCommission\nNord\t42500\t1700\nSud\t38900\t1556\nEst\t29800\t1192\nOuest\t31600\t1264\nCentre\t26800\t1072"
        }
      },
      "action": {
        "type": "EXPECT_STATE",
        "cells": {
