  "steps": [
    {
      "id": "M27-E01-01",
      "consigne": "Placez-vous en **D10**, sur la ligne de total de juillet.",
      "action": {
        "type": "CLICK_CELL",
        "cell": "D10"
      },
      "aide": {
        "text": "La ligne vide sous les sept notes de juillet."
      }
    },
    {
      "id": "M27-E01-02",
      "consigne": "Activez les **références relatives**, puis enregistrez une macro nommée **Pied_relatif** avec le raccourci **Ctrl+Maj+R**.",
      "action": {
        "type": "RECORD_MACRO",
        "expect": "started"
      },
      "aide": {
        "text": "La case Références relatives se coche avant de démarrer l'enregistrement."
      }
    },
    {
      "id": "M27-E01-03",
      "consigne": "Écrivez **Total du mois** en A10.",
      "action": {
        "type": "TYPE",
        "target": "A10",
        "accept": [
          "Total du mois"
        ]
      }
    },
    {
      "id": "M27-E01-04",
      "consigne": "En **D10**, additionnez les sept montants du mois.",
      "action": {
        "type": "TYPE",
        "target": "D10",
        "accept": [
          "=SOMME(D3:D9)",
          "=D3+D4+D5+D6+D7+D8+D9"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur D3:D9."
      },
      "feedback": "480 € pour juillet."
    },
    {
      "id": "M27-E01-05",
      "consigne": "Arrêtez l'enregistrement.",
      "action": {
        "type": "RECORD_MACRO",
        "expect": "stopped"
      }
    },
    {
      "id": "M27-E01-06",
      "consigne": "Placez-vous maintenant en **D21**, sur la ligne de total du tableau d'**août**.",
      "action": {
        "type": "CLICK_CELL",
        "cell": "D21"
      },
      "aide": {
        "text": "Le second tableau commence ligne 12 ; sa ligne de total est la 21."
      }
    },
    {
      "id": "M27-E01-07",
      "consigne": "Exécutez la macro. Enregistrée en références relatives, elle doit clôturer **août** là où vous êtes, sans revenir sur juillet. Le total doit s'inscrire sous le tableau d'août, et juillet rester intact.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_relatif",
          "shortcut": "Ctrl+Maj+R",
          "relative": true,
          "minStatements": 4,
          "effet": {
            "A21": {
              "v": "Total du mois"
            },
            "D21": {
              "v": 510
            }
          }
        }
      },
      "aide": {
        "text": "Si la macro réécrit la ligne 10, c'est qu'elle a été enregistrée en références absolues."
      },
      "feedback": "510 € en D21 : la même macro clôture n'importe quel mois, selon l'endroit d'où on la lance."
    }
  ]
