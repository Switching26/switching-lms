  "steps": [
    {
      "id": "M27-E02-01",
      "consigne": "La macro **Pied_de_tableau** occupe **Ctrl+t**, le raccourci d'Excel qui crée un tableau. Rendez-le au tableur : donnez à la macro **Ctrl+Maj+K**. Le raccourci affiché dans la boîte Macro doit changer.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_de_tableau",
          "shortcut": "Ctrl+Maj+K"
        }
      },
      "aide": {
        "text": "Boîte Macro, bouton Options…"
      }
    },
    {
      "id": "M27-E02-02",
      "consigne": "Juillet n'est pas clôturé. Exécutez la macro. La ligne de total doit apparaître sous juillet.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_de_tableau",
          "shortcut": "Ctrl+Maj+K",
          "effet": {
            "A10": {
              "v": "Total du mois"
            },
            "D10": {
              "v": 480
            }
          }
        }
      }
    },
    {
      "id": "M27-E02-03",
      "consigne": "La macro **Total_general** n'a pas de raccourci. Donnez-lui **Ctrl+Maj+G**. La colonne Raccourci de la boîte Macro doit se remplir.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Total_general",
          "shortcut": "Ctrl+Maj+G"
        }
      }
    },
    {
      "id": "M27-E02-04",
      "consigne": "Exécutez **Total_general** : elle cumule les deux mois en bas du tableau. Une ligne de cumul doit s'ajouter sous les deux mois.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Total_general",
          "shortcut": "Ctrl+Maj+G",
          "effet": {
            "A23": {
              "v": "Total des deux mois"
            },
            "D23": {
              "v": 990
            }
          }
        }
      },
      "feedback": "990 € sur juillet et août."
    },
    {
      "id": "M27-E02-05",
      "consigne": "En **F1**, calculez la **moyenne mensuelle** des frais sur ces deux mois.",
      "action": {
        "type": "TYPE",
        "target": "F1",
        "accept": [
          "=MOYENNE(D10;D21)",
          "=(D10+D21)/2",
          "=D23/2"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Deux cellules seulement : le total de juillet et celui d'août."
      },
      "feedback": "495 € par mois en moyenne."
    }
  ]
