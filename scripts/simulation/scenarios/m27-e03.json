  "steps": [
    {
      "id": "M27-E03-01",
      "consigne": "Clôturez juillet en exécutant **Pied_de_tableau**. La ligne de total s'inscrit sous juillet.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_de_tableau",
          "effet": {
            "A10": {
              "v": "Total du mois"
            },
            "D10": {
              "v": 480
            }
          }
        }
      }
    },
    {
      "id": "M27-E03-02",
      "consigne": "Sans réenregistrer la macro, faites-lui clôturer le tableau d'**août** : ouvrez son code et adaptez les références. Le total doit se poser sous août, sans toucher à juillet.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "minStatements": 5,
          "effet": {
            "A21": {
              "v": "Total du mois"
            },
            "D21": {
              "v": 510
            }
          }
        }
      },
      "aide": {
        "text": "Le bouton Modifier affiche le code. La ligne de total d'août est la 21."
      }
    },
    {
      "id": "M27-E03-03",
      "consigne": "Faites-lui écrire **Total août 2026** au lieu de **Total du mois**. Le libellé de la ligne de total doit changer.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "effet": {
            "A21": {
              "v": "Total août 2026"
            }
          }
        }
      }
    },
    {
      "id": "M27-E03-04",
      "consigne": "Ajoutez une instruction au code : la macro doit aussi écrire **Contrôlé** en **F21**. Une mention doit apparaître à droite de la ligne de total.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "effet": {
            "A21": {
              "v": "Total août 2026"
            },
            "F21": {
              "v": "Contrôlé"
            }
          }
        }
      },
      "aide": {
        "text": "Deux lignes suffisent : sélectionner la cellule, puis y écrire le texte. Le code montre déjà comment il s'y prend pour le libellé du total."
      }
    },
    {
      "id": "M27-E03-05",
      "consigne": "En **F1**, additionnez les deux totaux mensuels.",
      "action": {
        "type": "TYPE",
        "target": "F1",
        "accept": [
          "=D10+D21",
          "=D21+D10",
          "=SOMME(D10;D21)"
        ],
        "formulaMode": true
      },
      "feedback": "990 € : les valeurs écrites par la macro se calculent comme les autres."
    }
  ]
