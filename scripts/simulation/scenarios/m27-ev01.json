  "steps": [
    {
      "id": "M27-EV01-01",
      "consigne": "Les frais de déplacement de juillet et d'août. Vous allez enregistrer une macro qui clôture un mois, la vérifier, l'adapter au mois suivant et changer son raccourci. Aucune aide sur cette évaluation : chaque étape compte au premier essai.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "MONTRER",
          "cible": "A1",
          "texte": "Les frais de juillet"
        },
        {
          "type": "MONTRER",
          "cible": "A12",
          "texte": "Et ceux d'août, à l'identique"
        },
        {
          "type": "MONTRER",
          "cible": "D2",
          "texte": "Vous allez enregistrer une macro qui clôture un mois, la vérifier, puis l'adapter au suivant"
        }
      ]
    },
    {
      "id": "M27-EV01-02",
      "consigne": "Placez-vous là où le total de juillet doit apparaître.",
      "action": {
        "type": "CLICK_CELL",
        "cell": "D10"
      },
      "points": 1
    },
    {
      "id": "M27-EV01-03",
      "consigne": "Enregistrez une macro nommée **Cloture_mois**, raccourci **Ctrl+Maj+J**, en références absolues.",
      "action": {
        "type": "RECORD_MACRO",
        "expect": "started"
      },
      "points": 2
    },
    {
      "id": "M27-EV01-04",
      "consigne": "Écrivez **Total du mois** en A10.",
      "action": {
        "type": "TYPE",
        "target": "A10",
        "accept": [
          "Total du mois"
        ]
      },
      "points": 1
    },
    {
      "id": "M27-EV01-05",
      "consigne": "En **D10**, additionnez les sept montants de juillet.",
      "action": {
        "type": "TYPE",
        "target": "D10",
        "accept": [
          "=SOMME(D3:D9)",
          "=D3+D4+D5+D6+D7+D8+D9"
        ],
        "formulaMode": true
      },
      "points": 2
    },
    {
      "id": "M27-EV01-06",
      "consigne": "Les montants ont été collés depuis un courriel et ont perdu leur format. Sélectionnez-les.",
      "action": {
        "type": "DRAG_RANGE",
        "range": "D3:D9"
      },
      "points": 1
    },
    {
      "id": "M27-EV01-07",
      "consigne": "Appliquez-leur le **format monétaire**.",
      "setup": {
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-format-monetaire"
      },
      "points": 1
    },
    {
      "id": "M27-EV01-08",
      "consigne": "Arrêtez l'enregistrement.",
      "action": {
        "type": "RECORD_MACRO",
        "expect": "stopped"
      },
      "points": 1
    },
    {
      "id": "M27-EV01-09",
      "consigne": "La ligne de total vient d'être effacée. Exécutez votre macro pour la reconstituer.",
      "setup": {
        "cells": {
          "A10": {
            "v": ""
          },
          "D10": {
            "v": ""
          }
        }
      },
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Cloture_mois",
          "shortcut": "Ctrl+Maj+J",
          "minStatements": 5,
          "contains": [
            "Selection.NumberFormat"
          ],
          "effet": {
            "A10": {
              "v": "Total du mois"
            },
            "D10": {
              "v": 480
            }
          }
        }
      },
      "points": 3
    },
    {
      "id": "M27-EV01-10",
      "consigne": "Sans réenregistrer, faites clôturer le tableau d'**août** par cette macro.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "effet": {
            "A21": {
              "v": "Total du mois"
            },
            "D21": {
              "v": 510
            }
          }
        }
      },
      "points": 3
    },
    {
      "id": "M27-EV01-11",
      "consigne": "Changez le raccourci de la macro pour **Ctrl+Maj+E**.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Cloture_mois",
          "shortcut": "Ctrl+Maj+E"
        }
      },
      "points": 2
    },
    {
      "id": "M27-EV01-12",
      "consigne": "En **F1**, additionnez les deux totaux mensuels.",
      "action": {
        "type": "TYPE",
        "target": "F1",
        "accept": [
          "=D10+D21",
          "=D21+D10",
          "=SOMME(D10;D21)"
        ],
        "formulaMode": true
      },
      "points": 1
    }
  ]
