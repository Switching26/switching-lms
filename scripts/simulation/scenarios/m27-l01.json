  "steps": [
    {
      "id": "M27-L01-01",
      "consigne": "Chaque fin de mois, la même corvée sur ce tableau de **frais de déplacement** : écrire le libellé du total, poser la somme, la mettre en gras, surligner la ligne. Quatre gestes, douze fois par an, et autant de fois qu'il y a d'agences. Une **macro** enregistre ces gestes une fois pour toutes et les rejoue ensuite d'un seul raccourci.",
      "action": {
        "type": "READ"
      },
      "points": 0
    },
    {
      "id": "M27-L01-02",
      "consigne": "On se place AVANT de lancer l'enregistreur, sinon le déplacement lui-même finit dans la macro. ==Cliquez en **D10**==, là où le total de juillet doit apparaître.",
      "setup": {
        "selection": "A1"
      },
      "action": {
        "type": "CLICK_CELL",
        "cell": "D10"
      },
      "aide": {
        "text": "La ligne 10 est la ligne vide, juste sous les sept notes de juillet.",
        "showTarget": true
      }
    },
    {
      "id": "M27-L01-03",
      "consigne": "==Démarrez l'enregistrement== : nommez la macro **Pied_de_tableau**, tapez un **T majuscule** comme touche de raccourci — ce qui donne **Ctrl+Maj+T** — et décrivez-la en une ligne.",
      "action": {
        "type": "RECORD_MACRO",
        "expect": "started"
      },
      "aide": {
        "text": "Le bouton « Enregistrer une macro… », puis OK. Un nom de macro n'accepte ni espace ni accent.",
        "showTarget": true
      },
      "feedback": "Le témoin rouge s'allume dans la barre d'état : à partir de maintenant, chacun de vos gestes est transcrit."
    },
    {
      "id": "M27-L01-04",
      "consigne": "==Saisissez **Total du mois** en A10==.",
      "action": {
        "type": "TYPE",
        "target": "A10",
        "accept": [
          "Total du mois"
        ]
      },
      "aide": {
        "text": "Cliquez en A10, tapez le libellé, validez.",
        "showTarget": true
      }
    },
    {
      "id": "M27-L01-05",
      "consigne": "==En **D10**, additionnez les sept montants de juillet==.",
      "action": {
        "type": "TYPE",
        "target": "D10",
        "accept": [
          "=SOMME(D3:D9)",
          "=D3+D4+D5+D6+D7+D8+D9"
        ],
        "formulaMode": true
      },
      "aide": {
        "text": "Une somme sur la colonne Montant, de la ligne 3 à la ligne 9.",
        "showTarget": true
      },
      "feedback": "480 €. La formule part dans la macro telle que vous l'avez écrite."
    },
    {
      "id": "M27-L01-06",
      "consigne": "==Sélectionnez la ligne de total, de **A10** à **D10**==.",
      "action": {
        "type": "DRAG_RANGE",
        "range": "A10:D10"
      },
      "aide": {
        "text": "Cliquez en A10 et faites glisser jusqu'à D10.",
        "showTarget": true
      }
    },
    {
      "id": "M27-L01-07",
      "consigne": "==Mettez cette ligne en **gras**==.",
      "setup": {
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-gras"
      },
      "aide": {
        "text": "Le bouton G du groupe Police, onglet Accueil.",
        "showTarget": true
      }
    },
    {
      "id": "M27-L01-08",
      "consigne": "==Surlignez-la== pour qu'elle se détache du reste du tableau.",
      "setup": {
        "ribbon": {
          "activeTab": "accueil"
        }
      },
      "action": {
        "type": "CLICK_CONTROL",
        "control": "acc-remplissage"
      },
      "aide": {
        "text": "Le bouton Remplir, à côté des bordures.",
        "showTarget": true
      }
    },
    {
      "id": "M27-L01-09",
      "consigne": "Le travail est fait. ==Arrêtez l'enregistrement== — le petit carré de la barre d'état ne sert qu'à ça.",
      "action": {
        "type": "RECORD_MACRO",
        "expect": "stopped"
      },
      "aide": {
        "text": "Le carré rouge dans la barre d'état, ou le bouton Arrêter l'enregistrement.",
        "showTarget": true
      },
      "feedback": "La macro est rangée dans le classeur, avec vos quatre gestes dans l'ordre."
    },
    {
      "id": "M27-L01-10",
      "consigne": "Vérifions qu'elle travaille vraiment : la ligne de total vient d'être effacée. ==Exécutez **Pied_de_tableau**== depuis la boîte Macro.",
      "setup": {
        "cells": {
          "A10": {
            "v": ""
          },
          "D10": {
            "v": ""
          }
        }
      },
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_de_tableau",
          "shortcut": "Ctrl+Maj+T",
          "minStatements": 5,
          "contains": [
            "Sub Pied_de_tableau()",
            "Selection.Font.Bold = True"
          ],
          "effet": {
            "A10": {
              "v": "Total du mois"
            },
            "D10": {
              "v": 480
            }
          }
        }
      },
      "aide": {
        "text": "Boîte Macro, sélectionnez la macro, bouton Exécuter.",
        "showTarget": true
      },
      "feedback": "Libellé, total, gras et surlignage reviennent d'un clic. C'est là que le temps est gagné."
    },
    {
      "id": "M27-L01-11",
      "consigne": "Deux points à retenir. Un classeur qui contient une macro ne s'enregistre plus en **.xlsx** : il faut le format **.xlsm**, sinon Excel jette le code au passage. Et cette macro travaille en **références absolues** : elle écrira toujours en A10 et D10, où que soit le curseur au moment de la lancer. Pour qu'elle agisse là où vous êtes, il faut l'enregistrer en **références relatives** — c'est l'objet de l'exercice.",
      "action": {
        "type": "READ"
      },
      "points": 0
    }
  ]
}
