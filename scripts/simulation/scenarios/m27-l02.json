  "steps": [
    {
      "id": "M27-L02-01",
      "consigne": "La macro **Pied_de_tableau** est là, avec le raccourci **Ctrl+Maj+T**. Deux macros ne peuvent pas partager le même raccourci, et Excel garde pour lui les **Ctrl+lettre** courants : Ctrl+C, Ctrl+S, Ctrl+T… D'où la combinaison **Ctrl+Maj+lettre**, qui laisse le tableur tranquille.",
      "action": {
        "type": "READ"
      },
      "points": 0,
      "montrer": [
        {
          "type": "KEY",
          "key": "Control+Shift+t"
        }
      ]
    },
    {
      "id": "M27-L02-02",
      "consigne": "==Ouvrez la boîte **Macro**, sélectionnez **Pied_de_tableau**, cliquez sur **Options…** et remplacez le raccourci par **Ctrl+Maj+E**== — un **E** majuscule.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_de_tableau",
          "shortcut": "Ctrl+Maj+E"
        }
      },
      "aide": {
        "text": "Le bouton Options… de la boîte Macro ne sert qu'au raccourci et à la description.",
        "showTarget": true
      },
      "feedback": "Le nouveau raccourci s'affiche à côté du nom de la macro."
    },
    {
      "id": "M27-L02-03",
      "consigne": "Changer le raccourci ne touche pas au contenu de la macro. ==Exécutez-la== : la ligne de total de juillet doit se remplir.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Pied_de_tableau",
          "shortcut": "Ctrl+Maj+E",
          "effet": {
            "A10": {
              "v": "Total du mois"
            },
            "D10": {
              "v": 480
            }
          }
        }
      },
      "aide": {
        "text": "Boîte Macro, bouton Exécuter.",
        "showTarget": true
      },
      "feedback": "480 € : le raccourci n'est qu'une poignée, la macro est intacte."
    },
    {
      "id": "M27-L02-04",
      "consigne": "Ce classeur contient une deuxième macro, **Compter_notes**, qui n'a aucun raccourci. ==Attribuez-lui **Ctrl+Maj+M**==.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Compter_notes",
          "shortcut": "Ctrl+Maj+M"
        }
      },
      "aide": {
        "text": "Même chemin : sélectionnez Compter_notes dans la liste, puis Options…",
        "showTarget": true
      }
    },
    {
      "id": "M27-L02-05",
      "consigne": "==Exécutez **Compter_notes**== : elle compte les notes de frais du mois et l'écrit à droite du tableau.",
      "action": {
        "type": "EXPECT_MACRO",
        "macro": {
          "name": "Compter_notes",
          "shortcut": "Ctrl+Maj+M",
          "effet": {
            "F2": {
              "v": "Notes du mois"
            },
            "G2": {
              "v": 7
            }
          }
        }
      },
      "aide": {
        "text": "Sélectionnez-la dans la liste, puis Exécuter.",
        "showTarget": true
      },
      "feedback": "Sept notes en juillet. Deux macros, deux raccourcis, aucun conflit avec Excel."
    }
  ]
