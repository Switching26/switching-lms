    "macros": [
      {
        "name": "Pied_de_tableau",
        "statements": [
          {
            "op": "select",
            "ref": "A10"
          },
          {
            "op": "value",
            "ref": "A10",
            "value": "Total du mois"
          },
          {
            "op": "select",
            "ref": "D10"
          },
          {
            "op": "formula",
            "ref": "D10",
            "formula": "=SUM(R[-7]C:R[-1]C)"
          },
          {
            "op": "font",
            "ref": "D10",
            "bold": true
          }
        ],
        "shortcut": "Ctrl+Maj+T"
      },
      {
        "name": "Compter_notes",
        "statements": [
          {
            "op": "value",
            "ref": "F2",
            "value": "Notes du mois"
          },
          {
            "op": "select",
            "ref": "G2"
          },
          {
            "op": "formula",
            "ref": "G2",
            "formula": "=COUNT(R[1]C[-3]:R[7]C[-3])"
          }
        ]
      }
    ]
