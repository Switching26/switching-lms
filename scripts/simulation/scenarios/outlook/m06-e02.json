  "steps": [
    {
      "id": "O06-E02-01",
      "consigne": "La commande CD-1204 devait arriver le 20 mars, nous sommes le 26. Relancez le fournisseur en répondant à son message d'expédition.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "genre": "reponse",
          "a": {
            "contient": [
              "compta@quincaillerie-delmas.fr"
            ]
          },
          "cc": {
            "vide": true
          }
        }
      },
      "aide": {
        "text": "Ouvrez son message dans la liste, puis Répondre : le fil de la commande est conservé."
      }
    },
    {
      "id": "O06-E02-02",
      "consigne": "Écrivez la relance et envoyez-la. Elle doit citer **la référence de la commande**, **la date de livraison annoncée**, et rester factuelle — aucune formule d'impatience.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "envoye",
          "a": {
            "contient": [
              "compta@quincaillerie-delmas.fr"
            ]
          },
          "cc": {
            "vide": true
          },
          "corps": {
            "salutation": [
              "bonjour",
              "madame",
              "monsieur",
              "bonsoir"
            ],
            "cloture": [
              "cordialement",
              "salutations",
              "bien a vous",
              "merci"
            ],
            "notions": [
              {
                "libelle": "la référence de la commande",
                "oneOf": [
                  "cd-1204",
                  "1204"
                ]
              },
              {
                "libelle": "la date de livraison annoncée",
                "oneOf": [
                  "20 mars",
                  "20/03",
                  "le 20"
                ]
              }
            ],
            "interdit": [
              {
                "libelle": "une formule d'impatience",
                "oneOf": [
                  "inadmissible",
                  "toujours rien",
                  "je m'etonne",
                  "inacceptable",
                  "scandaleux"
                ]
              }
            ],
            "minMots": 12
          }
        }
      },
      "aide": {
        "text": "Deux informations sont attendues : la référence, et la date annoncée."
      }
    },
    {
      "id": "O06-E02-03",
      "consigne": "Second message : Rémi Tissot demande si la pose de jeudi est confirmée. Répondez-lui — à lui seul.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "genre": "reponse",
          "a": {
            "contient": [
              "r.tissot@ecole-arts-lambersart.fr"
            ]
          },
          "cc": {
            "vide": true
          }
        }
      },
      "aide": {
        "text": "Ouvrez son message, puis Répondre."
      }
    },
    {
      "id": "O06-E02-04",
      "consigne": "Complétez l'objet avec le mot `confirmée` : il doit porter la réponse à lui seul, pour l'accueil qui la lira en diagonale.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "objet": {
            "prefixe": "RE",
            "contient": [
              "confirmee"
            ]
          }
        }
      },
      "aide": {
        "text": "Ajoutez le mot à la fin de l'objet. Les accents ne sont pas pris en compte."
      }
    },
    {
      "id": "O06-E02-05",
      "consigne": "Écrivez la confirmation et envoyez. Deux informations suffisent : **le jour** et **l'heure d'arrivée** sur place. Trois lignes valent mieux qu'un paragraphe.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "envoye",
