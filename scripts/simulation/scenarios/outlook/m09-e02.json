  "steps": [
    {
      "id": "O09-E02-01",
      "consigne": "Ouvrez le dossier transmis par Nadia et repérez la pièce qui ne doit pas sortir de l'entreprise.",
      "action": {
        "type": "O_SELECT_MESSAGE",
        "id": "m-facturation"
      },
      "aide": {
        "text": "Le message précise ce dont le comptable du client a besoin."
      }
    },
    {
      "id": "O09-E02-02",
      "consigne": "Faites suivre ce dossier à `compta@habitat-du-nord.fr` en ne laissant que ce qui le concerne.",
      "setup": {
        "courrier": {
          "messageActif": "m-facturation"
        }
      },
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "genre": "transfert",
          "a": {
            "contient": [
              "compta@habitat-du-nord.fr"
            ]
          },
          "pieces": {
            "contient": [
              "Facture-2026-0412.pdf",
              "Facture-2026-0412-AVOIR.pdf"
            ],
            "absent": [
              "Conditions-achat-2026.pdf"
            ]
          }
        }
      },
      "aide": {
        "text": "Le transfert emporte les trois pièces : la croix ✕ retire celle qui ne doit pas partir."
      }
    },
    {
      "id": "O09-E02-03",
      "consigne": "Complétez l'objet avec le mot `règlement`, en gardant le préfixe posé par Outlook.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "objet": {
            "prefixe": "TR",
            "contient": [
              "reglement"
            ]
          }
        }
      },
      "aide": {
        "text": "Ajoutez le mot à la fin ; les accents ne sont pas pris en compte."
      }
    },
    {
      "id": "O09-E02-04",
      "consigne": "Rédigez le mot d'accompagnement et envoyez. Il doit citer **le numéro de facture** et signaler **qu'un avoir l'accompagne** — sans quoi le comptable règlera le montant plein.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "envoye",
