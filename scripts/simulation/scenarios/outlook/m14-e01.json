  "steps": [
    {
      "id": "O14-E01-01",
      "consigne": "Répondez à Julien Leroux en associant la gérante `n.kerbaj@atelier-nord.fr` sur la ligne de ceux qui doivent seulement **savoir**.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "genre": "reponse",
          "a": {
            "contient": [
              "j.leroux@habitat-du-nord.fr"
            ],
            "absent": [
              "n.kerbaj@atelier-nord.fr"
            ]
          },
          "cc": {
            "contient": [
              "n.kerbaj@atelier-nord.fr"
            ]
          }
        }
      },
      "aide": {
        "text": "Ouvrez le message, Répondre, puis renseignez le champ Cc."
      }
    },
    {
      "id": "O14-E01-02",
      "consigne": "Complétez l'objet avec le mot `réclamation`, en gardant le préfixe posé par Outlook.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "redaction",
          "objet": {
            "prefixe": "RE",
            "contient": [
              "réclamation"
            ]
          }
        }
      },
      "aide": {
        "text": "Ajoutez le mot à la fin de l'objet existant."
      }
    },
    {
      "id": "O14-E01-03",
      "consigne": "Rédigez le message et envoyez-le. Il doit annoncer **une vérification** et **une date de retour** — et ne reconnaître aucune responsabilité.",
      "action": {
        "type": "O_EXPECT_MAIL",
        "message": {
          "cible": "envoye",
          "a": {
            "contient": [
              "j.leroux@habitat-du-nord.fr"
            ]
          },
          "cc": {
            "contient": [
              "n.kerbaj@atelier-nord.fr"
            ]
          },
          "objet": {
            "prefixe": "RE",
            "contient": [
              "réclamation"
            ]
          },
          "corps": {
            "salutation": [
              "bonjour",
              "madame",
              "monsieur",
              "bonsoir"
            ],
            "cloture": [
              "cordialement",
              "salutations",
              "bien a vous",
              "merci"
            ],
            "notions": [
              {
                "libelle": "l'annonce d'une vérification",
                "oneOf": [
                  "verifier",
                  "verification",
                  "constater",
                  "constat",
                  "passer sur place",
                  "venir voir",
                  "examiner"
                ]
              },
              {
