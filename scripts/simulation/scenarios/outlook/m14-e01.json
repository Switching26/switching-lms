                "oneOf": [
                  "jeudi",
                  "mercredi",
                  "demain",
                  "avant jeudi",
                  "d'ici",
                  "des demain"
                ]
              }
            ],
            "interdit": [
              {
                "libelle": "une reconnaissance de responsabilité prématurée",
                "oneOf": [
                  "c'est de notre faute",
