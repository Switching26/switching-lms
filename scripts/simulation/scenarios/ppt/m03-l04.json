  "steps": [
    {
      "id": "M03-L04-01",
      "consigne": "Regardez les deux diapositives de contenu : l'une centre son texte, l'autre l'aligne à droite, et leurs titres ne sont traités ni l'un ni l'autre. Prises séparément, aucune n'est fautive. Enchaînées, elles donnent l'impression d'un document assemblé par deux personnes qui ne se sont pas parlé.",
      "action": {
        "type": "READ"
      }
    },
    {
      "id": "M03-L04-02",
      "consigne": "Fixez d'abord la règle, puis appliquez-la partout — c'est l'ordre qui fait gagner du temps. **Titre : gras et centré. Contenu : aligné à gauche. Source : à droite, en italique.** Trois lignes, valables pour toutes les diapositives.",
      "action": {
        "type": "READ"
      }
    },
    {
      "id": "M03-L04-03",
      "consigne": "==Affichez la deuxième diapositive==, celle des chiffres, et commencez par son titre.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      }
    },
    {
      "id": "M03-L04-04",
      "consigne": "==Mettez son titre en gras==, conformément à la règle que vous venez de fixer.",
      "action": {
        "type": "P_EXPECT_FORMAT",
        "objectId": "ph:titre",
        "style": {
          "bold": true
        }
      },
      "aide": {
        "text": "Cliquez sur « Chiffres de la saison », puis sur G."
      }
    },
    {
      "id": "M03-L04-05",
      "consigne": "==Centrez ce titre==. Vous appliquez la règle, pas votre jugement du moment : c'est ce qui garantit que la troisième diapositive sera traitée pareil.",
      "action": {
        "type": "P_EXPECT_FORMAT",
        "objectId": "ph:titre",
        "style": {
          "align": "center"
        }
      }
    },
    {
