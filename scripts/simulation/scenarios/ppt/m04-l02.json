  "steps": [
    {
      "id": "M04-L02-01",
      "consigne": "Une image se redimensionne par la **poignée** de son coin bas-droit : le petit carré qui apparaît quand elle est sélectionnée. Tirer le corps de l'image la déplace, tirer la poignée la redimensionne — deux gestes voisins qu'il ne faut pas confondre, sous peine de refaire le travail.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Sélectionnez une image : un petit carré apparaît à chaque coin — ce sont les poignées"
        },
        {
          "type": "P_MONTRER",
          "cible": "zone:barre-etat",
          "texte": "Tirer le corps déplace, tirer une poignée redimensionne : la barre d'état confirme la sélection"
        }
      ]
    },
    {
      "id": "M04-L02-02",
      "consigne": "==Affichez la deuxième diapositive==. La photo y est si petite qu'on ne distingue rien de ce qu'elle est censée montrer.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      },
      "feedback": "« Avant les travaux » occupe le centre : c'est elle que les boutons modifieront."
    },
    {
      "id": "M04-L02-03",
      "consigne": "==Cliquez sur la photo== pour la sélectionner : c'est ce qui fait apparaître la poignée, qui n'existe pas autrement.",
      "action": {
        "type": "P_SELECT_OBJECT",
        "objectId": "img-avant"
      },
      "feedback": "Sélectionné. Les boutons de mise en forme agiront sur l'image, et sur rien d'autre.",
      "aide": {
        "text": "C'est la petite illustration à gauche de la diapositive."
      }
    },
    {
      "id": "M04-L02-04",
      "consigne": "==Tirez la poignée du coin bas-droit== pour porter l'image à environ deux fois sa largeur. Le placement n'a pas besoin d'être exact : c'est l'ordre de grandeur qui compte.",
      "setupPpt": {
        "slide": 1
      },
      "action": {
        "type": "P_MOVE_OBJECT",
        "objectId": "img-avant",
        "rect": {
          "w": 340,
          "h": 215
        },
        "tolerance": 70
      },
      "aide": {
        "text": "La poignée est le petit carré blanc au coin inférieur droit du cadre bleu."
      },
      "feedback": "L'image montre enfin quelque chose. C'était son seul rôle sur cette diapositive."
    },
    {
      "id": "M04-L02-05",
      "consigne": "Un piège à connaître : en tirant la poignée du **coin**, la largeur et la hauteur changent ensemble, et l'image garde à peu près ses proportions. En tirant un côté, une seule dimension change — l'image s'étire, les visages s'allongent, et le public le remarque sans toujours savoir pourquoi.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "img-avant",
          "texte": "En tirant la poignée du COIN, largeur et hauteur changent ensemble : les proportions tiennent"
        },
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "En tirant un CÔTÉ, une seule dimension change : l'image s'étire et les visages s'allongent"
        }
      ]
    },
    {
      "id": "M04-L02-06",
      "consigne": "==Affichez la troisième diapositive==. L'image y occupe presque toute la largeur : elle écrase le reste de la diapositive et ne laisse aucune place à un commentaire.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 2
      },
      "feedback": "« L'équipe sur place » occupe le centre : c'est elle que les boutons modifieront."
    },
