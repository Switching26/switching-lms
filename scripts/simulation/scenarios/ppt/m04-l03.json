  "steps": [
    {
      "id": "M04-L03-01",
      "consigne": "Une **forme** sert à désigner, pas à remplir. Une flèche montre l'endroit dont vous parlez, une bulle attribue une remarque, un rectangle encadre ce qu'il faut comparer. Le groupe **Insertion** en propose six par le menu Formes — et le seul critère de choix est : qu'est-ce que je veux faire regarder ?",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "ctrl:ins-forme",
          "texte": "Le menu Formes en propose six"
        },
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Une forme désigne : la flèche montre, la bulle attribue une remarque, le rectangle encadre"
        }
      ]
    },
    {
      "id": "M04-L03-02",
      "consigne": "==Affichez la deuxième diapositive==, celle qui porte la photo du chantier.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      },
      "feedback": "« Le détail qui compte » occupe le centre : c'est elle que les boutons modifieront.",
      "aide": {
        "text": "Deuxième vignette du volet : « Le détail qui compte »."
      }
    },
    {
      "id": "M04-L03-03",
      "consigne": "==Ouvrez le menu Formes et choisissez la flèche==. Elle se pose au milieu de la diapositive, déjà sélectionnée : le geste suivant sera de la placer vers ce qu'elle doit montrer.",
      "action": {
        "type": "P_ADD_OBJECT",
        "objectType": "forme",
        "shape": "fleche"
      },
      "aide": {
        "text": "Groupe Insertion, bouton « Formes ▾ », puis l'entrée Flèche."
      },
      "feedback": "La flèche est posée. Une flèche qui ne pointe rien ne sert à rien : c'est le placement qui lui donne son sens."
    },
    {
      "id": "M04-L03-04",
      "consigne": "==Ajoutez une ellipse== depuis le même menu. Elle servira à entourer un détail — c'est la forme la plus employée pour attirer l'œil sans masquer ce qu'elle entoure.",
      "action": {
        "type": "P_ADD_OBJECT",
        "objectType": "forme",
        "shape": "ellipse"
      },
      "feedback": "La forme « ellipse » est posée au centre de « Le détail qui compte » — elle n'est finie qu'une fois placée sur ce qu'elle désigne.",
      "aide": {
        "text": "Rouvrez le menu Formes : il se referme après chaque choix."
      }
    },
    {
      "id": "M04-L03-05",
      "consigne": "Une forme mal placée est pire qu'une forme absente : elle désigne quelque chose au hasard, et le public cherche ce qu'on a voulu lui montrer. Sur la diapositive suivante, une flèche a été posée en haut à gauche et n'indique rien du tout.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "obj8",
          "texte": "Cette flèche a été posée en haut à gauche"
        },
        {
          "type": "P_MONTRER",
          "cible": "img-detail",
          "texte": "Elle n'indique rien : le public cherche ce qu'on a voulu lui montrer"
        }
      ]
    },
    {
      "id": "M04-L03-06",
      "consigne": "==Affichez la troisième diapositive==. La flèche est en haut à gauche, loin du texte des trois étapes qu'elle devrait annoncer.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 2
      },
      "feedback": "« Trois étapes de chantier » occupe le centre : c'est elle que les boutons modifieront.",
      "aide": {
        "text": "Troisième vignette du volet : « Trois étapes de chantier »."
      }
    },
