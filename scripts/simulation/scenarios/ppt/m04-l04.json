  "steps": [
    {
      "id": "M04-L04-01",
      "consigne": "L'ordre de travail sur une diapositive visuelle tient en quatre temps : **retirer** ce qui ne sert plus, **dimensionner** ce qui reste, **placer** ensuite, **légender** en dernier. Placer avant de dimensionner oblige à replacer : une image agrandie ne reste pas là où on l'avait mise.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Retirer ce qui ne sert plus, dimensionner ce qui reste, placer ensuite, légender en dernier"
        },
        {
          "type": "P_MONTRER",
          "cible": "ctrl:ins-image",
          "texte": "Placer avant de dimensionner oblige à replacer : une image agrandie ne reste pas où on l'avait mise"
        }
      ]
    },
    {
      "id": "M04-L04-02",
      "consigne": "==Affichez la deuxième diapositive==. Elle porte une photo trop petite posée en haut, un cadre bleu hérité d'une ancienne version, et une légende encore vide.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      },
      "feedback": "« Le chantier des Tilleuls » occupe le centre : c'est elle que les boutons modifieront."
    },
    {
      "id": "M04-L04-03",
      "consigne": "==Supprimez le rectangle bleu== en haut à droite : il n'encadre rien et ne désigne rien. Premier temps — on retire avant de composer, sinon on compose autour d'un élément qui va disparaître.",
      "action": {
        "type": "P_DELETE_OBJECT",
        "objectId": "fo-ancienne"
      },
      "feedback": "Retiré — et la diapositive respire déjà mieux.",
      "aide": {
        "text": "Cliquez sur le rectangle, puis touche Suppr ou bouton Supprimer du groupe Objet."
      }
    },
    {
      "id": "M04-L04-04",
      "consigne": "==Sélectionnez la photo== du chantier : c'est elle qui portera la diapositive, donc elle qu'on dimensionne en premier.",
      "action": {
        "type": "P_SELECT_OBJECT",
        "objectId": "img-chantier"
      },
      "feedback": "L'image porte maintenant son cadre : c'est elle qui recevra la commande."
    },
