  "steps": [
    {
      "id": "M07-EV01-01",
      "consigne": "Ce bilan part chez un client cette semaine. La version d'équipe est archivée de son côté : ce fichier-ci est la copie qui sort de l'entreprise. Ne corrigez rien encore : parcourez-le en vous demandant, à chaque écran, s'il a été écrit pour l'équipe ou pour le client. Ce qui reste de l'interne doit disparaître.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "zone:volet",
          "texte": "Le bilan, à mi-chemin entre deux versions"
        },
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Une note de travail, une page réservée au personnel, une grille périmée"
