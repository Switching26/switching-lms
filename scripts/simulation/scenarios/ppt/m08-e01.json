  "moduleTitle": "Cas pratique : la réunion de lundi",
  "title": "Exercice — Poser une trame",
  "intro": {
    "title": "Exercice — Poser une trame",
    "body": "Vous présentez jeudi le bilan de chantier au maître d'ouvrage. Posez la trame complète — ouverture datée, deux sections numérotées, clôture — sans écrire une seule ligne de contenu."
  },
  "outro": {
    "body": "Quatre diapositives, aucun contenu : c'est l'état où l'on veut être avant de rédiger."
  },
  "ppt": {
    "fileName": "Bilan de chantier.pptx",
    "format": "16:9",
    "slides": [
      {
        "layout": "diapositive-de-titre"
      }
    ]
  },
  "steps": [
    {
      "id": "M08-E01-01",
      "consigne": "Donnez à l'ouverture le nom de l'entreprise : Verdeval.",
      "action": {
        "type": "P_TYPE_TEXT",
        "cible": "ph:titre",
        "accept": [
          "Verdeval"
        ]
      }
    },
    {
      "id": "M08-E01-02",
      "consigne": "Datez la réunion dans le sous-titre : Bilan de chantier du 18 juin.",
      "action": {
        "type": "P_TYPE_TEXT",
        "cible": "ph:sous-titre",
        "accept": [
          "Bilan de chantier du 18 juin"
        ]
      },
      "aide": {
        "text": "Une ouverture sans date rend impossible de retrouver la bonne version plus tard."
      }
    },
    {
      "id": "M08-E01-03",
      "consigne": "Créez la diapositive qui ouvrira la première partie.",
      "action": {
        "type": "P_ADD_SLIDE"
      },
      "aide": {
        "text": "Groupe Diapositives, bouton Nouvelle."
      }
    },
    {
      "id": "M08-E01-04",
      "consigne": "Une section ne porte qu'un grand titre : donnez-lui la disposition correspondante.",
      "action": {
        "type": "P_SET_LAYOUT",
        "layout": "diapositive-de-titre"
      }
    },
    {
      "id": "M08-E01-05",
      "consigne": "Intitulez-la : 1. Ce qui a été livré.",
      "action": {
        "type": "P_TYPE_TEXT",
        "cible": "ph:titre",
        "accept": [
          "1. Ce qui a été livré",
          "1 Ce qui a été livré"
        ]
      }
    },
    {
      "id": "M08-E01-06",
      "consigne": "Créez la seconde section.",
      "action": {
        "type": "P_ADD_SLIDE"
      }
    },
    {
      "id": "M08-E01-07",
      "consigne": "Intitulez-la : 2. Ce qui reste à faire.",
      "action": {
        "type": "P_TYPE_TEXT",
        "cible": "ph:titre",
        "accept": [
          "2. Ce qui reste à faire",
          "2 Ce qui reste à faire"
        ]
      }
    },
    {
      "id": "M08-E01-08",
      "consigne": "Créez la diapositive de clôture et intitulez-la ensuite.",
      "action": {
        "type": "P_ADD_SLIDE"
      }
    },
    {
      "id": "M08-E01-09",
      "consigne": "Intitulez-la : Merci de votre attention.",
      "action": {
        "type": "P_TYPE_TEXT",
        "cible": "ph:titre",
        "accept": [
          "Merci de votre attention"
        ]
      }
    },
    {
      "id": "M08-E01-10",
      "consigne": "Vérifiez la trame d'un seul coup d'œil.",
      "action": {
        "type": "P_SET_VIEW",
        "view": "trieuse"
      },
      "aide": {
        "text": "Groupe Affichage, bouton Trieuse."
      }
    }
  ]
