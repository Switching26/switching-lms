        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "zone:volet",
          "texte": "La trame laissée en chantier"
        },
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Une section après son contenu, une page de travail, aucune finition"
        }
