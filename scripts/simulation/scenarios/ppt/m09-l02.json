  "steps": [
    {
      "id": "M09-L02-01",
      "consigne": "Un cadre posé au hasard ne désigne rien : il fait seulement du bruit. Sa règle d'emploi tient en deux temps — on le **place** sur ce qu'il doit délimiter, puis on le **dimensionne** pour qu'il contienne cette zone sans déborder sur le reste.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Un cadre posé au hasard ne désigne rien : il fait seulement du bruit"
        },
        {
          "type": "P_MONTRER",
          "cible": "ctrl:ins-forme",
          "texte": "On le place sur ce qu'il délimite, puis on le dimensionne pour qu'il n'en déborde pas"
        }
      ]
    },
    {
      "id": "M09-L02-02",
      "consigne": "==Affichez la deuxième diapositive==. Un rectangle traîne en bas à gauche, loin de la photo qu'il devrait délimiter.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      },
      "feedback": "« La zone replantée » occupe le centre : c'est elle que les boutons modifieront.",
      "aide": {
        "text": "C'est la dernière vignette du volet, intitulée « La zone replantée »."
      }
    },
    {
      "id": "M09-L02-03",
      "consigne": "==Cliquez une fois sur le rectangle== pour le sélectionner. Comme tout objet, il ne se place et ne se dimensionne qu'une fois désigné.",
      "action": {
        "type": "P_SELECT_OBJECT",
        "objectId": "fo-cadre"
      },
      "feedback": "Sélectionné. Les boutons de mise en forme agiront sur la forme, et sur rien d'autre.",
      "aide": {
        "text": "C'est la forme bleue en bas à gauche de la diapositive."
      }
    },
    {
      "id": "M09-L02-04",
      "consigne": "==Faites-le glisser sur la moitié droite de la photo==, à hauteur du milieu. Le placement n'a pas besoin d'être au pixel près : ce qui compte, c'est que le lecteur comprenne quelle partie vous montrez.",
      "setupPpt": {
        "slide": 1
      },
      "action": {
        "type": "P_MOVE_OBJECT",
        "objectId": "fo-cadre",
        "rect": {
          "x": 600,
          "y": 250
        },
        "tolerance": 80
      },
      "feedback": "La forme occupe enfin la zone qui lui revient.",
      "aide": {
        "text": "Attrapez la forme en son milieu, pas sur une poignée, et tirez-la vers la photo."
      }
    },
    {
      "id": "M09-L02-05",
      "consigne": "==Élargissez-le à environ un tiers de plus== en tirant sa poignée du coin. Un cadre trop petit désigne un détail qu'on ne voit pas ; trop grand, il désigne toute l'image, donc rien.",
