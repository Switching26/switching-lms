    {
      "id": "M09-L02-06",
      "consigne": "Entre le rectangle et l'ellipse, le choix n'est pas esthétique. Le **rectangle** convient à une zone qui a des bords — une parcelle, un tableau, une portion d'écran. L'**ellipse** convient à un objet isolé au milieu d'autre chose : elle n'a pas de bord franc, donc elle n'en invente pas.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "fo-cadre",
          "texte": "Le rectangle convient à une zone qui a des bords : une parcelle, un tableau"
        },
        {
          "type": "P_MONTRER",
          "cible": "img-zone",
          "texte": "L'ellipse convient à un objet isolé : elle n'a pas de bord franc, donc elle n'en invente pas"
        }
      ]
    },
