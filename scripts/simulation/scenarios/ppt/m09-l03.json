  "steps": [
    {
      "id": "M09-L03-01",
      "consigne": "La **flèche** ne délimite pas, elle pointe : son extrémité doit toucher ce dont vous parlez, sinon elle envoie le regard à côté. La **bulle** attache un commentaire à un point précis grâce à sa pointe — une bulle posée n'importe où commente n'importe quoi.",
      "action": {
        "type": "READ"
      }
    },
    {
      "id": "M09-L03-02",
      "consigne": "==Affichez la deuxième diapositive==. La flèche est coincée en haut à gauche, contre le titre : elle ne montre rien.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      }
    },
    {
      "id": "M09-L03-03",
      "consigne": "==Faites glisser la flèche jusqu'au bord gauche de la photo==, à mi-hauteur, pour qu'elle pointe vers elle. Une flèche se lit du talon vers la pointe : c'est la pointe qui doit atteindre la cible.",
      "setupPpt": {
        "slide": 1
      },
      "action": {
        "type": "P_MOVE_OBJECT",
        "objectId": "fo-fleche",
        "rect": {
          "x": 250,
          "y": 250
        },
        "tolerance": 80
      },
      "aide": {
        "text": "Attrapez la flèche en son milieu et amenez-la à gauche de la photo."
      }
    },
