  "steps": [
    {
      "id": "M09-L04-01",
      "consigne": "Cette diapositive porte trois formes empilées à gauche et une note de travail. Aucune ne désigne quoi que ce soit. L'ordre de reprise est toujours le même : **retirer d'abord**, garder une ou deux formes, les **placer** sur ce qu'elles montrent, **vérifier** en projection.",
      "action": {
        "type": "READ"
      },
      "montrer": [
        {
          "type": "P_MONTRER",
          "cible": "zone:scene",
          "texte": "Trois formes empilées à gauche et une note de travail : aucune ne désigne quoi que ce soit"
        },
        {
          "type": "P_MONTRER",
          "cible": "zone:volet",
          "texte": "Retirer d'abord, garder une ou deux formes, les placer sur ce qu'elles montrent, vérifier en projection"
        }
      ]
    },
    {
      "id": "M09-L04-02",
      "consigne": "==Affichez la deuxième diapositive==, celle du résultat.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      },
      "feedback": "« Le résultat » occupe le centre : c'est elle que les boutons modifieront."
    },
    {
      "id": "M09-L04-03",
      "consigne": "==Supprimez la note de travail== (« annotations a revoir »). Une consigne interne n'a jamais sa place sur une diapositive qui sera projetée.",
      "action": {
        "type": "P_DELETE_OBJECT",
        "objectId": "zt-note"
      },
      "feedback": "Retiré : « annotations a revoir » n'avait rien à faire devant le public.",
      "aide": {
        "text": "Sélectionnez-la d'un clic, puis Suppr ou le bouton Supprimer du groupe Objet."
      }
    },
    {
      "id": "M09-L04-04",
      "consigne": "==Supprimez le triangle==. Sur trois formes, deux sont de trop : on garde celle qui encadre et celle qui entoure, pas un repère qui ne repère rien.",
      "action": {
        "type": "P_DELETE_OBJECT",
        "objectId": "fo-b"
      },
      "feedback": "Supprimé. Une diapositive propre n'est pas une diapositive jolie : c'est une diapositive sans reste.",
      "aide": {
        "text": "C'est la forme triangulaire, au milieu de la pile de gauche."
      }
    },
    {
      "id": "M09-L04-05",
      "consigne": "==Supprimez aussi le rectangle==. Il reste l'ellipse : une seule annotation, mais qui désignera vraiment quelque chose.",
      "action": {
        "type": "P_DELETE_OBJECT",
        "objectId": "fo-c"
      },
      "feedback": "La forme a disparu. Ce qui reste à l'écran a été voulu."
    },
