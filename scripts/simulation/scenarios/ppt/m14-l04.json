  "steps": [
    {
      "id": "M14-L04-01",
      "consigne": "Trois chiffres qui se comparent doivent être vus **d'un seul regard**, donc sur une même ligne. Posés en escalier comme ici, l'œil les lit l'un après l'autre et perd la comparaison en chemin — c'est exactement ce qu'un tableau évitait.",
      "action": {
        "type": "READ"
      }
    },
    {
      "id": "M14-L04-02",
      "consigne": "==Affichez la deuxième diapositive==. Les trois indicateurs y sont posés à trois hauteurs différentes.",
      "action": {
        "type": "P_SELECT_SLIDE",
        "index": 1
      }
    },
    {
      "id": "M14-L04-03",
      "consigne": "==Remontez « 78 % de remplissage » à la hauteur du premier==, vers 200 en vertical, sans changer sa colonne. Deux zones à la même hauteur se lisent déjà comme une ligne.",
      "setupPpt": {
        "slide": 1
      },
      "action": {
        "type": "P_MOVE_OBJECT",
        "objectId": "zt-deux",
        "rect": {
          "x": 355,
          "y": 200
        }
      },
      "aide": {
        "text": "Faites glisser la zone vers le haut ; l'alignement n'a pas besoin d'être au pixel."
      }
    },
