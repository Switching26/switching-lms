 "steps": [
  {
   "id": "S1",
   "consigne": "==Ouvrez l'onglet Insertion puis « En-tête ».==",
   "action": {
    "type": "W_CLICK_CONTROL",
    "controle": "w-entete-pied"
   },
   "setup": {
    "ribbon": {
     "activeTab": "insertion"
    }
   }
  },
  {
   "id": "S2",
   "consigne": "==Saisissez « Direction commerciale » dans l'en-tête.==",
   "action": {
    "type": "W_EXPECT_ENTETE",
    "emplacement": "entete",
    "accept": [
     "Direction commerciale"
    ]
   }
  },
  {
   "id": "S3",
   "consigne": "==Cochez la numérotation des pages.==",
   "action": {
    "type": "W_EXPECT_PAGE",
    "page": {
     "numeroPage": true
    }
   }
  },
  {
   "id": "S4",
   "consigne": "==Saisissez « BROUILLON » en filigrane.==",
   "action": {
    "type": "W_EXPECT_ENTETE",
    "emplacement": "filigrane",
    "accept": [
     "BROUILLON"
    ]
   }
  },
  {
   "id": "S5",
   "consigne": "==Fermez le panneau, ouvrez Fichier puis Imprimer.==",
   "action": {
    "type": "W_CLICK_CONTROL",
    "controle": "w-imprimer"
   },
   "setup": {
    "ribbon": {
     "activeTab": "fichier"
    }
   }
  },
  {
   "id": "S6",
   "consigne": "==Demandez 3 copies.==",
   "action": {
    "type": "W_EXPECT_PRINT",
    "impression": {
     "copies": 3
    }
   }
  },
  {
   "id": "S7",
   "consigne": "==Choisissez d'imprimer la page courante.==",
   "action": {
    "type": "W_EXPECT_PRINT",
    "impression": {
     "plage": "courante"
    }
   }
  },
  {
   "id": "S8",
   "consigne": "==Fermez l'aperçu, puis affichez la règle depuis Affichage.==",
   "action": {
    "type": "W_CLICK_CONTROL",
    "controle": "w-regle"
   },
   "setup": {
    "ribbon": {
     "activeTab": "affichage"
    }
   }
  },
  {
   "id": "S9",
   "consigne": "==Posez un taquet gauche à 4 cm sur la règle.==",
   "action": {
    "type": "W_EXPECT_TABS",
    "zone": "p0",
    "taquets": [
     {
      "position": 4,
      "type": "gauche"
     }
    ]
   }
  }
 ]
